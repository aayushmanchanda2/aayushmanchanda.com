{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "sh scripts/vercel-build.sh",
  "routes": [
    {
      "src": "^/reading/?$",
      "status": 308,
      "headers": {
        "Location": "/library"
      }
    },
    {
      "src": "^/reading\\.md$",
      "status": 308,
      "headers": {
        "Location": "/library.md"
      }
    },
    {
      "src": "^/reading/(.*)$",
      "status": 308,
      "headers": {
        "Location": "/library/$1"
      }
    },
    {
      "src": "^/computer/?$",
      "status": 308,
      "headers": {
        "Location": "/notes"
      }
    },
    {
      "src": "^/computer\\.md$",
      "status": 308,
      "headers": {
        "Location": "/notes.md"
      }
    },
    {
      "src": "^/computer/(.*)$",
      "status": 308,
      "headers": {
        "Location": "/notes/$1"
      }
    },
    {
      "src": "^/(feed|rss)/?$",
      "status": 308,
      "headers": {
        "Location": "/rss.xml"
      }
    },
    {
      "src": "^/(notes|library|tools|sites)/feed/?$",
      "status": 308,
      "headers": {
        "Location": "/$1/rss.xml"
      }
    },
    {
      "src": "^/tools/category/claude-skills/?$",
      "status": 308,
      "headers": {
        "Location": "/tools/category/agent-skills"
      }
    },
    {
      "src": "^/tools/category/web-utility/?$",
      "status": 308,
      "headers": {
        "Location": "/tools/category/web-access"
      }
    },
    {
      "src": "^/tools/category/desktop-utility/?$",
      "status": 308,
      "headers": {
        "Location": "/tools/category/personal-apps"
      }
    },
    {
      "src": "^/tools/category/sandboxes/?$",
      "status": 308,
      "headers": {
        "Location": "/tools/category/agent-infra"
      }
    },
    {
      "src": "^/tools/category/unsorted/?$",
      "status": 308,
      "headers": {
        "Location": "/tools"
      }
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/index.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept, Accept-Encoding"
      }
    },
    {
      "src": "^/tools/?$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/tools.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept, Accept-Encoding"
      }
    },
    {
      "src": "^/sites/?$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/sites.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept, Accept-Encoding"
      }
    },
    {
      "src": "^/library/?$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/library.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept, Accept-Encoding"
      }
    },
    {
      "src": "^/experiments/?$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/experiments.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept, Accept-Encoding"
      }
    },
    {
      "src": "^/notes/?$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/notes.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept, Accept-Encoding"
      }
    },
    {
      "src": "^/(tools|sites|library|experiments|notes)/?$",
      "headers": {
        "Vary": "Accept, Accept-Encoding",
        "Link": "<https://aayushmanchanda.com/$1.md>; rel=\"alternate\"; type=\"text/markdown\""
      },
      "continue": true
    },
    {
      "src": "^/$",
      "headers": {
        "Vary": "Accept, Accept-Encoding",
        "Link": "<https://aayushmanchanda.com/index.md>; rel=\"alternate\"; type=\"text/markdown\""
      },
      "continue": true
    },
    {
      "src": "^/index\\.md$",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept, Accept-Encoding",
        "Link": "<https://aayushmanchanda.com/>; rel=\"canonical\""
      },
      "continue": true
    },
    {
      "src": "^/(tools|sites|library|experiments|notes)\\.md$",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept, Accept-Encoding",
        "Link": "<https://aayushmanchanda.com/$1>; rel=\"canonical\""
      },
      "continue": true
    },
    {
      "src": "^/llms\\.txt$",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "^/(.+)/$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(library|tools)/[^/]+?(?:\\.md)?/?$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "handle": "error"
    },
    {
      "src": "^/.*$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "status": 404,
      "dest": "/404.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept, Accept-Encoding"
      }
    },
    {
      "src": "^/.*$",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
