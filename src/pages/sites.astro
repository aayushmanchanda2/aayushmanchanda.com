---
import Mark from "../components/Mark.astro";
import Base from "../layouts/Base.astro";
import CollectionChips from "../components/CollectionChips.astro";
import SiteGrid from "../components/SiteGrid.astro";
import SiteList from "../components/SiteList.astro";
import DetailPanel from "../components/DetailPanel.astro";
import SiteDetail from "../components/SiteDetail.astro";
import ViewToggle from "../components/ViewToggle.astro";
import { listJsonLd, pageUrl } from "../lib/schema";
import { collectionGroups, siteGroups, sites } from "../lib/sites";
import { SITES_VIEW } from "../lib/view-toggle";

// Imported for its styles, never rendered here: the panel fetches the entry
// (`DetailPanel.astro`). An unused import is elided, hence the `void`.
void SiteDetail;

/**
 * The line renders at two collections, not at one.
 *
 * One collection is not a way of slicing the gallery, it is a single link
 * pretending to be one — and a reader who follows it lands on a page that is
 * the gallery minus a few, with nothing to compare it to. Two is the smallest
 * number where the row is doing what it looks like it does. Below that it does
 * not render at all, which is the same rule `lib/sections.ts` applies to an
 * empty section: no scaffolding for content that is not there yet.
 */
const showCollections = collectionGroups.length >= 2;

/**
 * Every entry page, in the order `sites/[slug].astro` walks with the arrow
 * keys. The grid folds several pages of one domain into one card
 * (`lib/screens.ts`); a machine still gets every page.
 */
const jsonLd = listJsonLd({
  name: "Sites",
  path: "/sites",
  entries: sites.map((site) => ({
    name: site.title,
    url: pageUrl(`/sites/${site.slug}`),
  })),
});
---

<Base
  title="Sites · Aayush Manchanda"
  description="Websites Aayush Manchanda saved for how they look, each a full-page screenshot from the day it was saved."
  jsonLd={jsonLd}
  full
>
  <header>
    <h1 class="page-title"><Mark shape="squiggle" color="blue" variant={2}>Sites</Mark></h1>
    <p class="standfirst">
      Sites I saved for how they look, each a full-page screenshot from the day
      I saved it.
    </p>

    <div class="controls">
      {/*
        Chips, the pill every collection wears on a site's page, and not the tab
        row /library uses: a site can be in three collections or in none, so
        tabs here would claim a partition the data does not have.
      */}
      {
        showCollections && (
          <nav class="collections" aria-label="Filter sites by collection">
            <span class="collections__label mono">Collections</span>
            <CollectionChips collections={collectionGroups.map((group) => group.slug)} />
          </nav>
        )
      }
      <ViewToggle config={SITES_VIEW} label="Sites layout" />
    </div>
  </header>

  <div class="body">
    <SiteGrid groups={siteGroups} />
    <SiteList groups={siteGroups} />
  </div>

  <DetailPanel base="/sites" listWidth="min(460px, 50vw)" />
</Base>

<script>
  import { initDetailPanel } from "../lib/detail-panel";
  import { enhanceSiteDetail } from "../lib/site-detail";

  initDetailPanel(enhanceSiteDetail);
</script>

<style>
  .body {
    margin-top: var(--gap-masthead);
  }

  /* Collections on the left, the layout toggle on the right, 16px below the
     standfirst (design.md §2). */
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 1rem;
  }

  /* Takes the row's slack, so its chips wrap beside the layout toggle rather
     than pushing the toggle onto a line of its own. */
  .collections {
    flex: 1 1 20rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    /* 8px inside the group */
    gap: 0.5rem;
    color: var(--text-tertiary);
  }
</style>
