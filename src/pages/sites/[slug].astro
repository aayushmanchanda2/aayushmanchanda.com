---
/**
 * One site, as its own page: `SiteDetail.astro` plus the hint row.
 *
 * The /sites gallery opens the same content in a slide-over panel and pushes
 * this URL, so a reload, a shared link or a reader without scripting lands
 * here and gets the whole page (VET-242). The panel fetches this page and
 * lifts the `article` out; nothing but the hint row is page-only.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import Base from "../../layouts/Base.astro";
import EntryNav from "../../components/EntryNav.astro";
import SiteDetail from "../../components/SiteDetail.astro";
import { siteJsonLd } from "../../lib/schema";
import { neighbours } from "../../lib/screens";
import type { Site } from "../../lib/sites";
import { siteGroups, sites } from "../../lib/sites";

/**
 * Neighbours are resolved here rather than in the browser: the build already
 * knows the gallery, so the page ships the two hrefs as markup.
 *
 * The ring is the gallery's cards (`siteGroups`, one per domain), in the order
 * /sites renders them, so pressing → moves the way the eye moved through the
 * grid and a site saved as three screens is one step (`lib/screens.ts ›
 * neighbours`). Each step lands on the neighbouring card's primary page.
 */
export const getStaticPaths = (() =>
  sites.map((site) => {
    const link = (neighbour: Site | null) =>
      neighbour && { href: `/sites/${neighbour.slug}`, title: neighbour.title };
    const { prev, next } = neighbours(siteGroups, site.slug);
    return {
      params: { slug: site.slug },
      props: { site, prev: link(prev), next: link(next) },
    };
  })) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { site, prev, next } = Astro.props;

/**
 * This page, the site it is about, and the screenshot — three things kept
 * apart, so the picture and the palette stay ours and the name and the URL stay
 * theirs. See `lib/schema.ts`.
 */
const jsonLd = siteJsonLd(site);

/** The page shot: host and path, so three screens of one site are three results. */
const where = `${site.domain}${new URL(site.url).pathname.replace(/\/$/, "")}`;
const screen = where === site.domain ? site.title : `${site.title} (${where.slice(site.domain.length)})`;
---

<Base
  title={`${screen} · Sites · Aayush Manchanda`}
  description={`Full-page screenshot of ${site.title} (${where}), saved ${site.saved_date}.`}
  jsonLd={jsonLd}
>

  <SiteDetail site={site} />

  {/*
    The hint row is the keyboard legend and the links themselves — EntryNav
    owns the anatomy, the keys and the reasoning. This page only decides the
    ring: `sites`, in gallery order, wrapping.
  */}
  <EntryNav
    label="Sites entries"
    close={{ href: "/sites", aria: "Close and go back to Sites" }}
    prev={prev && { href: prev.href, aria: `Previous site: ${prev.title}` }}
    next={next && { href: next.href, aria: `Next site: ${next.title}` }}
  />
</Base>
