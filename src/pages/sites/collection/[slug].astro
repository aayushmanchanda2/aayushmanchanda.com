---
/**
 * One collection: every site I put in it.
 *
 * Sibling of `/sites/domain/<domain>`, and deliberately the same page with a
 * different reason for the grouping. A domain page answers "what else have I
 * saved from here", which is a fact about the URL. This one answers "what else
 * did I file with this", which is a judgement — so the two must not look like
 * different kinds of thing, and both hand the same `SiteGrid` a subset.
 *
 * Reached from the chips on any entry's details page, and from the line under
 * the standfirst on /sites, which carries its `?hue=` here: the colour row
 * below filters this subset the way it filters the gallery (VET-55). The same
 * Collections row sits on top with this one on: its × and Clear lead back to
 * the whole gallery (VET-309).
 */
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import Base from "../../../layouts/Base.astro";
import CollectionFilter from "../../../components/CollectionFilter.astro";
import HueFilter from "../../../components/HueFilter.astro";
import SiteGrid from "../../../components/SiteGrid.astro";
import { groupByDomain } from "../../../lib/screens";
import { listJsonLd, pageUrl } from "../../../lib/schema";
import { collectionGroups } from "../../../lib/sites";
import { withNames } from "../../../lib/meta";

export const getStaticPaths = (() =>
  collectionGroups.map((group) => ({
    params: { slug: group.slug },
    props: group,
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { label, slug, sites } = Astro.props;
const count = sites.length;
const groups = groupByDomain(sites);
const lead = `${count} ${count === 1 ? "site" : "sites"} I filed under`;

/** The filtered grid, plus the crumb this page actually draws. */
const jsonLd = listJsonLd({
  name: label,
  path: `/sites/collection/${slug}`,
  parent: { name: "Sites", path: "/sites" },
  entries: sites.map((site) => ({
    name: site.title,
    url: pageUrl(`/sites/${site.slug}`),
  })),
});
---

<Base
  title={`${label} · Sites · Aayush Manchanda`}
  description={withNames(`${lead} ${label}.`, sites.map((site) => site.title))}
  noindex={sites.length === 1}
  jsonLd={jsonLd}
  full
>

  <header>
    <h1 class="page-title page-title--entry">{label}</h1>
    <p class="standfirst">
      {lead} {label}.
    </p>
    <div class="controls">
      <CollectionFilter current={slug} />
      <HueFilter groups={groups} base={`/sites/collection/${slug}`} all="/sites" />
    </div>
  </header>

  <div class="body">
    <SiteGrid groups={groups} />
  </div>
</Base>

<style>
  /* The /sites controls row's place: 16px below the standfirst, collections
     over colours. */
  .controls {
    display: grid;
    /* two rows of 44px targets under a finger (VET-307) */
    gap: 1rem;
    margin-top: 1rem;
  }

  .body {
    margin-top: var(--gap-masthead);
  }
</style>
