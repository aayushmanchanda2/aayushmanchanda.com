---
/**
 * Every saved page from one domain. Reached from a site's details page.
 * Today most domains hold a single entry; the route exists so that saving a
 * second page from the same site groups instead of scattering.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import Base from "../../../layouts/Base.astro";
import SiteGrid from "../../../components/SiteGrid.astro";
import { listJsonLd, pageUrl } from "../../../lib/schema";
import { domains } from "../../../lib/sites";

export const getStaticPaths = (() =>
  domains.map((group) => ({
    params: { domain: group.slug },
    props: group,
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { domain, slug, sites } = Astro.props;
const count = sites.length;
const lead = `${count} ${count === 1 ? "page" : "pages"} I saved from`;

/** The filtered grid, plus the crumb this page actually draws. */
const jsonLd = listJsonLd({
  name: domain,
  path: `/sites/domain/${slug}`,
  parent: { name: "Sites", path: "/sites" },
  entries: sites.map((site) => ({
    name: site.title,
    url: pageUrl(`/sites/${site.slug}`),
  })),
});
---

<Base
  title={`${domain} · Sites · Aayush Manchanda`}
  description={`${lead} ${domain}.`}
  jsonLd={jsonLd}
>
  <p class="crumb mono"><a href="/sites">&larr; Sites</a></p>

  <header>
    <h1 class="page-title page-title--entry">{domain}</h1>
    <p class="standfirst">{lead} {domain}.</p>
  </header>

  <div class="body">
    <SiteGrid sites={sites} />
  </div>
</Base>

<style>
  .body {
    margin-top: var(--gap-masthead);
  }
</style>
