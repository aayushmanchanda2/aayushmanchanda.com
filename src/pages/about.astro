---
/**
 * /about: the photo, the bio, the work, the site's sections, the profiles.
 *
 * The bio is the home page's hero at length, so this is the one page besides
 * home that emits the long-form `Person` (`lib/schema.ts › person`), photo
 * included. The Orbis line is exactly "co-founded Orbis, an AI healthcare
 * company" plus what it does: no title, no years (design.md §6).
 *
 * Work logos are `AppIcon` (live from img.logo.dev, which /privacy names for
 * this page). Projects are the sections that have entries, from the same
 * manifest the home index reads.
 *
 * Not in the nav: a footer page beside /contact and /privacy.
 */
import AppIcon from "../components/AppIcon.astro";
import Avatar from "../components/Avatar.astro";
import Doodle from "../components/Doodle.astro";
import Base from "../layouts/Base.astro";
import { aboutJsonLd } from "../lib/schema";
import { getSections } from "../lib/sections";

const jsonLd = aboutJsonLd();
const sections = await getSections();

const work = [
  {
    slug: "orbis",
    name: "Orbis",
    url: "https://orbisassist.co",
    what: "Voice receptionist for dental clinics",
    role: null,
  },
  {
    slug: "vetted",
    name: "Vetted",
    url: "https://vetted.tools",
    what: "AI transformation partner",
    role: "Founder",
  },
];

const elsewhere = [
  { name: "X", handle: "@amanchanda7", href: "https://x.com/amanchanda7" },
  { name: "GitHub", handle: "aayushmanchanda2", href: "https://github.com/aayushmanchanda2" },
  { name: "Email", handle: "/contact", href: "/contact" },
];
---

<Base
  title="About · Aayush Manchanda"
  trail={[{ name: "About", path: "/about" }]}
  description="Aayush Manchanda runs Vetted, an AI transformation partner, and co-founded Orbis, an AI healthcare company. His work, the sections, and where to find him."
  jsonLd={jsonLd}
>
  <header>
    <div class="about__photo">
      <Avatar size={64} />
      <Doodle class="about__spark" shape="sparkle" variant={3} color="amber" draw />
    </div>
    <h1 class="page-title">About</h1>
    <p class="bio">
      I run Vetted, an AI transformation partner, and I co-founded Orbis, an
      AI healthcare company. Between the two I&rsquo;m shipping with
      agents every week, which is where every verdict on this site comes from.
    </p>
  </header>

  <div class="parts">
    <section aria-labelledby="work-head">
      <h2 class="doc__head mono" id="work-head">Work</h2>
      <ul class="rows">
        {
          work.map((company) => (
            <li class="line">
              <AppIcon tool={company} size={32} />
              <span class="line__body">
                <span class="line__name">{company.name}</span>
                <span class="line__what">{company.what}</span>
              </span>
              {company.role && <span class="line__meta mono">{company.role}</span>}
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="projects-head">
      <h2 class="doc__head mono" id="projects-head">Projects</h2>
      <ul class="rows">
        {
          sections.map((section) => (
            <li>
              <a class="line line--link press" href={section.href}>
                <span class="line__body">
                  <span class="line__name">{section.name}</span>
                  <span class="line__what">{section.blurb}</span>
                </span>
                <span class="line__meta mono tabular-nums">{section.count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="elsewhere-head">
      <h2 class="doc__head mono" id="elsewhere-head">Elsewhere</h2>
      <ul class="rows">
        {
          elsewhere.map((link) => {
            const external = link.href.startsWith("https://");
            return (
              <li>
                <a
                  class="line line--link press"
                  href={link.href}
                  rel={external ? "me noopener" : undefined}
                  target={external ? "_blank" : undefined}
                >
                  <span class="line__name">{link.name}</span>
                  <span class:list={["line__meta mono", { ext: external }]}>{link.handle}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  /* The photo's box, so the sparkle sits off its top-right edge in the empty
     space beside it and never on the face or the title. */
  .about__photo {
    position: relative;
    width: 64px;
    height: 64px;
    margin-bottom: 1.5rem;
  }

  .about__spark {
    position: absolute;
    top: -8px;
    left: 70px;
    width: 22px;
    height: 22px;
  }

  /* briOS's bio: 24px (20px on a phone), medium, secondary ink. */
  .bio {
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
    max-width: 40rem;
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.35;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  /* The `.doc` rhythm (global.css) without its prose-link rule: every link
     here is a row, so the rows sit outside `.doc` rather than override it. */
  .parts {
    margin-top: var(--gap-masthead);
    max-width: 40rem;
  }

  .parts section + section {
    margin-top: clamp(2rem, 5vw, 2.75rem);
  }

  .rows {
    margin-top: 0.75rem;
    border-top: 1px solid var(--hairline);
  }

  .line {
    --press-scale: 0.995;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.25rem 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--hairline);
    color: inherit;
    text-decoration: none;
  }

  .line--link {
    grid-template-columns: 1fr auto;
  }

  .line__body {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 0.75rem;
    min-width: 0;
  }

  .line__name {
    font-weight: 500;
  }

  .line__what {
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .line__meta {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    text-align: right;
  }

  .line--link:hover {
    border-bottom-color: var(--hairline-strong);
  }

  .line--link:hover .line__name {
    color: var(--accent);
  }

  @media (max-width: 599px) {
    .line__body {
      flex-direction: column;
      gap: 0.15rem;
    }
  }
</style>
