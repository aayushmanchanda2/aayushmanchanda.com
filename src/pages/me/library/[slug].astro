---
/** /me/library/<slug> (VET-274): on demand, behind Clerk and ALLOWED_EMAIL, never cached. */
import MeGate from "../../../components/MeGate.astro";
import PrivateEntry from "../../../components/PrivateEntry.astro";
import { gate, privateApi, privateHeaders } from "../../../lib/me";
import type { PrivateRow } from "../../../lib/private";
import { toEntries, toEntry } from "../../../lib/private";

export const prerender = false;

privateHeaders(Astro.response.headers);
const access = await gate(Astro.locals);

let view = null;
if (access.state === "owner") {
  const slug = Astro.params.slug ?? "";
  const [list, one] = await Promise.all([access.convex.query(privateApi.list, {}), access.convex.query(privateApi.get, { slug })]);
  if (one !== null) view = { entry: toEntry(one.row, one.media), rows: toEntries(list as PrivateRow[]), mine: one.row.raindrop_note, sweep: one.row.sweep_note };
}
const state = access.state === "owner" || access.state === "forbidden" ? "not-found" : access.state;
if (view === null && state === "not-found") Astro.response.status = 404;
---

{view ? <PrivateEntry {...view} /> : <MeGate state={state} />}
