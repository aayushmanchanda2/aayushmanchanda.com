---
/** /me/library (VET-274): on demand, behind Clerk and ALLOWED_EMAIL, never cached. */
import MeGate from "../../../components/MeGate.astro";
import PrivateIndex from "../../../components/PrivateIndex.astro";
import { gate, privateApi, privateHeaders } from "../../../lib/me";
import type { PrivateRow } from "../../../lib/private";
import { toEntries } from "../../../lib/private";

export const prerender = false;

privateHeaders(Astro.response.headers);
const access = await gate(Astro.locals);
const rows = access.state === "owner" ? toEntries((await access.convex.query(privateApi.list, {})) as PrivateRow[]) : null;
const state = access.state === "owner" || access.state === "forbidden" ? "not-found" : access.state;
if (rows === null && state === "not-found") Astro.response.status = 404;
---

{rows ? <PrivateIndex rows={rows} /> : <MeGate state={state} />}
