---
/**
 * Every tool sharing one verdict. Reached from a tool's details page.
 * Verdicts with no entries never get a page.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import Base from "../../../layouts/Base.astro";
import ToolList from "../../../components/ToolList.astro";
import { listJsonLd, pageUrl } from "../../../lib/schema";
import type { Verdict } from "../../../lib/tools";
import { VERDICT_LABELS, verdictGroups } from "../../../lib/tools";

const STANDFIRST: Record<Verdict, string> = {
  using: "Tools I use day to day.",
  watching: "Tools that run fine and haven't made the daily stack yet.",
  "on-hold": "Tools I started testing and stopped before a verdict.",
  skipped: "Tools I looked at and set aside. Each note says why.",
};

export const getStaticPaths = (() =>
  verdictGroups.map((group) => ({
    params: { verdict: group.verdict },
    props: group,
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { verdict, tools } = Astro.props;
const heading = VERDICT_LABELS[verdict];
const standfirst = STANDFIRST[verdict];

/** The filtered list, plus the crumb this page actually draws. */
const jsonLd = listJsonLd({
  name: heading,
  path: `/tools/verdict/${verdict}`,
  parent: { name: "Tools", path: "/tools" },
  entries: tools.map((tool) => ({
    name: tool.name,
    url: pageUrl(`/tools/${tool.slug}`),
  })),
});
---

<Base
  title={`${heading} · Tools · Aayush Manchanda`}
  description={standfirst}
  jsonLd={jsonLd}
  full
>

  <header>
    <h1 class="page-title">{heading}</h1>
    <p class="standfirst">{standfirst}</p>
  </header>

  <div class="body">
    <ToolList tools={tools} drop="verdict" />
  </div>
</Base>

<style>
  .body {
    margin-top: var(--gap-masthead);
  }
</style>
