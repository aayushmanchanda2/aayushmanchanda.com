---
/**
 * One tool, as its own page: `ToolDetail.astro` inside the base layout.
 *
 * The /tools index opens the same content in a slide-over panel and pushes
 * this URL, so a reload, a shared link or a reader without scripting lands
 * here and gets the whole page. The panel fetches this page and lifts the
 * `article` out.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import Base from "../../layouts/Base.astro";
import PreviewCard from "../../components/PreviewCard.astro";
import ToolDetail from "../../components/ToolDetail.astro";
import { assetFor } from "../../lib/assets";
import { toolJsonLd } from "../../lib/schema";
import { tools } from "../../lib/tools";

export const getStaticPaths = (() =>
  tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { tool } = Astro.props;

/**
 * The software, and his review of it, as two linked nodes. Every sentence in
 * the `reviewBody` is a sentence rendered below, and there is no rating in it
 * because there is no number on this page. See `lib/schema.ts`.
 */
const jsonLd = toolJsonLd(tool);
---

<Base
  title={`${tool.name} · Tools · Aayush Manchanda`}
  description={tool.description ? `${tool.name}: ${tool.description}. ${tool.note}` : tool.note}
  jsonLd={jsonLd}
>
  <ToolDetail tool={tool} />
  {assetFor("previews", tool.slug) && <PreviewCard />}
</Base>

<script>
  // Only an icon on the /tools grid opens with the zoom (`lib/home-screen.ts`).
  window.addEventListener("pageswap", (event) => event.viewTransition?.skipTransition());
</script>

<style is:global>
  /* The app-open zoom (VET-253): the /tools icon named `app-open` grows into
     the page's main column while the rest crossfades (the opt-in is site-wide,
     `styles/global.css`). Leaving this page never animates (script above). */

  #main {
    view-transition-name: app-open;
  }

  ::view-transition-group(app-open) {
    animation-duration: 380ms;
    animation-timing-function: var(--ease-out);
  }

  /* The icon lets go early, so the page is what fills the screen. */
  ::view-transition-old(app-open) {
    animation-duration: 180ms;
  }
</style>
