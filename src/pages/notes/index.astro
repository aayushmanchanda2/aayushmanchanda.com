---
/**
 * /notes — briOS's /writing: the titles, grouped by year, newest first.
 *
 * The masthead is the section scale every other index uses (`.page-title`);
 * the year is a small label over each group, and the rows are `EntryList`, the
 * same list "Read next" draws under a note.
 */
import { getCollection } from "astro:content";

import Base from "../../layouts/Base.astro";
import EntryList from "../../components/EntryList.astro";
import { noteEntry } from "../../lib/entry-list";
import { listJsonLd, pageUrl } from "../../lib/schema";

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

/** Already newest first, so the years and each year's notes come out in order. */
const years = Map.groupBy(notes, (note) => note.data.date.getUTCFullYear());

const jsonLd = listJsonLd({
  name: "Notes",
  path: "/notes",
  entries: notes.map((note) => ({
    name: note.data.title,
    url: pageUrl(`/notes/${note.id}`),
  })),
});
---

<Base
  title="Notes · Aayush Manchanda"
  description="Short notes from Aayush Manchanda: musings written out, and whiteboard scratches with a line underneath."
  jsonLd={jsonLd}
>
  <header>
    <h1 class="page-title">Notes</h1>
    <p class="standfirst">
      Short things I wanted somewhere public. Some are written out, some are a
      photo of a whiteboard with one line under it.
    </p>
  </header>

  <div class="years">
    {
      [...years].map(([year, group]) => (
        <section aria-labelledby={`y${year}`}>
          <h2 class="year mono" id={`y${year}`}>{year}</h2>
          <EntryList entries={group.map(noteEntry)} />
        </section>
      ))
    }
  </div>
</Base>

<style>
  /* briOS's /writing: 64px between years, 16px from a year to its titles
     (8px here plus the row's own 4px padding and half-leading). */
  .years {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin-top: var(--gap-masthead);
  }

  .year {
    margin-bottom: 0.5rem;
    color: var(--text-tertiary);
    line-height: 1.6;
  }
</style>
