---
/**
 * /notes — briOS's /writing: the titles, grouped by year, newest first, under
 * a "How I work" group of tips in their set order (what /computer was).
 *
 * The masthead is the section scale every other index uses (`.page-title`);
 * the year is a small label over each group, and the rows are `EntryList`, the
 * same list "Read next" draws under a note.
 */
import Mark from "../../components/Mark.astro";
import { getCollection } from "astro:content";

import Base from "../../layouts/Base.astro";
import EntryList from "../../components/EntryList.astro";
import { noteEntry, tipEntry } from "../../lib/entry-list";
import { listJsonLd, pageUrl } from "../../lib/schema";

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const tips = (await getCollection("computer")).sort((a, b) => a.data.order - b.data.order);

/** Already newest first, so the years and each year's notes come out in order. */
const years = Map.groupBy(notes, (note) => note.data.date.getUTCFullYear());

const jsonLd = listJsonLd({
  name: "Notes",
  path: "/notes",
  entries: [...tips, ...notes].map((entry) => ({
    name: entry.data.title,
    url: pageUrl(`/notes/${entry.id}`),
  })),
});
---

<Base
  title="Notes · Aayush Manchanda"
  description="How Aayush Manchanda works with his computer and the AI agents on it, each tip with the exact steps, then his short notes."
  jsonLd={jsonLd}
>
  <header>
    <h1 class="page-title"><Mark color="pink" variant={3}>Notes</Mark></h1>
    <p class="standfirst">
      How I work with my computer and the agents on it, each tip with the
      exact steps. Then short writing, some of it a whiteboard photo.
    </p>
  </header>

  <div class="years">
    {
      tips.length > 0 && (
        <section aria-labelledby="how-i-work">
          <h2 class="year mono" id="how-i-work">How I work</h2>
          <EntryList entries={tips.map(tipEntry)} />
        </section>
      )
    }
    {
      [...years].map(([year, group]) => (
        <section aria-labelledby={`y${year}`}>
          <h2 class="year mono" id={`y${year}`}>{year}</h2>
          <EntryList entries={group.map(noteEntry)} />
        </section>
      ))
    }
  </div>
</Base>

<style>
  /* briOS's /writing: 64px between years, 16px from a year to its titles
     (8px here plus the row's own 4px padding and half-leading). */
  .years {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin-top: var(--gap-masthead);
  }

  .year {
    margin-bottom: 0.5rem;
    color: var(--text-tertiary);
    line-height: 1.6;
  }
</style>
