---
/**
 * One note. Two shapes, because the two note types are read differently.
 *
 * A musing is prose, so it gets a date, a title, and the shared `.prose`
 * column (`styles/prose.css`).
 * A scratch is a picture, so the picture comes first and the words underneath
 * are the caption. Ordering the DOM that way rather than reordering with CSS
 * keeps the reading order and the visual order the same.
 *
 * Body links are plain markdown links (`[the pipeline](/experiments)`). There
 * is no wiki-link syntax and no remark plugin behind it: markdown already does
 * this, and a custom `[[slug]]` parser would be a second link system to keep
 * working for no reader-visible gain.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection, render } from "astro:content";

import Base from "../../layouts/Base.astro";
import EntryLink from "../../components/EntryLink.astro";
import ImageFrame from "../../components/ImageFrame.astro";
import EntryList from "../../components/EntryList.astro";
import { noteJsonLd } from "../../lib/schema";
import { formatDay, isoDay } from "../../lib/date";
import { noteEntry } from "../../lib/entry-list";
import { readNext } from "../../lib/read-next";

export const getStaticPaths = (async () => {
  const notes = await getCollection("notes");
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note, next: readNext(note.id, notes) },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { note, next } = Astro.props;
const { Content } = await render(note);

const day = isoDay(note.data.date);
const links = note.data.links ?? [];

/**
 * The same three things the page shows: the title, the date above it, and the
 * picture when there is one. `day` rather than the `Date`, so the graph and the
 * `<time datetime>` carry one string.
 */
const jsonLd = noteJsonLd({
  slug: note.id,
  title: note.data.title,
  date: day,
  image: note.data.image ?? null,
});
---

<Base
  title={`${note.data.title} · Notes · Aayush Manchanda`}
  description={`A note by Aayush Manchanda, written ${day}: ${note.data.title}.`}
  jsonLd={jsonLd}
>

  <article class="note" data-type={note.data.type}>
    {
      note.data.type === "scratch" && (
        <ImageFrame src={note.data.image} alt={note.data.title} />
      )
    }

    <header class="note__head">
      <time class="note__date mono" datetime={day}>{formatDay(day)}</time>
      <h1 class="page-title page-title--entry">{note.data.title}</h1>
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      links.length > 0 && (
        <nav class="also" aria-label="Elsewhere on this site">
          <h2 class="also__head mono">See also</h2>
          <ul class="also__list mono">
            {links.map((link) => (
              <li>
                <EntryLink href={link} />
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </article>

  {
    next.length > 0 && (
      <nav class="next" aria-labelledby="read-next">
        <h2 class="accent-bar" id="read-next">Read next</h2>
        <EntryList entries={next.map(noteEntry)} />
      </nav>
    )
  }
</Base>

<style>
  .note[data-type="scratch"] .note__head {
    /* the picture is the headline; the title is what it is a picture of */
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
  }

  /* Above the title, briOS's order: when, then what. 24px to the title and
     32px from the title to the body, his `gap-6` and `gap-8`. */
  .note__date {
    display: block;
    margin-bottom: 1.5rem;
    color: var(--text-tertiary);
  }

  .prose {
    margin-top: 2rem;
  }

  /* --- see also ------------------------------------------------------------ */

  .also {
    margin-top: clamp(3rem, 8vw, 4.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
  }

  .also__head {
    color: var(--text-tertiary);
  }

  .also__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 0.75rem;
  }

  /* --- read next ----------------------------------------------------------- */

  .next {
    margin-top: clamp(3rem, 8vw, 5rem);
  }
</style>
