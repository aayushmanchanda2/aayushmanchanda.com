---
/**
 * One note. Two shapes, because the two note types are read differently.
 *
 * A musing is prose, so it gets a title, a date, and a 65ch column.
 * A scratch is a picture, so the picture comes first and the words underneath
 * are the caption. Ordering the DOM that way rather than reordering with CSS
 * keeps the reading order and the visual order the same.
 *
 * Body links are plain markdown links (`[the pipeline](/experiments)`). There
 * is no wiki-link syntax and no remark plugin behind it: markdown already does
 * this, and a custom `[[slug]]` parser would be a second link system to keep
 * working for no reader-visible gain.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection, render } from "astro:content";

import Base from "../../layouts/Base.astro";
import EntryLink from "../../components/EntryLink.astro";
import ImageFrame from "../../components/ImageFrame.astro";
import { noteJsonLd } from "../../lib/schema";
import { formatDay } from "../../lib/date";

export const getStaticPaths = (async () => {
  const notes = await getCollection("notes");
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { note } = Astro.props;
const { Content } = await render(note);

const day = note.data.date.toISOString().slice(0, 10);
const links = note.data.links ?? [];

/**
 * The same three things the page shows: the title, the date under it, and the
 * picture when there is one. `day` rather than the `Date`, so the graph and the
 * `<time datetime>` carry one string.
 */
const jsonLd = noteJsonLd({
  slug: note.id,
  title: note.data.title,
  date: day,
  image: note.data.image ?? null,
});
---

<Base
  title={`${note.data.title} · Notes · Aayush Manchanda`}
  description={`A note by Aayush Manchanda, written ${day}: ${note.data.title}.`}
  jsonLd={jsonLd}
>

  <article class="note" data-type={note.data.type}>
    {
      note.data.type === "scratch" && (
        <ImageFrame src={note.data.image} alt={note.data.title} />
      )
    }

    <header class="note__head">
      <time class="note__date mono" datetime={day}>{formatDay(day)}</time>
      <h1 class="page-title page-title--entry">{note.data.title}</h1>
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      links.length > 0 && (
        <nav class="also" aria-label="Elsewhere on this site">
          <h2 class="also__head mono">See also</h2>
          <ul class="also__list mono">
            {links.map((link) => (
              <li>
                <EntryLink href={link} />
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .note[data-type="scratch"] .note__head {
    /* the picture is the headline; the title is what it is a picture of */
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
  }

  /* Above the title, briOS's order: when, then what. */
  .note__date {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--text-tertiary);
  }

  /* --- body ---------------------------------------------------------------- */

  /* Primary ink at 18/1.6, capped in rem (Geist's ch runs wide), and
     unsmoothed so the strokes keep their weight on macOS (VET-225). */
  .prose {
    margin-top: clamp(2rem, 5vw, 3rem);
    max-width: 40rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-primary);
    -webkit-font-smoothing: auto;
    -moz-osx-font-smoothing: auto;
  }

  .prose :global(p + p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote) {
    margin-top: 1.35em;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin-top: 2em;
    color: var(--text-primary);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
  }

  .prose :global(h3) {
    font-size: 1.25rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
    list-style: disc;
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(li + li) {
    margin-top: 0.4em;
  }

  /* --text-secondary, not --text-tertiary: a quotation is prose a reader is reading, and
     --text-tertiary is the meta level (design.md §2's three text levels). The rule and
     the indent are what set it apart from the body around it. */
  .prose :global(blockquote) {
    padding-left: 1rem;
    border-left: 1px solid var(--hairline-strong);
    color: var(--text-secondary);
  }

  /* A link in the body is underlined in the accent, and that rule lives in
     global.css as `.prose a` — one convention across note bodies, /privacy, the
     standfirsts and the entry pages, rather than this file's own half of it. */

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  /* --- see also ------------------------------------------------------------ */

  .also {
    margin-top: clamp(3rem, 8vw, 4.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
  }

  .also__head {
    color: var(--text-tertiary);
  }

  .also__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 0.75rem;
  }
</style>
