---
/**
 * Everything saved from one host. Reached from the mono hostname on a row.
 *
 * The list drops its domain column here: the h1 is already the domain, and a
 * column repeating it nine times would be the page explaining itself to someone
 * who arrived by clicking that exact word.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import Base from "../../../layouts/Base.astro";
import LibraryList from "../../../components/LibraryList.astro";
import { libraryDomains } from "../../../lib/library";
import { listJsonLd } from "../../../lib/schema";

export const getStaticPaths = (() =>
  libraryDomains.map((group) => ({
    params: { domain: group.slug },
    props: group,
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { domain, slug, entries } = Astro.props;
const count = entries.length;
const lead = `${count} ${count === 1 ? "link" : "links"} I saved from`;

/** Off-site rows, same as /library, plus the crumb this page draws. */
const jsonLd = listJsonLd({
  name: domain,
  path: `/library/domain/${slug}`,
  parent: { name: "Library", path: "/library" },
  entries: entries.map((entry) => ({ name: entry.title, url: entry.url })),
});
---

<Base
  title={`${domain} · Library · Aayush Manchanda`}
  description={`${lead} ${domain}.`}
  jsonLd={jsonLd}
>
  <p class="crumb mono"><a href="/library">&larr; Library</a></p>

  <header>
    <h1 class="page-title domain">{domain}</h1>
    <p class="standfirst">{lead} {domain}.</p>
  </header>

  <div class="body">
    <LibraryList entries={entries} showDomain={false} />
  </div>
</Base>

<style>
  /* A domain is a long, dot-heavy string; the section scale would overflow the
     column on anything longer than a short hostname. Same call as /sites. */
  .domain {
    font-size: clamp(2rem, 6vw, 3.25rem);
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .body {
    margin-top: clamp(3.5rem, 12vh, 6rem);
  }
</style>
