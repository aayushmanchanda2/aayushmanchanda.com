---
/**
 * One tag: everything I filed under it.
 *
 * Third of the /library filter routes and the one built like /sites'
 * collections rather than like its own two siblings, because it is the same
 * kind of grouping: a kind is a fact about the file, a domain is a fact about
 * the URL, and a tag is a judgement about the subject. So this is
 * `sites/collection/[slug].astro` with a list where the grid was.
 *
 * Reached two ways now, and the second is the point of this ticket. A chip on
 * any row about the subject was the only entrance, which meant the vocabulary
 * was invisible until a reader had already found something in it;
 * `TagFilters.astro` puts the whole of it at the top of every library list,
 * this page included, with the tag you are standing on marked.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import Base from "../../../layouts/Base.astro";
import LibraryList from "../../../components/LibraryList.astro";
import TagFilters from "../../../components/TagFilters.astro";
import { libraryTags } from "../../../lib/library";
import { libraryRowUrl, listJsonLd } from "../../../lib/schema";
import { tagLabel } from "../../../lib/tags";

export const getStaticPaths = (() =>
  libraryTags.map((group) => ({
    params: { slug: group.slug },
    props: group,
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { slug, entries } = Astro.props;
const label = tagLabel(slug);
const count = entries.length;
const lead = `${count} ${count === 1 ? "link" : "links"} I filed under`;

/** Rows point where they go, same as /library, plus the crumb this page draws. */
const jsonLd = listJsonLd({
  name: label,
  path: `/library/tag/${slug}`,
  parent: { name: "Library", path: "/library" },
  entries: entries.map((entry) => ({ name: entry.title, url: libraryRowUrl(entry) })),
});
---

<Base
  title={`${label} · Library · Aayush Manchanda`}
  description={`${lead} ${label}.`}
  jsonLd={jsonLd}
  wide
>
  <p class="crumb mono"><a href="/library">&larr; Library</a></p>

  <header>
    <h1 class="page-title page-title--entry">{label}</h1>
    <p class="standfirst">
      {lead} {label}. Tags overlap: a link can carry a couple, or none at all.
    </p>
  </header>

  <div class="body">
    <TagFilters groups={libraryTags} current={slug} />

    <div class="rows">
      <LibraryList entries={entries} />
    </div>
  </div>
</Base>

<style>
  /* No tab row here, so the chips are the first thing under the masthead and
     they take the masthead's own gap rather than that plus the 0.9rem they sit
     under a tab row with. `TagFilters.astro` reads the property. */
  .body {
    --filters-gap: 0;

    margin-top: var(--gap-masthead);
  }

  /* The same 1.25rem /library and the kind pages put between their filter rows
     and their list. The row has to hold the same place on all four pages or it
     stops reading as one persistent control and starts reading as two that
     happen to match. */
  .rows {
    margin-top: 1.25rem;
  }
</style>
