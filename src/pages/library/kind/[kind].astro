---
/**
 * Every saved link of one kind. Reached from the tab row on /library.
 * Kinds with no entries never get a page.
 *
 * The tab row renders here too, identically, which is the whole point of it:
 * before, a reader who pressed `video` landed on a page whose only way onward
 * was the crumb, so the three kind routes were a one-way door. The crumb stays
 * anyway. It is not the same control as the `All` tab: §7's parity rule needs
 * the `BreadcrumbList` node's parent to be something a reader can see named,
 * and `All` is a scope, not a name.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import Base from "../../../layouts/Base.astro";
import KindTabs from "../../../components/KindTabs.astro";
import LibraryList from "../../../components/LibraryList.astro";
import type { Kind } from "../../../lib/library";
import { KIND_LABELS, kindGroups, library } from "../../../lib/library";
import { libraryRowUrl, listJsonLd } from "../../../lib/schema";

const STANDFIRST: Record<Kind, string> = {
  article: "Long enough to need a chair and a cup of something.",
  post: "Short things somebody put on a timeline, saved before they scrolled away.",
  video: "Talks and interviews. These want a block of time before they give anything back.",
};

export const getStaticPaths = (() =>
  kindGroups.map((group) => ({
    params: { kind: group.kind },
    props: group,
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { kind, entries } = Astro.props;
const heading = KIND_LABELS[kind];
const standfirst = STANDFIRST[kind];

/** Rows point where they go, same as /library, plus the crumb this page draws. */
const jsonLd = listJsonLd({
  name: heading,
  path: `/library/kind/${kind}`,
  parent: { name: "Library", path: "/library" },
  entries: entries.map((entry) => ({ name: entry.title, url: libraryRowUrl(entry) })),
});
---

<Base
  title={`${heading} · Library · Aayush Manchanda`}
  description={standfirst}
  jsonLd={jsonLd}
  wide
>
  <p class="crumb mono"><a href="/library">&larr; Library</a></p>

  <header>
    <h1 class="page-title">{heading}</h1>
    <p class="standfirst">{standfirst}</p>
  </header>

  <div class="body">
    <KindTabs groups={kindGroups} total={library.length} current={kind} />

    <div class="rows">
      <LibraryList entries={entries} />
    </div>
  </div>
</Base>

<style>
  .body {
    margin-top: var(--gap-masthead);
  }

  /* The same 1.25rem the index puts between its tab row and its list: the two
     pages have to hold the row in the same place or it stops reading as one
     persistent control and starts reading as two that happen to match. */
  .rows {
    margin-top: 1.25rem;
  }
</style>
