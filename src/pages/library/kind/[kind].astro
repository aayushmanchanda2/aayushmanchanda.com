---
/**
 * /library with one kind pre-selected (VET-258): the same shell as /library,
 * the list pane and `LibraryViews`, with this kind's view the one not hidden.
 * These routes stay canonical and are where the kind segments link, so a
 * modifier click or no scripting lands on the right view; with scripting a
 * press swaps the view in place instead. Kinds with no entries get no page.
 *
 * The layout is keyed on the route and not on the data: `/library/domain/x-com`
 * is all posts too, and it stays a list, because a page that changed shape
 * because of what was filed into it would be a page nobody could predict.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import Base from "../../../layouts/Base.astro";
import LibraryPane from "../../../components/LibraryPane.astro";
import LibraryViews from "../../../components/LibraryViews.astro";
import { KIND_BLURBS, KIND_LABELS, kindGroups, library } from "../../../lib/library";
import { libraryRowUrl, listJsonLd } from "../../../lib/schema";

export const getStaticPaths = (() =>
  kindGroups.map((group) => ({
    params: { kind: group.kind },
    props: group,
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { kind, entries } = Astro.props;
const heading = KIND_LABELS[kind];

/** Rows point where they go, same as /library, plus the crumb this page draws. */
const jsonLd = listJsonLd({
  name: heading,
  path: `/library/kind/${kind}`,
  parent: { name: "Library", path: "/library" },
  entries: entries.map((entry) => ({ name: entry.title, url: libraryRowUrl(entry) })),
});
---

<Base
  title={`${heading} · Library · Aayush Manchanda`}
  description={KIND_BLURBS[kind]}
  jsonLd={jsonLd}
  full
>
  <LibraryPane slot="pane" entries={library} start={kind} />
  <LibraryViews start={kind} />
</Base>
