---
/**
 * One saved link: what it is, what he has on it, and the way to it.
 *
 * **Every entry builds one, and that is a reversal.** The section's rule used
 * to be that a row's destination was the thing itself, and only a digested
 * entry earned a page — a page holding one line he wrote and a button to leave
 * would be a stop on the way to the thing rather than the thing. design.md §3
 * carries the argument and the reversal in one paragraph, and this is the
 * route it governs.
 *
 * What changed is the entry rather than the argument. A saved link now arrives
 * with tags on it, a saved post arrives with the whole post, and a saved video
 * arrives with a poster somebody can press. There is no stub left to refuse:
 * the thinnest page here is an article nobody has read yet, and it holds the
 * kind, the host, what it is about, the day it arrived, the one line he wrote
 * about it, and the source. That is a catalogue card, which is a real thing to
 * be, and every filter on it goes somewhere.
 *
 * The anatomy is still the /tools entry page, which is the save.design shape: a
 * strip of metadata whose values are filter links, whatever the entry actually
 * carries in the middle, and the source at the foot. The external link lives
 * down there because a reader decides first and leaves second.
 *
 * The middle is four optional blocks and they stack in the order a reader
 * wants them: the thing itself first when the site has it (the post's own
 * words, the video's poster), then the digest when somebody has read it, then
 * the draft when the pipeline has had a go and he has not, then his own `why`.
 * **The last two are deliberately different components.** `DraftBlock.astro`
 * is boxed, third person and loudly labelled; `VoiceBlocks.astro` is the same
 * component /tools and /sites render his sentences through. A drafted opinion
 * and one of his cannot end up in the same box by accident, because they are
 * not the same box.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import Base from "../../layouts/Base.astro";
import DigestBlocks from "../../components/DigestBlocks.astro";
import DraftBlock from "../../components/DraftBlock.astro";
import EntryLink from "../../components/EntryLink.astro";
import EntryNav from "../../components/EntryNav.astro";
import KindChip from "../../components/KindChip.astro";
import PostBody from "../../components/PostBody.astro";
import TagChips from "../../components/TagChips.astro";
import TweetCard from "../../components/TweetCard.astro";
import VideoFacade from "../../components/VideoFacade.astro";
import VoiceBlocks from "../../components/VoiceBlocks.astro";
import XEmbeds from "../../components/XEmbeds.astro";
import { linkLabel } from "../../lib/links";
import { library } from "../../lib/library";
import { routeSlug } from "../../lib/parse";
import { libraryJsonLd } from "../../lib/schema";

/**
 * Neighbours resolved at build time, the way /sites resolves its gallery. The
 * ring is `library` itself, which is the order the /library list renders, so
 * pressing → moves the way the eye moved down the page. It wraps, and it is
 * every entry now rather than the digested few: a keyboard walk that skipped
 * forty of forty-two pages would be a ring around a list nobody can see.
 */
export const getStaticPaths = (() =>
  library.map((entry, index) => {
    const step = (offset: number) => {
      const neighbour = library[(index + offset + library.length) % library.length];
      return neighbour === undefined || neighbour.slug === entry.slug
        ? null
        : { href: `/library/${neighbour.slug}`, title: neighbour.title };
    };

    return {
      params: { slug: entry.slug },
      props: { entry, prev: step(-1), next: step(1) },
    };
  })) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, prev, next } = Astro.props;

/**
 * A `Review` when there is a digest to review with, a `WebPage` when there is
 * not. The gate lives in `lib/schema.ts › libraryJsonLd` rather than here,
 * because which node a page emits is a structured-data decision and design.md
 * §7 keeps every one of those in that module.
 */
const jsonLd = libraryJsonLd(entry);

/*
 * The page's own description, in the order the page itself would answer the
 * question. His note is the standfirst and comes first; the verdict is the one
 * sentence a digested entry is guaranteed to have; his `why` is next. The
 * fallback is the plainest true sentence there is, and no entry needs it today.
 */
const description =
  entry.note ??
  entry.digest?.verdict ??
  entry.why ??
  `A ${entry.kind} I saved from ${entry.domain}.`;
---

<Base
  title={`${entry.title} · Library · Aayush Manchanda`}
  description={description}
  jsonLd={jsonLd}
>
  <p class="crumb mono"><a href="/library">&larr; Library</a></p>

  <header>
    <h1 class="page-title page-title--entry">{entry.title}</h1>

    {/*
      A `ul`, so the facts are separate items to anything reading the page out
      loud. The dots are separators drawn by CSS between the items, never
      characters in the content. Every value that can be a way back out into
      the collection is one — the save.design anatomy, same as /tools — and
      since VET-63 that includes the tags, which is what makes the thinnest
      page here a page with somewhere to go.

      The dates are the honest ones and there are up to three: `saved` is when
      the link came in, `digested` is the day the verdict below was last true,
      and `drafted` is the day the pipeline had its go. An opinion with an old
      date on it is a warning, which is the whole reason they are printed.

      The tags come last and take a line of their own (VET-223). In the middle
      of the row they wrapped as one block on a phone: the list indented under
      its own separator, which sat alone to the left of it, and the date after
      it started the next line with another. Last, they are one line of facts
      and then one row of subjects, at every width.
    */}
    <ul class="strip mono">
      <li class="strip__item">
        <a class="strip__chip" href={`/library/kind/${entry.kind}`}>
          <KindChip kind={entry.kind} />
        </a>
      </li>
      <li class="strip__item">
        <a href={`/library/domain/${routeSlug(entry.domain)}`}>{entry.domain}</a>
      </li>
      <li class="strip__item">
        Saved <span class="tabular-nums">{entry.saved_date}</span>
      </li>
      {
        entry.digest && (
          <li class="strip__item">
            Digested <span class="tabular-nums">{entry.digest.digested}</span>
          </li>
        )
      }
      {
        entry.draft && (
          <li class="strip__item">
            Drafted <span class="tabular-nums">{entry.draft.drafted}</span>
          </li>
        )
      }
      {
        entry.tags.length > 0 && (
          <li class="strip__item strip__item--tags">
            <TagChips tags={entry.tags} />
          </li>
        )
      }
    </ul>

    {/*
      Not on a post the pipeline could read: there the note is a copy of the
      post's words, which the embed below already shows (VET-221). A post it
      could not read keeps the note, because then it is the only text there is.
    */}
    {entry.note && !entry.post && <p class="standfirst">{entry.note}</p>}
  </header>

  {/*
    The thing itself, when the site has it. A post's own words in full, because
    the card that pointed here cut them at 700 characters; a video's poster,
    because pressing it is the whole point of having saved it. An article has
    neither and renders neither: there is nothing here to embed and a box
    saying so would be the stub this page exists not to be.

    A post is X's own embed first, the same one the posts wall shows, and the
    saved copy under it (VET-221). The embed is how the post looks anywhere it
    is pasted; the copy is the whole text from this repository, still here if
    the post is deleted or X does not answer. `XEmbeds` is gated on the same
    field because it is what puts X's host on the page, and
    `scripts/validate-schema.mjs` fails a page that carries it without a post.
  */}
  {entry.post && <TweetCard entry={{ ...entry, post: entry.post }} standalone />}
  {entry.post && <XEmbeds />}
  {entry.post && <PostBody entry={{ ...entry, post: entry.post }} />}
  {entry.video && <VideoFacade entry={{ ...entry, video: entry.video }} chrome={false} />}

  {entry.digest && <DigestBlocks digest={entry.digest} />}
  {entry.draft && <DraftBlock draft={entry.draft} />}

  {/*
    His own `why`, through the component /tools and /sites render his sentences
    with, under the label that list already fixes. Only the entry's top-level
    `why` reaches it: a drafted one is somebody else's agent talking and it goes
    in the box above, in the third person, where it is labelled as such.
  */}
  <VoiceBlocks why={entry.why} />

  {/*
    The way out, prominent by being the only full link on the page. At the
    foot rather than in the masthead because whatever is above is the decision
    and this is what the decision is about — a reader who got their answer
    leaves through here, and one who did not was never going to.
  */}
  <p class="source">
    <span class="source__label mono">Source</span>
    <EntryLink class="ext" href={entry.url}>{linkLabel(entry.url)}</EntryLink>
  </p>

  {/*
    The hint row is the keyboard legend and the links themselves — EntryNav
    owns the anatomy, the keys and the reasoning. This page only decides the
    ring: every entry, in list order, wrapping.
  */}
  <EntryNav
    label="Library entries"
    close={{ href: "/library", aria: "Close and go back to Library" }}
    prev={prev && { href: prev.href, aria: `Previous entry: ${prev.title}` }}
    next={next && { href: next.href, aria: `Next entry: ${next.title}` }}
  />
</Base>

<style>
  /* --- the metadata strip --------------------------------------------------
     The /tools strip, verbatim in its reasoning: between the title and the
     standfirst because the strip is what the title is, quiet furniture rather
     than prose, separators in the list item and never in a link's text. */

  /* **The row gap is 1.25rem and it is a hit area, not a rhythm.** The /tools
     strip this is otherwise copied from takes `gap: 0 0.7rem`, because nothing
     on it claims more room than it draws. This one carries chips that do: a tag
     reaches 0.375rem above and below its 28px box (`styles/chip.css ›
     .tag::after`) and the kind chip 0.62rem above and below its 20.3px one
     (`.strip__chip::after` below). With the lines welded together that
     overreach lands on whatever is on the line before it — measured at 375px
     before this gap existed, a tag's target covered the kind chip by 9.9px.
     design.md §4: adjacent targets may touch, never overlap. The kind chip's
     overreach is the larger, so it sets the number: 2 × 0.62rem.

     The column gap is 0.5rem, ui-skills' `gap-2`, and `.strip__item` takes the
     same so the separator dot stays centred. */
  .strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 0.5rem;
    /* title to meta strip is 16px, and so is strip to standfirst: §2's rhythm,
       8 within a group, 16 between groups, 40 between sections */
    margin-top: 1rem;
    color: var(--faint);
  }

  .strip + .standfirst {
    margin-top: 1rem;
  }

  .strip__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* The alt-text form, so the separator has no accessible name and a screen
     reader reads the facts rather than "middle dot" between each of them. It is
     what `layouts/Base.astro › .foot__meta` already uses and what design.md §6
     says a strip should join it in on touch. */
  .strip__item + .strip__item::before {
    content: "\00b7" / "";
    color: var(--hairline-strong);
  }

  /* The tag chips bring their own 0.75rem row gap, which is the hit-area
     arithmetic `TagChips.astro` explains and not a rhythm this row chose.

     A line to themselves, and no separator: a dot in front of a row that
     starts a line is the orphan this rule exists to remove. The strip's
     1.25rem row gap above them is the hit-area arithmetic again, the kind
     chip's 0.62rem reach plus the tag's 0.375rem, with room over. */
  .strip__item--tags {
    flex-basis: 100%;
  }

  .strip__item + .strip__item--tags::before {
    content: none;
  }

  /* Quiet by default and accent on hover — navigation furniture, deliberately
     outside the bold-and-underlined treatment prose links get in global.css.
     `:not(.strip__chip)` because the kind anchor is a box, not a word: an
     underline under a tinted chip would draw a second line across the row.
     `:not(.tag)` for the same reason one level along — a tag is an outlined
     box painted by `styles/chip.css`, and an underline would be a second
     line inside it. */
  .strip a:not(.strip__chip):not(.tag) {
    /* --muted, never the strip's --faint: a quiet anchor inside a metadata
       container states its own ink (design.md §4, the ink floor). */
    color: var(--muted);
    text-decoration-line: underline;
    text-decoration-color: var(--hairline-strong);
    text-underline-offset: 0.25em;
    transition-property: color, text-decoration-color;
    /* `--dur`, not the `--dur-fast` a list row takes. The one thing the
       thebridge reference transfers to this page whole: its hovers are 150 to
       300ms fades, long enough to read as a state settling rather than a light
       switching, and 220ms is the house token inside that band. A row in a list
       of forty wants the fast one — the pointer is crossing it, not resting on
       it — and a metadata strip on the page you have stopped on does not. */
    transition-duration: var(--dur);
    transition-timing-function: var(--ease);
  }

  .strip a:not(.strip__chip):not(.tag):hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  /* the chip does the talking; the anchor only carries the target */
  .strip__chip {
    position: relative;
    display: inline-flex;
    text-decoration: none;
    /* The same band as its neighbours above, which it was outside: the opacity
       step used to snap while the two links either side of it faded. */
    transition-property: opacity;
    transition-duration: var(--dur);
    transition-timing-function: var(--ease);
  }

  /* design.md §4's 40px floor, taken the way `chip.css › .tag::after` takes it:
     0.62rem of dead space above and below a 20.3px box, offsets rather than a
     centring transform so nothing rests on one and reduced motion has nothing
     to undo, and horizontal only so it cannot swallow the domain link beside
     it. §4's stated exception is for text — a word in a row of words — and this
     is a box, and the tags beside it on this line claim 40px too.

     The row gap above is what keeps the two hit boxes from meeting: 20px of gap
     against the 19.84px two of these overreach into it leaves them touching,
     with a sixth of a pixel to spare. Tight, and touching is the rule. */
  .strip__chip::after {
    content: "";
    position: absolute;
    inset: -0.62rem 0;
  }

  .strip__chip:hover {
    opacity: 0.75;
  }

  /* --- the source line ------------------------------------------------------ */

  .source {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    margin-top: 2.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--hairline);
    /* a URL has no spaces to break at, so it must be allowed to break anywhere */
    overflow-wrap: anywhere;
  }

  .source__label {
    color: var(--faint);
  }
</style>
