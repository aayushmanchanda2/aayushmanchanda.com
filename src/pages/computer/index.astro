---
/**
 * /computer: briOS's /computer index. The tips in their set order, each an
 * emoji tile, a title and the summary under it, drawn by `EntryList` so the
 * rows match "Read next" under a tip.
 */
import { getCollection } from "astro:content";

import Base from "../../layouts/Base.astro";
import EntryList from "../../components/EntryList.astro";
import { tipEntry } from "../../lib/entry-list";
import { listJsonLd, pageUrl } from "../../lib/schema";

const tips = (await getCollection("computer")).sort((a, b) => a.data.order - b.data.order);

const jsonLd = listJsonLd({
  name: "Computer",
  path: "/computer",
  entries: tips.map((tip) => ({
    name: tip.data.title,
    url: pageUrl(`/computer/${tip.id}`),
  })),
});
---

<Base
  title="Computer · Aayush Manchanda"
  description="Tips from Aayush Manchanda on how he works with his computer and the AI agents on it, each with the exact steps."
  jsonLd={jsonLd}
>
  <header>
    <h1 class="page-title">Computer</h1>
    <p class="standfirst">
      How I work with my computer and the agents on it. Each tip is one habit,
      the reason for it and the exact steps.
    </p>
  </header>

  <div class="tips">
    <EntryList entries={tips.map(tipEntry)} />
  </div>
</Base>

<style>
  .tips {
    margin-top: var(--gap-masthead);
  }
</style>
