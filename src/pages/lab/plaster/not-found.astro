---
/**
 * Prototype: the 404 with plaster art under the masthead. A copy of
 * `pages/404.astro` plus one line, so the real page stays untouched.
 */
import Plaster from "../../../components/lab/Plaster.astro";
import { labJsonLd } from "../../../components/lab/lab-schema";
import Base from "../../../layouts/Base.astro";
import { getSections } from "../../../lib/sections";

const sections = await getSections();
---

<Base
  jsonLd={labJsonLd("/lab/plaster/not-found", "Prototype: 404")}
  title="Prototype: 404 · Aayush Manchanda"
  description="That page doesn't exist. Links to everything on the site."
  noindex
>
  <header>
    {/*
      The mono masthead, the same call /notes makes: this is a terse statement
      rather than a section name, and a 404 in the mono voice reads as the
      machine answering plainly instead of the site shouting.
    */}
    <h1 class="page-title page-title--mono">Nothing here.</h1>
    <p class="standfirst">
      This URL doesn&rsquo;t exist. Everything the site has is below, and{" "}
      <a href="/">the front page</a> hasn&rsquo;t moved.
    </p>
  </header>

  <Plaster scene="lost" />

  <nav class="ways" aria-labelledby="ways-heading">
    <h2 class="ways__title mono" id="ways-heading">What&rsquo;s here</h2>

    <ul class="ways__list">
      {
        sections.map((section) => (
          <li>
            <a class="row press" href={section.href}>
              <span class="row__name">{section.name}</span>
              <span class="row__count mono tabular-nums">{section.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <p class="agents mono">
    Agents can start at <a href="/llms.txt">/llms.txt</a>. Every URL is in{" "}
    <a href="/sitemap-index.xml">/sitemap-index.xml</a>.
  </p>
</Base>

<style>
  /* The picture already separates the masthead from the list. */
  .ways {
    margin-top: 1.5rem;
  }

  .ways__title {
    color: var(--text-tertiary);
  }

  .ways__list {
    margin-top: 1.25rem;
    border-top: 1px solid var(--hairline);
  }

  .row {
    /* a full-width row shrinking by 4% reads as a glitch, not a press */
    --press-scale: 0.995;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: clamp(0.75rem, 1.8vw, 0.9rem);
    border-bottom: 1px solid var(--hairline);
    text-decoration: none;
    color: inherit;
  }

  .row:hover {
    border-bottom-color: var(--hairline-strong);
  }

  .row__name {
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition-property: color;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease);
  }

  .row:hover .row__name {
    color: var(--accent);
  }

  .row__count {
    color: var(--text-tertiary);
  }

  .agents {
    margin-top: clamp(2rem, 6vh, 3rem);
    /* --text-secondary, not --text-tertiary: half this sentence is links (design.md §4, the
       ink floor). */
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .agents a {
    color: inherit;
    text-decoration-color: var(--hairline-strong);
  }

  .agents a:hover {
    color: var(--accent);
  }
</style>
