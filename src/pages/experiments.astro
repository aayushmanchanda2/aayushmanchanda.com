---
/**
 * /experiments — what is running, and what stopped.
 *
 * VET-280's pass: its own raspberry mat and a postmark (`Stamp.astro`), a
 * tally of all four statuses under the standfirst (a zero is a fact: nothing
 * killed yet), and rows at an entry's grain, not a table's: an 18px name and
 * his line at 16px, since each one is a sentence to read. A killed row keeps
 * its place and drops its name to tertiary ink.
 */
import Mark from "../components/Mark.astro";
import Base from "../layouts/Base.astro";
import EntryLink from "../components/EntryLink.astro";
import StatusChip from "../components/StatusChip.astro";
import { STATUSES, experiments } from "../lib/experiments";
import { anchorUrl, listJsonLd } from "../lib/schema";
import { formatDay } from "../lib/date";

/**
 * Rows point at themselves.
 *
 * An experiment has no details page, and its `links` may be empty, so the only
 * address it reliably has is the `id` on its own row — the same anchor the
 * command palette sends someone to. Pointing the list at `links[0]` instead
 * would send half of them nowhere and the rest somewhere they were not asked
 * about.
 */
const tally = STATUSES.map((status) => ({
  status,
  count: experiments.filter((experiment) => experiment.status === status).length,
}));

const jsonLd = listJsonLd({
  name: "Experiments",
  path: "/experiments",
  entries: experiments.map((experiment) => ({
    name: experiment.name,
    url: anchorUrl("/experiments", experiment.slug),
  })),
});
---

<Base
  title="Experiments · Aayush Manchanda"
  description="What Aayush Manchanda is running right now, with a status and start date on each. Killed ones stay listed."
  jsonLd={jsonLd}
>
  <header>
    <h1 class="page-title"><Mark color="ink" variant={3} stroke={1.5}>Experiments</Mark></h1>
    <p class="standfirst">
      What&rsquo;s running right now, and what I stopped. Killed ones stay
      listed.
    </p>
  </header>

  <ul class="tally" aria-label="Experiments by status">
    {
      tally.map(({ status, count }) => (
        <li class="tally__item" data-empty={count === 0 || undefined}>
          <StatusChip status={status} muted={count === 0} />
          <span class="tally__count mono">{count}</span>
        </li>
      ))
    }
  </ul>

  <ul class="list">
    {
      experiments.map((experiment) => (
        /*
         * The slug as an id, so the command palette has somewhere to send
         * someone who searched for an experiment. Same reasoning as the
         * /library rows, and more forced here: an experiment's `links` may be
         * empty, so for some of these there is no other destination at all.
         */
        <li class="row" id={experiment.slug} data-status={experiment.status}>
          <span class="row__name">
            {experiment.name}
            <StatusChip status={experiment.status} />
          </span>

          <span class="row__date mono">
            Since <time datetime={experiment.started}>{formatDay(experiment.started)}</time>
          </span>

          <p class="row__note">{experiment.one_liner}</p>

          {experiment.links.length > 0 && (
            <ul class="row__links mono">
              {experiment.links.map((link) => (
                <li>
                  <EntryLink class="row__link" href={link} />
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .tally {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: var(--gap-masthead);
  }

  .tally__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tally__count {
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  /* A status nobody is in yet: the word stays gray, the zero quieter. */
  .tally__item[data-empty] .tally__count {
    color: var(--text-tertiary);
  }

  .list {
    margin-top: 1rem;
    border-top: 1px solid var(--hairline);
  }

  .row {
    /* Arriving from /experiments#slug, the row should not sit flush against
       the top edge of the window. */
    scroll-margin-block: 5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "name  meta"
      "note  meta"
      "links meta";
    column-gap: 1rem;
    /* 8px inside a row, 16px either side of the rule between rows: design.md
       §2's rhythm */
    row-gap: 0.5rem;
    align-items: start;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--hairline);
  }

  .row:hover {
    border-bottom-color: var(--hairline-strong);
  }

  .row__name {
    grid-area: name;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.4;
    text-wrap: balance;
  }

  .row[data-status="killed"] .row__name {
    color: var(--text-tertiary);
  }

  .row__note {
    grid-area: note;
    max-width: 38rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .row__date {
    grid-area: meta;
    color: var(--text-tertiary);
    white-space: nowrap;
    text-align: right;
    /* optical: line the date up with the 18px name, not the row box */
    padding-top: 0.3rem;
  }

  .row__links {
    grid-area: links;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  /* The anchor itself comes from `EntryLink`, and Astro's scoping stops at a
     component boundary — the cid this page stamps on its own elements never
     reaches a child's. `:global()` under an ancestor that does carry the cid is
     the way through: the rule still cannot escape this page.

     Carries its own underline: on touch there is no hover to reveal one.
     --text-secondary, not the date's --text-tertiary: these are controls (design.md §4, the
     ink floor). */
  .row__links :global(.row__link) {
    color: var(--text-secondary);
    text-decoration-line: underline;
    text-decoration-color: var(--hairline-strong);
  }

  .row:hover :global(.row__link) {
    color: var(--accent);
  }

  .row__links :global(.row__link:hover) {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  @media (max-width: 639px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "name"
        "note"
        "meta"
        "links";
      row-gap: 0.5rem;
    }

    .row__date {
      text-align: left;
      padding-top: 0;
    }
  }
</style>
