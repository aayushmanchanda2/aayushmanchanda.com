---
/**
 * /experiments — what is running, and what stopped.
 *
 * The /tools row anatomy, minus the favicon: an experiment is not a product
 * with a homepage, so there is nothing to fetch a mark for. Everything else
 * matches, down to the chip and the dated metadata column, because a reader
 * moving between the two sections should not have to relearn the page.
 */
import Base from "../layouts/Base.astro";
import EntryLink from "../components/EntryLink.astro";
import StatusChip from "../components/StatusChip.astro";
import { experiments } from "../lib/experiments";
---

<Base
  title="Experiments · Aayush Manchanda"
  description="What Aayush Manchanda is running right now, with a status and a start date on each one. The dead ones stay listed."
>
  <header>
    <h1 class="page-title">Experiments</h1>
    <p class="standfirst">
      Things I am running right now, and the ones I stopped. Killed experiments
      stay on the page, because deleting them would make me look better than I
      am.
    </p>
  </header>

  <ul class="list">
    {
      experiments.map((experiment) => (
        <li class="row">
          <span class="row__name">
            {experiment.name}
            <StatusChip status={experiment.status} />
          </span>

          <span class="row__date mono tabular-nums">
            since {experiment.started}
          </span>

          <p class="row__note">{experiment.one_liner}</p>

          {experiment.links.length > 0 && (
            <ul class="row__links mono">
              {experiment.links.map((link) => (
                <li>
                  <EntryLink class="row__link" href={link} />
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .list {
    margin-top: clamp(3.5rem, 12vh, 6rem);
    border-top: 1px solid var(--hairline);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "name  meta"
      "note  meta"
      "links meta";
    column-gap: 1rem;
    row-gap: 0.3rem;
    align-items: start;
    padding-block: clamp(1rem, 2.2vw, 1.25rem);
    border-bottom: 1px solid var(--hairline);
    transition-property: border-color;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease);
  }

  .row:hover {
    border-bottom-color: var(--hairline-strong);
  }

  .row__name {
    grid-area: name;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.65rem;
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .row__note {
    grid-area: note;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .row__date {
    grid-area: meta;
    color: var(--faint);
    white-space: nowrap;
    text-align: right;
    /* optical: line the date up with the name, not the row box */
    padding-top: 0.2rem;
  }

  .row__links {
    grid-area: links;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin-top: 0.35rem;
    text-transform: none;
    letter-spacing: 0;
  }

  /* The anchor itself comes from `EntryLink`, and Astro's scoping stops at a
     component boundary — the cid this page stamps on its own elements never
     reaches a child's. `:global()` under an ancestor that does carry the cid is
     the way through: the rule still cannot escape this page.

     Carries its own underline: on touch there is no hover to reveal one. */
  .row__links :global(.row__link) {
    color: var(--faint);
    text-decoration-line: underline;
    text-decoration-color: var(--hairline-strong);
  }

  .row:hover :global(.row__link) {
    color: var(--accent);
  }

  .row__links :global(.row__link:hover) {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  @media (max-width: 639px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "name"
        "note"
        "meta"
        "links";
      row-gap: 0.45rem;
    }

    .row__date {
      text-align: left;
      padding-top: 0;
    }
  }
</style>
