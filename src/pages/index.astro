---
import Avatar from "../components/Avatar.astro";
import Doodle from "../components/Doodle.astro";
import EntryList from "../components/EntryList.astro";
import Mark from "../components/Mark.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import Base from "../layouts/Base.astro";
import { feedItems } from "../lib/feeds";
import { newestFirst } from "../lib/rss";
import { homeJsonLd } from "../lib/schema";
import { getSections } from "../lib/sections";

// Sections with no entries do not come back, so the index never offers a row
// that leads to an empty page.
const sections = await getSections();

/** The five newest entries across the sections that have feeds. */
const latest = newestFirst(await feedItems(), 5);

/**
 * Who this site is about, in a form a machine can resolve.
 *
 * `Person` rather than `Organization`: this is one person's log, not a company
 * site, and claiming otherwise would be a lie that happens to score well. The
 * node itself, and the `WebSite` that names him as its author, are built in
 * `lib/schema.ts`, which is the only place on the site that writes JSON-LD.
 */
const jsonLd = homeJsonLd();
---

<Base jsonLd={jsonLd}>
  <header class="hero">
    <Avatar size={56} class="hero__avatar" />
    <h1 class="page-title">Hey, I&rsquo;m Aayush.</h1>
    <p class="standfirst hero__intro">
      I co-founded Orbis, run Vetted, and build things with AI from Canada.
    </p>
    <p class="standfirst hero__purpose">
      There&rsquo;s a lot of noise in AI. I test it on my own companies and my
      clients, and <Mark variant={2}>what survives</Mark> shows up here with a
      date on it.
    </p>
  </header>

  <section class="index" aria-labelledby="index-heading">
    <h2 class="index__title mono" id="index-heading">
      The mindscape<Doodle class="index__arrow" shape="arrow-curve" variant={2} color="blue" stroke={1.5} draw />
    </h2>

    <ul class="index__list">
      {
        sections.map((section, i) => (
          <li>
            <a class="row press" href={section.href}>
              <span class="row__num mono tabular-nums">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="row__body">
                <span class="row__name">{section.name}</span>
                <span class="row__blurb">{section.blurb}</span>
              </span>
              <svg
                class="row__arrow"
                viewBox="0 0 16 16"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M2.5 8h11M9 3.5 13.5 8 9 12.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.25"
                />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    latest.length > 0 && (
      <section class="latest" aria-labelledby="latest-heading">
        <h2 class="accent-bar" id="latest-heading">Latest</h2>
        <EntryList
          entries={latest.map((item) => ({
            title: item.title,
            href: item.path,
            meta: { label: item.section, date: item.date },
          }))}
        />
        <p class="latest__feed">
          <a href="/rss.xml">Follow it all by RSS</a>
        </p>
      </section>
    )
  }

  {/*
    Renders nothing until `NEWSLETTER_ACTION` in `lib/site.ts` is set, which is
    why it is placed unconditionally: the component owns the switch, so turning
    the newsletter on is that one line and nothing here. Below the index on
    purpose: it is the last thing on the page.
  */}
  <NewsletterSignup />
</Base>

<style>
  /* --- hero --------------------------------------------------------------- */

  /* The masthead and its standfirst are `.page-title` and `.standfirst` from
     global.css, the same pair every section page uses. The home page had its
     own copy of both declaration for declaration, which is a duplicate that
     reads as a decision — and would have quietly drifted the day one of them
     was retuned.

     One real difference survives: the intro sits a step further from the title
     than a section standfirst does, because the title above it is a sentence
     rather than a single word, and the tighter gap crowded it. */
  .hero__avatar {
    margin-bottom: 1.25rem;
  }

  .hero__intro {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  /* Identity and purpose are two sentences of the same voice, so the break
     between them is a paragraph break, not the title-to-standfirst gap the
     `.standfirst` default would give it. At the default they read as two
     unrelated standfirsts stacked up. */
  .hero__purpose {
    margin-top: 0.9rem;
  }

  /* --- section index ------------------------------------------------------ */

  .index {
    margin-top: clamp(5rem, 16vh, 9rem);
  }

  .index__title {
    color: var(--text-tertiary);
  }

  /* A pen arrow off the heading's last letter, curling down to the first
     row. It ends in the list's top margin, above the first name. */
  .index__arrow {
    /* inline, so its static position is after the text, not under it */
    display: inline;
    position: absolute;
    width: 26px;
    height: 26px;
    margin: 0.35em 0 0 0.4em;
  }

  .index__list {
    margin-top: 1.25rem;
    border-top: 1px solid var(--hairline);
  }

  .row {
    /* a full-width row shrinking by 4% reads as a glitch, not a press */
    --press-scale: 0.995;
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: baseline;
    gap: 0 1rem;
    padding-block: clamp(1.1rem, 2.5vw, 1.5rem);
    border-bottom: 1px solid var(--hairline);
    text-decoration: none;
    color: inherit;
  }

  .row:hover {
    border-bottom-color: var(--hairline-strong);
  }

  /* Hover ink is instant (design.md §4); only the arrow moves. */
  .row__num {
    color: var(--text-tertiary);
  }

  .row:hover .row__num {
    color: var(--accent);
  }

  .row__body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .row__name {
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .row:hover .row__name {
    color: var(--accent);
  }

  .row__blurb {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .row__arrow {
    width: 16px;
    height: 16px;
    align-self: center;
    color: var(--text-tertiary);
    transition-property: transform, color;
    transition-duration: var(--dur);
    transition-timing-function: var(--ease-out);
  }

  .row:hover .row__arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  @media (max-width: 599px) {
    .row {
      grid-template-columns: 2rem 1fr auto;
    }
  }

  /* --- latest ------------------------------------------------------------- */

  .latest {
    margin-top: clamp(3.5rem, 10vh, 5rem);
  }

  .latest__feed {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--text-tertiary);
  }

</style>
