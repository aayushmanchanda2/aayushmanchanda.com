---
/**
 * /library — what I read and watch, saved as it comes.
 *
 * A notes-style shell since VET-258: the list pane on the left (its toolbar
 * filters by kind and tag) and a main area whose layout follows the kind.
 * `LibraryViews.astro` holds the four views and why each looks the way it
 * does. This route shows All; `/library/kind/<kind>` is the same shell with
 * that kind pre-selected, and a segment press swaps in place to `?kind=`.
 */
import Base from "../layouts/Base.astro";
import LibraryPane from "../components/LibraryPane.astro";
import LibraryViews from "../components/LibraryViews.astro";
import { library } from "../lib/library";
import { libraryRowUrl, listJsonLd } from "../lib/schema";

/**
 * Each row's URL is wherever that row's title goes, which is its own page for
 * every entry. An `ItemList` names the things on a page, and the thing on a
 * row is the entry rather than the link out of it.
 */
const jsonLd = listJsonLd({
  name: "Library",
  path: "/library",
  entries: library.map((entry) => ({ name: entry.title, url: libraryRowUrl(entry) })),
});
---

<Base
  title="Library · Aayush Manchanda"
  description="Articles, posts and videos Aayush Manchanda saved to read or watch properly, with the date he saved each one."
  jsonLd={jsonLd}
  full
>
  <LibraryPane slot="pane" entries={library} start="" />
  <LibraryViews start="" />
</Base>
