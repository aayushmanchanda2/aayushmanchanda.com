---
/**
 * /library — what I read and watch, saved as it comes.
 *
 * The tab row above the list is doing more work here than the equivalent would
 * on /tools. /tools reaches its category and verdict pages from every tool's
 * own details page; here only the digested entries have one, so without this
 * row the three `/library/kind/<kind>` routes would sit in the sitemap all but
 * unreachable by anyone using the site with their eyes. The domain routes are
 * already reachable from the mono hostname on every row.
 *
 * The row is `KindTabs`, and it is the same component, in the same slot, on
 * this page and on all three kind pages. See the note in that file for why it
 * is a tab row and not the chip bar it replaced.
 */
import Base from "../layouts/Base.astro";
import KindTabs from "../components/KindTabs.astro";
import LibraryList from "../components/LibraryList.astro";
import { kindGroups, library } from "../lib/library";
import { libraryRowUrl, listJsonLd } from "../lib/schema";

/**
 * Each row's URL is wherever that row actually goes: off-site for an
 * undigested entry, its own `/library/<slug>` page for a digested one. The
 * graph follows the markup rather than either rule — minting a local URL for a
 * row that leaves, or an off-site one for a row that stays, would describe a
 * list this page does not render.
 */
const jsonLd = listJsonLd({
  name: "Library",
  path: "/library",
  entries: library.map((entry) => ({ name: entry.title, url: libraryRowUrl(entry) })),
});
---

<Base
  title="Library · Aayush Manchanda"
  description="Articles, posts and videos Aayush Manchanda saved to read or watch properly, with the date he saved each one."
  jsonLd={jsonLd}
>
  <header>
    <h1 class="page-title">Library</h1>
    <p class="standfirst">
      Things I saved to read or watch properly. Saved is not read, and neither
      is a recommendation. Most rows go straight to the source; the ones I have
      digested get a page first, with the cliff notes and an honest call on
      whether it is worth your time.
    </p>
  </header>

  <div class="body">
    <KindTabs groups={kindGroups} total={library.length} current={null} />

    <div class="rows">
      <LibraryList entries={library} />
    </div>
  </div>
</Base>

<style>
  .body {
    margin-top: var(--gap-masthead);
  }

  /* Closer to the tabs than the tabs are to the standfirst: the row belongs to
     the list under it, not to the header above it. */
  .rows {
    margin-top: 1.25rem;
  }
</style>
