---
/**
 * /library — what I read and watch, saved as it comes.
 *
 * The tab row above the list is `KindTabs`, the same component in the same slot
 * on this page and on all three kind pages. See the note in that file for why
 * it is a tab row and not the chip bar it replaced.
 *
 * It was carrying more weight than that when it shipped: only digested entries
 * had a page, so the three `/library/kind/<kind>` routes had no other entrance
 * anyone using the site with their eyes could find. Every entry has a page now
 * and every page names its kind, its host and its tags, so all three filter
 * routes are reachable from any row in two presses. The row keeps its own
 * hostname link anyway, because two presses is not the same offer as one.
 *
 * `TagFilters` is the second row under it and the newer answer to the same
 * question one axis over: the tag routes were reachable only from a row that
 * happened to be about the right subject, so the vocabulary was invisible until
 * you had already found something in it.
 */
import Base from "../layouts/Base.astro";
import KindTabs from "../components/KindTabs.astro";
import LibraryList from "../components/LibraryList.astro";
import TagFilters from "../components/TagFilters.astro";
import { kindGroups, library, libraryTags } from "../lib/library";
import { libraryRowUrl, listJsonLd } from "../lib/schema";

/**
 * Each row's URL is wherever that row's title goes, which is its own page for
 * every entry. The `source` link beside it is not in the graph and should not
 * be: an `ItemList` names the things on a page, and the thing on this row is
 * the entry rather than the second door out of it.
 */
const jsonLd = listJsonLd({
  name: "Library",
  path: "/library",
  entries: library.map((entry) => ({ name: entry.title, url: libraryRowUrl(entry) })),
});
---

<Base
  title="Library · Aayush Manchanda"
  description="Articles, posts and videos Aayush Manchanda saved to read or watch properly, with the date he saved each one."
  jsonLd={jsonLd}
  wide
>
  <header>
    <h1 class="page-title">Library</h1>
    <p class="standfirst">
      Things I saved to read or watch properly. Saved is not read, and neither
      is a recommendation. Every row has a page now, and the ones I have read
      carry cliff notes and an honest call on whether it is worth your time.
    </p>
  </header>

  <div class="body">
    <KindTabs groups={kindGroups} total={library.length} current={null} />
    <TagFilters groups={libraryTags} current={null} />

    <div class="rows">
      <LibraryList entries={library} />
    </div>
  </div>
</Base>

<style>
  .body {
    margin-top: var(--gap-masthead);
  }

  /* Closer to the tabs than the tabs are to the standfirst: the row belongs to
     the list under it, not to the header above it. */
  .rows {
    margin-top: 1.25rem;
  }
</style>
