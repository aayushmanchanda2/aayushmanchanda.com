---
/**
 * /reading — links saved to read properly.
 *
 * The filter bar above the list is doing more work here than the equivalent
 * would on /tools. /tools reaches its category and verdict pages from a tool's
 * own details page; /reading has no details pages, so without this bar the
 * three `/reading/kind/<kind>` routes would exist, sit in the sitemap, and be
 * unreachable by anyone using the site with their eyes. The domain routes are
 * already reachable from the mono hostname on every row.
 */
import Base from "../layouts/Base.astro";
import KindChip from "../components/KindChip.astro";
import ReadingList from "../components/ReadingList.astro";
import { kindGroups, reading } from "../lib/reading";
import { listJsonLd } from "../lib/schema";

/**
 * The only list on the site whose rows point off-site, because that is what the
 * rows do: /reading has no details pages, and every visible row goes straight
 * to the source. Minting a local URL per entry for the graph would describe a
 * section that does not exist.
 */
const jsonLd = listJsonLd({
  name: "Reading",
  path: "/reading",
  entries: reading.map((entry) => ({ name: entry.title, url: entry.url })),
});
---

<Base
  title="Reading · Aayush Manchanda"
  description="Articles, posts and talks Aayush Manchanda saved to read properly, with the date he saved each one."
  jsonLd={jsonLd}
>
  <header>
    <h1 class="page-title">Reading</h1>
    <p class="standfirst">
      Links I saved to read properly. Saving one is not the same as having read
      it, and neither one is a recommendation. Every row goes straight to the
      source.
    </p>
  </header>

  <div class="body">
    <nav class="filters" aria-label="Filter reading by kind">
      {
        kindGroups.map((group) => (
          <KindChip
            kind={group.kind}
            href={`/reading/kind/${group.kind}`}
            count={group.entries.length}
          />
        ))
      }
    </nav>

    <div class="rows">
      <ReadingList entries={reading} />
    </div>
  </div>
</Base>

<style>
  .body {
    margin-top: clamp(3.5rem, 12vh, 6rem);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Closer to the filters than the filters are to the standfirst: the bar
     belongs to the list under it, not to the header above it. */
  .rows {
    margin-top: 1.25rem;
  }
</style>
