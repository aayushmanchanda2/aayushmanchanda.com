---
/**
 * Dev-only harness for /me (VET-274), injected by `astro.config.mjs` under
 * `astro dev` and never built: renders each /me state from synthetic rows
 * (`fixtures/private.ts`), since nobody but Aayush can sign in as Aayush.
 *   /me/fixture/entry  /me/fixture/post  /me/fixture/video  /me/fixture/index
 *   /me/fixture/sign-in  /me/fixture/unconfigured  /me/fixture/not-found
 */
import MeGate from "../components/MeGate.astro";
import PrivateEntry from "../components/PrivateEntry.astro";
import PrivateIndex from "../components/PrivateIndex.astro";
import { toEntries, toEntry, whyOf } from "../lib/private";
import { FIXTURE_ROWS } from "./private";

export const prerender = false;

const view = Astro.params.view;
const rows = toEntries(FIXTURE_ROWS);
const one = FIXTURE_ROWS[["entry", "post", "video"].indexOf(view ?? "")];
---

{one && <PrivateEntry entry={toEntry(one)} rows={rows} why={whyOf(one)} />}
{view === "index" && <PrivateIndex rows={rows} />}
{view === "sign-in" && <MeGate state="sign-in" />}
{view === "unconfigured" && <MeGate state="unconfigured" />}
{view === "not-found" && <MeGate state="not-found" />}
