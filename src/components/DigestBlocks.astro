---
/**
 * DigestBlocks — a library entry's digest, as `.fact` rows of the "Written by
 * AI" box (`EntrySection.astro`, VET-279); the caller supplies the `dl`.
 *
 * The same visual voice as `VoiceBlocks`, and deliberately not the same
 * component: `VoiceBlocks` renders optional single-paragraph fields and its
 * `Props` must stay exactly `Voice`, while a digest is all-or-nothing — the
 * parser refuses a partial one — and its first block is a list, not a
 * paragraph. Bolting a list into `VoiceBlocks` would put an "everything is
 * optional prose" contract and an "all four fields, one of them plural"
 * contract in one file, and the two would fight.
 *
 * The order is the order the reading happens in: what the piece says, then
 * whether to read it, then why. The verdict before the why, because the whole
 * point of a digest is the call — a reader who trusts it never needs the
 * paragraph after it.
 *
 * The labels come from `lib/markdown.ts › DIGEST_LABELS`, the same list
 * `/library.md` prints, for the reason `VoiceBlocks` imports `VOICE_FIELDS`:
 * two renderings of one thing, and the first to disagree is the one nobody
 * reads with their own eyes. `lib/digest.test.mjs` holds this file to it.
 */
import { DIGEST_LABELS } from "../lib/markdown";
import type { Digest } from "../lib/library";

interface Props {
  digest: Digest;
}

const { digest } = Astro.props;
---

<div class="fact">
  <dt>{DIGEST_LABELS.bullets}</dt>
  <dd>
    <ul class="digest__bullets">
      {digest.bullets.map((bullet) => <li class="digest__bullet">{bullet}</li>)}
    </ul>
  </dd>
</div>
<div class="fact">
  <dt>{DIGEST_LABELS.verdict}</dt>
  <dd class="digest__verdict">{digest.verdict}</dd>
</div>
<div class="fact">
  <dt>{DIGEST_LABELS.why}</dt>
  <dd>{digest.why}</dd>
</div>

<style>
  /* The verdict is the call, so it reads at full ink. */
  .digest__verdict {
    color: var(--text-primary);
  }

  /* A real list, marked as one: these are claims from the piece. */
  .digest__bullets {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-left: 1.1rem;
    list-style: disc;
  }

  .digest__bullet::marker {
    color: var(--text-tertiary);
  }
</style>
