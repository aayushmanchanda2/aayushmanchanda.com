---
/**
 * ToolGrid — /tools as an iOS home screen: a 60px squircle and the name under
 * it, each tile one link to the tool's own page.
 *
 * A second markup beside `ToolList.astro`'s table, not the table restyled: a
 * tile has none of a row's cells, and `display` games on table elements cost
 * the table its semantics in Safari. `html[data-tools-view="grid"]` swaps which
 * one shows (`lib/view-toggle.ts`). The tiles carry the same data attributes as
 * the rows, so the filters hide both and a sort orders both.
 *
 * Ruled in `--hairline` (VET-257). Every line has one owner, because two .09
 * lines over each other read as one .17 line: a tile draws its right and bottom
 * edges, the list draws the left, and the first visible row draws the top
 * (`:nth-child(-n + cols of :not([hidden]))`, so a filter still gets its roof).
 * A short last row ends in a step, with no lines round empty cells.
 *
 * VET-253 makes it a home screen: the Dock pinned at the bottom (`Dock.astro`),
 * jiggle mode, and the app-open zoom (`lib/home-screen.ts`). The wallpaper is
 * the tools green at 7%, under the lines, so the rules stay the only marks.
 */
import AppIcon from "./AppIcon.astro";
import Dock from "./Dock.astro";
import PreviewCard from "./PreviewCard.astro";
import type { Tool } from "../lib/tools";
import { toolAttributes } from "./tool-attributes";
import { dockTools } from "../lib/home-screen";

interface Props {
  tools: Tool[];
}

const { tools } = Astro.props;

/* "emilkowalski/skills" is one word to the line breaker and wider than a phone
   cell, so it may also break after a slash or a dot, and nowhere else. */
const breakable = (name: string) => name.split(/(?<=[/.])(?=.)/);
---

<div class="home" data-home>
  <p class="visually-hidden" aria-live="polite" data-jiggle-live></p>
  <button class="home__done glass" type="button" data-jiggle-done hidden>Done</button>
  <ul class="tiles" data-tool-rows>
    {
      tools.map((tool) => (
        <li class="tile" {...toolAttributes(tool)}>
          <a class="tile__link" href={`/tools/${tool.slug}`} data-astro-prefetch="hover">
            <AppIcon tool={tool} size={60} />
            <span class="tile__name" title={tool.description ? `${tool.name}: ${tool.description}` : tool.name}>
              {breakable(tool.name).map((part, i) => (<>{i > 0 && <wbr />}{part}</>))}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <div class="home__shelf">
    <p class="home__hint glass" data-jiggle-hint hidden>Long-press an icon</p>
    <Dock tools={dockTools(tools)} />
  </div>
</div>

<PreviewCard />

<script>
  import { initHomeScreen } from "../lib/home-screen";

  initHomeScreen();
</script>

<style>
  /* The cross-document zoom into a tool's page rides the site-wide
     `@view-transition` (`styles/global.css`); `lib/home-screen.ts` skips
     every navigation off /tools but an icon's. */
  .home {
    display: none;
    container-type: inline-size;
    margin-top: 1rem;
    /* A Dock name near the edge would widen the page on a phone. */
    overflow-x: clip;
  }

  :global(html[data-tools-view="grid"]) .home {
    display: block;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-left: 1px solid var(--hairline);
    background: radial-gradient(100% 70% at 50% 0%, var(--wallpaper), transparent);
  }

  .tile {
    border-right: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .tile[hidden] {
    display: none;
  }

  /* The roof, one breakpoint per column count. Each wider rule is a superset
     of the one before, so they stack without resetting. */
  .tile:nth-child(-n + 3 of :not([hidden])) {
    border-top: 1px solid var(--hairline);
  }

  @media (min-width: 600px) {
    .tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .tile:nth-child(-n + 4 of :not([hidden])) { border-top: 1px solid var(--hairline); }
  }

  @media (min-width: 768px) {
    .tiles { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .tile:nth-child(-n + 6 of :not([hidden])) { border-top: 1px solid var(--hairline); }
  }

  @media (min-width: 1024px) {
    .tiles { grid-template-columns: repeat(8, minmax(0, 1fr)); }
    .tile:nth-child(-n + 8 of :not([hidden])) { border-top: 1px solid var(--hairline); }
  }

  @media (min-width: 1440px) {
    .tiles { grid-template-columns: repeat(10, minmax(0, 1fr)); }
    .tile:nth-child(-n + 10 of :not([hidden])) { border-top: 1px solid var(--hairline); }
  }

  /* The link fills the cell inside its lines, so the hover fill and the focus
     ring stop at the rule. */
  .tile__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    height: 100%;
    padding: 1.25rem 0.5rem;
    color: var(--text-primary);
    text-decoration: none;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .tile__link:hover {
    background: var(--surface-2);
  }

  .tile__link:focus-visible {
    outline-offset: -2px;
  }

  /* Two lines, centred, the springboard label, broken only between words (or
     at the `<wbr>` above), never inside one. A name longer than two lines stops
     at an ellipsis, and `title` carries it whole. The full name is also the h1 of the page the tile opens. */
  .tile__name {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    max-width: 100%;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  /* --- the home screen (VET-253) ----------------------------------------- */

  /* Pinned inside the keyline, over the grid while it scrolls, at rest under
     its last row. Click-through round the Dock, so the tiles beside it work. */
  .home__shelf {
    position: sticky;
    bottom: calc(var(--frame-in) + 0.75rem);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    pointer-events: none;
  }

  .home__hint {
    padding: 0.125rem 0.625rem;
    color: var(--text-secondary);
    font-size: 0.75rem;
  }

  .home__hint[hidden],
  .home__done[hidden] {
    display: none;
  }

  /* iOS's Done: top right of the screen, under the bar, while jiggling. */
  .home__done {
    position: fixed;
    top: calc(var(--frame) + var(--bar-h) + 0.75rem);
    right: calc(var(--frame) + var(--keyline) + 0.75rem);
    z-index: 30;
    min-height: 2.5rem;
    padding-inline: 1.125rem;
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* Two rocks, ±1 to 1.5deg, alternated by position with offset pivots,
     lengths and start points, so no two neighbours move in step. */
  @keyframes jiggle-a {
    0%, 100% { rotate: -1deg; }
    50% { rotate: 1.5deg; }
  }

  @keyframes jiggle-b {
    0%, 100% { rotate: 1.25deg; }
    50% { rotate: -1deg; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .home[data-jiggle] :global(.app-icon) {
      animation: jiggle-a 0.24s ease-in-out infinite;
      transform-origin: 48% 54%;
    }

    .home[data-jiggle] :global(li:nth-child(even) .app-icon) {
      animation-name: jiggle-b;
      animation-duration: 0.22s;
      transform-origin: 53% 46%;
    }

    .home[data-jiggle] :global(li:nth-child(3n) .app-icon) {
      animation-duration: 0.25s;
      animation-delay: -0.08s;
    }

    .home[data-jiggle] :global(li:nth-child(5n + 1) .app-icon) {
      animation-delay: -0.15s;
    }

    /* The open, where there is no View Transition: up and out, then the page. */
    .home :global(.app-icon.is-opening) {
      scale: 1.6;
      opacity: 0;
      transition-property: scale, opacity;
      transition-duration: 160ms;
      transition-timing-function: var(--ease-out);
    }
  }

  /* Reduced motion: a still tilt says the same thing. */
  @media (prefers-reduced-motion: reduce) {
    .home[data-jiggle] :global(.app-icon) {
      rotate: -1deg;
    }

    .home[data-jiggle] :global(li:nth-child(even) .app-icon) {
      rotate: 1deg;
    }
  }
</style>
