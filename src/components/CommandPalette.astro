---
/**
 * CommandPalette — Cmd+K over every entry and page on the site, and the full
 * text of every post, TLDR, highlight and note (VET-247).
 *
 * Rendered once, by `layouts/Base.astro`, so the shortcut works from anywhere.
 * What is in here is the empty shell. The rest is next door, split along the
 * line between what can be tested and what cannot:
 *
 *   `lib/search.ts`        ranking and excerpts. No imports, so `node --test` runs it.
 *   `lib/search-index.ts`  every destination on the site, built once per build,
 *                          served as `/search.json` (`pages/search.json.ts`) and
 *                          fetched the first time the palette opens.
 *   `lib/palette-rows.ts`  the result rows, as DOM.
 *   `lib/palette.ts`       open, close, keys, focus.
 *   `styles/palette.css`   the look — global, because half of what it styles is
 *                          created at runtime and never sees Astro's scoping.
 *
 * The index used to ride inline on every page: 38 KB of JSON before it held
 * any body text. With the post bodies it is several times that, and most page
 * views never open the palette, so it is a request on demand now.
 */
import SoundToggle from "./SoundToggle.astro";
import { buildSearchIndex } from "../lib/search-index";

/**
 * The empty palette's rows (Go to, Browse, Recent saves, Actions, Try
 * searching), inline, so they paint with the panel on the first open (VET-282,
 * E5). They used to arrive with `/search.json`, 139 KB, so a first ⌘K drew
 * the search glyph over an empty panel and the rows popped in later. About
 * 8.6 KB raw per page; typed queries still wait for the index. `<` is escaped
 * so a title can never close the script element.
 */
const home = JSON.stringify((await buildSearchIndex()).filter((entry) => entry.group)).replace(/</g, "\\u003c");
---

<div
  class="palette"
  data-palette
  role="dialog"
  aria-modal="true"
  aria-label="Search this site"
>
  <div class="palette__scrim" data-palette-scrim></div>

  <div class="palette__panel">
    <div class="palette__field">
      {/*
        The leading search glyph, drawn rather than imported: one circle and one
        handle on a 16-unit grid, `currentColor`, the same construction the site
        mark uses. It is decorative — the input below it already carries
        `aria-label="Search this site"`, and a second name for the same control
        would be read out twice — so it is `aria-hidden` and adds nothing to the
        accessibility tree.
      */}
      <svg
        class="palette__search"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <circle cx="7" cy="7" r="4.5"></circle>
        <path d="M10.5 10.5 L14 14" stroke-linecap="round"></path>
      </svg>

      <input
        class="palette__input"
        data-palette-input
        type="text"
        role="combobox"
        aria-expanded="false"
        aria-controls="palette-results"
        aria-autocomplete="list"
        aria-label="Search this site"
        placeholder="Search tools, sites, library&hellip;"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
      />
      <kbd class="palette__esc mono">Esc</kbd>
      {/* Touch has no Esc (VET-282, E6): a 44px ×, shown where the pointer is coarse. */}
      <button class="palette__close" type="button" data-palette-close aria-label="Close search">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M4 4 L12 12 M12 4 L4 12"></path>
        </svg>
      </button>
    </div>

    <div
      class="palette__results"
      id="palette-results"
      data-palette-results
      role="listbox"
      aria-label="Results"
    >
    </div>

    <p class="palette__empty mono" data-palette-empty hidden>No matches</p>
    {/* What a screen reader hears after each keystroke: loading, the count, or the failure. */}
    <p class="visually-hidden" role="status" data-palette-status></p>

    <div class="palette__legend mono">
      <span class="palette__keys" aria-hidden="true">&uarr;&darr; navigate &middot; &crarr; open &middot; esc close</span>
      <SoundToggle />
    </div>
  </div>
</div>

<script is:inline type="application/json" data-palette-home set:html={home} />

<script>
  import { initPalette } from "../lib/palette";

  const root = document.querySelector<HTMLElement>("[data-palette]");
  if (root) initPalette(root);
</script>
