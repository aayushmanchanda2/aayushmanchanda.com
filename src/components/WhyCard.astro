---
/**
 * "Why I saved it" on a private entry (VET-274): his own words first, in his
 * line breaks (the Raindrop note unlabelled, what he sent Hermes on Telegram
 * marked "(Telegram)"), then why it was saved, the filed note, the
 * sweep's note (labelled as Hermes's) and his Raindrop highlights, which take
 * the reader's highlighter sweep (`ReaderBlocks.astro` arms every `mark.hl`).
 * A `dl` like `EntryBlock.astro`, so each label is read with its value. Empty
 * parts render nothing, and with every part empty there is no card: a heading
 * with nothing under it reads as a page that failed.
 */
import type { Why } from "../lib/private";

interface Props {
  why: Why;
}

const { mine, telegram, filed, why, sweep, highlights } = Astro.props.why;
---

{
  (mine || telegram || filed || why || sweep || highlights.length > 0) && (
    <section class="whycard" aria-labelledby="whycard-h">
      <h2 id="whycard-h" class="whycard__label mono">Why I saved it</h2>
      <dl class="whycard__rows">
        {(mine || telegram) && (
          <>
            <dt>Your note</dt>
            <dd class="whycard__mine">
              {mine && <p class="whycard__words">{mine}</p>}
              {telegram && (
                <p>
                  <span class="whycard__words">{telegram}</span> <span class="whycard__src">(Telegram)</span>
                </p>
              )}
            </dd>
          </>
        )}
        {why && (
          <>
            <dt>Why it&rsquo;s here</dt>
            <dd>{why}</dd>
          </>
        )}
        {filed && (
          <>
            <dt>Filed note</dt>
            <dd>{filed}</dd>
          </>
        )}
        {sweep && (
          <>
            <dt>Hermes</dt>
            <dd>{sweep}</dd>
          </>
        )}
        {highlights.length > 0 && (
          <>
            <dt>Your highlights</dt>
            <dd>
              <ul class="whycard__marks">
                {highlights.map((mark) => (
                  <li>
                    <mark class="hl">{mark.text}</mark>
                    {mark.note && <span class="whycard__aside">{mark.note}</span>}
                  </li>
                ))}
              </ul>
            </dd>
          </>
        )}
      </dl>
    </section>
  )
}

<style>
  /* The block card's box, dashed: a note to himself, not a verdict for readers. */
  .whycard {
    max-width: 40rem;
    margin-bottom: 2rem;
    padding: clamp(1rem, 3vw, 1.25rem);
    border: 1px dashed var(--hairline-strong);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .whycard__label {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  .whycard__rows {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.75rem 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  dt {
    padding-top: 0.1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  dd {
    color: var(--text-secondary);
    overflow-wrap: anywhere;
  }

  /* His words: the loudest lines in the card, his line breaks kept. */
  .whycard__mine {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 1.0625rem;
    color: var(--text-primary);
  }

  .whycard__words {
    white-space: pre-wrap;
  }

  .whycard__src {
    font-size: 0.875rem;
    color: var(--text-tertiary);
  }

  .whycard__marks {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--text-primary);
  }

  .whycard__aside {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  @media (max-width: 40rem) {
    .whycard__rows {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }

    dd + dt {
      margin-top: 0.75rem;
    }
  }
</style>
