---
/**
 * LibraryPane — the list beside an entry on /library/<slug>, briOS's
 * `ListDetailLayout` list pane: 350px, its own scroll, the current row on a
 * surface with a 12px radius. The layout it sits in is `layouts/Base.astro`'s
 * `pane` slot; the container query that hides it under 48rem is here.
 *
 * A sticky toolbar sits on top (VET-245, `LibraryToolbar.astro`): the kind
 * segmented control and a live count. The tag filter scrolls under it
 * (`LibraryTags.astro`), and the rows are grouped under sticky month headers
 * by `saved_date`, newest first (VET-267). `lib/library-pane.ts › FILTER` runs
 * inline after the list, so a filtered pane paints filtered (headers recount,
 * empty months hide), and it writes the filter onto every row link so it
 * carries from entry to entry.
 *
 * /library and `/library/kind/<kind>` render it too (VET-258), with no current
 * row and `start` set to the kind the route pre-selects. There the two inline
 * scripts run from `LibraryViews.astro` instead, after the views they switch.
 *
 * It repeats on every entry page, so the row is kept small on purpose:
 * three bare elements plus the kind glyph, no scoped-style attributes (the
 * style block is global and namespaced to `.pane`), and the summary cut at 110
 * characters, about what the two-line clamp shows. The measured cost is in the
 * VET-231 audit.
 */
import KindIcon from "./KindIcon.astro";
import LockGlyph from "./LockGlyph.astro";
import LibraryTags from "./LibraryTags.astro";
import LibraryToolbar from "./LibraryToolbar.astro";
import PreviewCard from "./PreviewCard.astro";
import type { Kind, LibraryEntry } from "../lib/library";
import { entryHref, rowSummary } from "../lib/library";
import { privateHref } from "../lib/private";
import { FILTER, PREPAINT } from "../lib/library-pane";
import { clipText } from "../lib/post";
import { libraryPreview } from "../lib/assets";
import { formatDay, formatMonth } from "../lib/date";

interface Props {
  entries: LibraryEntry[];
  /** The slug of the entry on this page; its row gets `aria-current`. */
  current?: string;
  /** On /library and the kind routes: the kind shown on load, "" for All. */
  start?: Kind | "";
  /** /me's private rows (VET-274): merged by date, lock-marked, under "Private". Absent: markup unchanged. */
  extra?: LibraryEntry[];
}

const { entries, current, start, extra = [] } = Astro.props;
const index = start !== undefined;

/** Month headers over the main feed: "2026-09" -> its label and count. "Also saved" follows it (VET-273). */
const main = [...entries.filter((entry) => !entry.also_saved), ...extra].sort((a, b) => b.saved_date.localeCompare(a.saved_date));
const also = entries.filter((entry) => entry.also_saved);
const months = new Map<string, number>();
for (const entry of main) months.set(entry.saved_date.slice(0, 7), (months.get(entry.saved_date.slice(0, 7)) ?? 0) + 1);
const opens = (i: number) => i === 0 || main[i]!.saved_date.slice(0, 7) !== main[i - 1]!.saved_date.slice(0, 7);
---

<nav
  class="pane"
  aria-label="Library list"
  data-pane
  data-mnav-inert
  data-home={index ? "/library" : undefined}
  data-start={start}
>
  <div class="pane__bar">
    <LibraryToolbar privateCount={extra.length} />
  </div>
  <div class="pane__tags"><LibraryTags /></div>
  <ul data-rows>
    {
      [...main, ...also].map((entry, i) => {
        const quiet = entry.also_saved;
        const summary = quiet ? null : (entry.block?.tip ?? rowSummary(entry));
        const own = extra.includes(entry);
        return (
          <>
          {!quiet && opens(i) && (
            <li class="pane__month mono" data-month>
              {formatMonth(entry.saved_date)} · <span class="tabular-nums" data-month-count>{months.get(entry.saved_date.slice(0, 7))}</span>
            </li>
          )}
          {i === main.length && <li class="pane__month pane__also mono" data-month>Also saved · <span class="tabular-nums" data-month-count>{also.length}</span></li>}
          <li data-kind={own ? "private" : entry.kind} data-tags={entry.tags.join(" ")} data-also={quiet ? "" : undefined}>
            <a
              href={own ? privateHref(entry.slug) : entryHref(entry)}
              data-astro-prefetch="hover"
              aria-current={entry.slug === current ? "page" : undefined}
              {...(own ? {} : libraryPreview(entry))}
            >
              <b>{entry.title}</b>
              <small>
                {!quiet && <KindIcon kind={entry.kind} />}
                {own && <LockGlyph />}
                <span>{entry.domain}</span>
                {quiet && <time datetime={entry.saved_date}>{formatDay(entry.saved_date)}</time>}
              </small>
              {summary && <span class:list={[entry.block && "tip"]}>{clipText(summary, 110)}</span>}
            </a>
          </li>
          </>
        );
      })
    }
  </ul>
  <p class="pane__empty" data-filter-empty hidden>
    No entries match these filters. <a href={extra.length > 0 ? "/me/library" : current ? `/library/${current}` : "/library"}>Show all</a>
  </p>
</nav>
<PreviewCard />
{!index && <script is:inline set:html={FILTER} />}
{!index && <script is:inline set:html={PREPAINT} />}
<script>
  import { ownsKey } from "../lib/keys";
  import { PANE_ATTRIBUTE, paneStep } from "../lib/library-pane";

  // A roving tabindex: the rows are one tab stop, so Tab from the bar reaches
  // the entry instead of walking the whole list. `FILTER` puts the stop on the
  // `aria-current` row, or the first shown one, every time the filter changes;
  // Up, Down, Home and End move it among the rows the filter shows, and Enter
  // is the link's own. Month headers hold no link, so no key lands on one.
  // Without scripting every row is a stop again. On /library and the kind
  // routes j and k move the stop too; on an entry page they are EntryNav's
  // next and prev.
  const ALIAS: Record<string, string> = { j: "ArrowDown", k: "ArrowUp" };
  const pane = document.querySelector<HTMLElement>(`[${PANE_ATTRIBUTE}]`);
  const entryPage = document.querySelector("[data-entry-nav]") !== null;
  pane?.addEventListener("keydown", (event) => {
    if (!ownsKey(event) || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
    const links = [...pane.querySelectorAll<HTMLAnchorElement>("[data-rows] > li:not([hidden]) > a")];
    const from = links.indexOf(event.target as HTMLAnchorElement);
    const key = entryPage ? event.key : (ALIAS[event.key] ?? event.key);
    const to = from < 0 ? null : paneStep(key, from, links.length);
    const next = to === null ? undefined : links[to];
    if (!next) return;
    event.preventDefault();
    (event.target as HTMLAnchorElement).tabIndex = -1;
    next.tabIndex = 0;
    next.focus();
  });

  // The month headers stick under the toolbar, whose height is the page's
  // type and zoom rather than a number worth hard-coding.
  const bar = pane?.querySelector<HTMLElement>(".pane__bar");
  if (pane && bar) new ResizeObserver(() => pane.style.setProperty("--pane-bar", `${bar.offsetHeight}px`)).observe(bar);
</script>

<style is:global>
  .pane {
    display: none;
  }
  /* briOS's @3xl: two panes from 48rem of container, one below it. The
     container is `.split` in `layouts/Base.astro`. */
  @container split (width >= 48rem) {
    .pane {
      display: block;
      position: sticky;
      top: calc(var(--frame) + var(--bar-h));
      flex: 0 0 350px;
      height: calc(100dvh - var(--bar-h) - var(--frame) - var(--frame-in));
      overflow-y: auto;
      /* Arrow-key focus scrolls a row clear of the toolbar and a month header. */
      scroll-padding-top: calc(var(--pane-bar, 5.375rem) + 2.25rem);
      border-right: 1px solid var(--hairline);
    }
  }
  /* The toolbar: sticky at the top of the pane's own scroll, on the page
     colour so rows pass under it, a hairline under it. Padding lives here and
     on the list rather than on the pane, so `top: 0` is the pane's top. */
  .pane__bar {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: 0.75rem;
    background: var(--bg);
    border-bottom: 1px solid var(--hairline);
  }

  .pane__tags {
    padding: 0.25rem 0.75rem 0;
  }
  /* Apple Notes' month headers: sticky under the toolbar, on the page colour
     so rows pass under, the next month sliding over the last. Not a link and
     not a stop: the roving tabindex walks rows only. */
  .pane .pane__month {
    position: sticky;
    top: var(--pane-bar, 5.375rem);
    z-index: 1;
    padding: 0.625rem 0.875rem 0.375rem;
    background: var(--bg);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
  }
  /* Quieter than a month: the rows under it are kept, not featured (VET-273). */
  .pane .pane__also {
    margin-top: 1.5rem;
    color: var(--text-tertiary);
  }

  .pane li[data-also] b {
    font-weight: 400;
    color: var(--text-secondary);
  }

  .pane li[data-also] time::before {
    content: "\00b7" / "";
    margin-right: 0.4rem;
  }

  .pane .pane__month .tabular-nums {
    color: var(--text-tertiary);
  }

  .pane__empty {
    padding: 1.5rem 0.75rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .pane__empty a {
    color: var(--text-primary);
  }

  .pane ul {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0.75rem;
  }

  .pane li > a {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.75rem 0.875rem;
    border-radius: var(--r-lg);
    color: var(--text-primary);
    text-decoration: none;
  }
  /* briOS's /hn row: hover and selected are one look, and hover is instant
     (design.md §4). */
  @media (hover: hover) {
    .pane li > a:hover {
      background: var(--surface-selected);
      box-shadow: var(--shadow-contrast);
    }
  }

  .pane li > a[aria-current="page"] {
    background: var(--surface-selected);
    box-shadow: var(--shadow-contrast);
  }
  /* 14px UI text throughout the row (design.md §2). */
  .pane b {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.45;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  /* The kind glyph, then the domain (VET-245); the glyph carries the kind's
     word for a screen reader. */
  .pane small {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--text-tertiary);
  }

  /* The TLDR line (T14 fills it; `lib/library.ts › rowSummary` says what
     stands in until then). */
  .pane li > a > span {
    margin-top: 0.125rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  /* A block's tip: one line (VET-273). */
  .pane li > a > .tip {
    -webkit-line-clamp: 1;
    line-clamp: 1;
  }
</style>
