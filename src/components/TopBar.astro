---
/**
 * TopBar — the bar at the top of every page: menu, trail, search.
 *
 * Sticky, 56px, the page colour behind it, and no backdrop filter on purpose:
 * a filter would make this the containing block for the menu panel's
 * `position: fixed` and clip it to the bar. A press on its empty stretch
 * scrolls to the top (script below). `Base.astro` works out the items and the
 * trail; this draws them. Search is on every width: the word and ⌘K from
 * 600px, the glyph alone on a phone (VET-282). While Aayush is signed in,
 * `lib/signed-in.ts` adds "Private" and "Sign out" at its end.
 */
import Breadcrumbs from "./Breadcrumbs.astro";
import MobileNav from "./MobileNav.astro";
import type { Crumb } from "../lib/schema";
import type { NavItem } from "../lib/sections";

interface Props {
  navItems: NavItem[];
  pathname: string;
  trail: Crumb[];
}

const { navItems, pathname, trail } = Astro.props;
---

<header class="bar" data-bar>
  <MobileNav items={navItems} pathname={pathname} />
  <Breadcrumbs trail={trail} />
  <button
    class="bar__search mono press"
    type="button"
    data-palette-open
    data-mnav-inert
  >
    <svg class="bar__glyph" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="7" cy="7" r="4.5"></circle>
      <path d="M10.5 10.5 L14 14" stroke-linecap="round"></path>
    </svg>
    <span class="bar__word">Search</span> <kbd data-palette-hint>&#8984;K</kbd>
  </button>
</header>

<script>
  // A press on the bar's empty stretch goes back to the top. Controls in
  // it keep their own job. `html { scroll-behavior }` decides smooth or
  // instant, so reduced motion is already honoured.
  document.querySelector("[data-bar]")?.addEventListener("click", (event) => {
    if ((event.target as Element).closest("a, button")) return;
    window.scrollTo({ top: 0 });
  });
</script>

<style>
  .bar {
    position: sticky;
    top: var(--frame);
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    height: var(--bar-h);
    padding-inline: max(0.5rem, env(safe-area-inset-left))
      max(0.5rem, env(safe-area-inset-right));
    background: var(--bg);
  }

  /* The menu's scrim and panel live in here, so this stacking context is
     theirs. While the menu is up (the scrim leaves `hidden` only then, and
     after its fade out) it rises over the stamp frame's 40, so the panel
     covers the whole window, frame included (`styles/frame.css`). */
  .bar:has(.mnav__scrim:not([hidden])) {
    z-index: 90;
  }

  .bar__search {
    flex-shrink: 0;
    margin-left: auto;
    padding: 0.625rem 0.5rem;
    color: var(--text-secondary);
    cursor: pointer;
  }

  .bar__search kbd {
    font: inherit;
    font-family: var(--font-mono);
    margin-left: 0.35rem;
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--r-sm);
  }

  @media (hover: hover) {
    .bar__search:hover {
      color: var(--accent);
    }
  }

  /* The stamp's solid paper (`--cover`, z 40) sits over the bar's top edge,
     so a ring drawn outside a control there is half hidden. Inside, instead.
     Not in the menu sheet, which lives in here but is clear of the paper. */
  .bar :global(:focus-visible:not(.mnav__panel *)) {
    outline-offset: -2px;
  }

  .bar__glyph {
    display: none;
  }

  /* A phone gets the glyph alone, top right and always there (VET-282, E4):
     a 44px target, the word kept for a screen reader, no key to legend. */
  @media (max-width: 599px) {
    .bar__search {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      color: var(--text-primary);
    }

    .bar__glyph {
      display: block;
      width: 1.125rem;
      height: 1.125rem;
    }

    .bar__word {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .bar__search kbd {
      display: none;
    }
  }
</style>
