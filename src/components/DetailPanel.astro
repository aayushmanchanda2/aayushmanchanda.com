---
/**
 * DetailPanel — the slide-over detail on /sites and /tools, one component for
 * both (`lib/detail-panel.ts` is the behaviour; each page's script calls
 * `initDetailPanel`). builtbydesigners' `.details-panel`: fixed right under
 * the bar, leaving `listWidth` of the index beside it, a hairline on its left
 * edge, sliding in on translateX. At 48rem and below it is a full-width sheet.
 *
 * Its content is the static page's: a click on a tile or a row fetches
 * `<base>/<slug>`, lifts its `[data-detail]` article out and wires it. The
 * href is untouched, so a modifier click, a reload or no scripting at all gets
 * the full static page. The page imports the detail component (`SiteDetail`,
 * `ToolDetail`) without rendering it, so Astro ships its CSS there.
 *
 * **A non-modal dialog** (`role="dialog"`, `aria-modal="false"`). The index
 * beside it stays visible and live: a click on another tile or row switches
 * the panel, the filters and the layout toggle keep working, and a click on
 * the empty canvas closes it. On a desktop it lifts off the index with a
 * layered shadow on its left edge and dims it by a few percent (QA phase 2,
 * B3); the dim is a shadow, so it takes no clicks. Modal semantics would hide
 * that live half from a screen reader while a pointer can still use it. Focus
 * moves in on open and Tab wraps inside, so a keyboard reader stays with what
 * just opened; Escape (or the close button) leaves and puts focus back on the
 * tile that opened it.
 *
 * History: opening pushes `<base>/<slug>` (the filter query rides along),
 * switching replaces, closing steps back off the entry it pushed.
 */
interface Props {
  /** The index path the entries live under: "/sites", "/tools". */
  base: string;
  /** How much of the index stays visible beside the panel. */
  listWidth: string;
}

const { base, listWidth } = Astro.props;
---

<div
  class="panel"
  role="dialog"
  aria-modal="false"
  aria-labelledby="detail-panel-title"
  tabindex="-1"
  data-detail-panel={base}
  style={`--list-width: ${listWidth}`}
  inert
>
  <div class="panel__bar">
    <button class="panel__close" type="button" aria-label="Close" data-panel-close>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
        <path d="M4 4 L12 12 M12 4 L4 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <div class="panel__body" data-panel-body></div>
</div>

<style>
  .panel {
    position: fixed;
    top: calc(var(--frame) + var(--bar-h));
    right: var(--frame);
    bottom: var(--frame-in);
    z-index: 20;
    width: calc(100% - var(--list-width) - 2 * var(--frame));
    overflow-y: auto;
    overscroll-behavior-y: auto;
    border-left: 1px solid var(--hairline);
    background: var(--bg);
    visibility: hidden;
    transform: translateX(100%);
    transition-property: transform, visibility, box-shadow;
    transition-duration: 0.22s;
    transition-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  .panel[data-open] {
    visibility: visible;
    transform: none;
    transition-timing-function: cubic-bezier(0.32, 0.72, 0, 1);
  }

  .panel:focus {
    outline: none;
  }

  /* Beside the index: two shadow layers off the left edge, then a spread
     the size of the window, which is the dim. Under the bar (30) and the
     mat (40), so only the index takes it. */
  @media (width > 48rem) {
    .panel[data-open] {
      box-shadow:
        -1px 0 3px var(--panel-shadow),
        -12px 0 32px var(--panel-shadow),
        0 0 0 100vmax var(--panel-dim);
    }
  }

  @media (max-width: 48rem) {
    .panel {
      width: calc(100% - 2 * var(--frame));
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      transition: none;
    }
  }

  .panel__bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    padding: 0.5rem 0.5rem 0;
    pointer-events: none;
  }

  /* 40px, the hit floor, on the page's own background so it reads over the
     screenshot as it scrolls past. */
  .panel__close {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    background: var(--bg);
    color: var(--text-secondary);
    pointer-events: auto;
  }

  @media (hover: hover) {
    .panel__close:hover {
      color: var(--text-primary);
      border-color: var(--hairline-strong);
    }
  }

  .panel__body {
    max-width: 52rem;
    padding: 0 clamp(1rem, 4vw, 2.5rem) 3rem;
    margin-top: -1.5rem;
  }

  .panel__body[aria-busy="true"] {
    opacity: 0.5;
  }
</style>
