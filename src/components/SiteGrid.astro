---
/**
 * SiteGrid — the gallery view of /sites, and of its collection and domain
 * pages.
 *
 * The card is mostly picture: the top of the full-page capture on graph paper
 * (`ShotFrame.astro`, `crop`), the title and the domain in mono underneath.
 * 1 / 2 / 3 / 4 columns at 640 / 1024 / 1536px across the full width, with
 * real gaps so each card reads as its own object.
 *
 * One card per domain (`lib/screens.ts`): a site saved as three pages is one
 * card saying "3 screens", and the panel lists them. No preview card on a
 * tile: the tile already is the picture.
 *
 * Each card carries its primary screen's colour families (`data-hues`,
 * `lib/hues.ts`) for the colour row (`HueFilter.astro`) to filter by.
 *
 * Every card is a link to `/sites/<slug>`. On /sites, `DetailPanel.astro` turns
 * that click into the slide-over; everywhere else it is a plain page load.
 */
import { paletteFamilies } from "../lib/hues";
import type { SiteGroup } from "../lib/screens";
import ShotFrame from "./ShotFrame.astro";

interface Props {
  groups: SiteGroup[];
}

const { groups } = Astro.props;

/**
 * Cards fade in one after another. Past this many the stagger stops growing,
 * so a gallery of forty does not leave the last card waiting three seconds.
 */
const STAGGER_CAP = 8;

/** The first row at the widest breakpoint is the LCP candidate: not lazy. */
const EAGER_COUNT = 4;
---

<ul class="grid" data-sites-grid>
  {
    groups.map(({ primary, screens }, index) => (
      <li class="card" style={`--stagger: ${Math.min(index, STAGGER_CAP)}`} data-hues={paletteFamilies(primary.palette).join(" ")}>
        <a
          class="card__link press"
          href={`/sites/${primary.slug}`} data-astro-prefetch="hover"
          data-panel-open
          data-slugs={screens.map((screen) => screen.site.slug).join(" ")}
        >
          <ShotFrame src={primary.shot} alt="" crop eager={index < EAGER_COUNT} />
          <span class="card__meta">
            <span class="card__title">{primary.title}</span>
            {screens.length > 1 && <span class="card__count mono">{screens.length} screens</span>}
            <span class="card__domain mono">{primary.domain}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .grid {
    --gap: clamp(16px, 2vw, 28px);

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    /* Rows get 8px more than columns: the caption sits in the row gap. */
    gap: calc(var(--gap) + 0.5rem) var(--gap);
    margin: 0;
  }

  @media (min-width: 640px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 1536px) {
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  :global(html[data-sites-view="list"]) .grid {
    display: none;
  }

  .card {
    min-width: 0;
  }

  .card__link {
    /* A card is a wide target; 0.96 would visibly shove it sideways. */
    --press-scale: 0.985;

    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  /* Hover is instant (design.md §4): no transition on the frame's border or
     the title's ink. */
  .card__link:hover :global(.frame) {
    border-color: var(--hairline-strong);
  }

  /* Title and count share the first line, the domain takes the second. */
  .card__meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 0.75rem;
    row-gap: 0.15rem;
    align-items: baseline;
  }

  .card__title {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .card__link:hover .card__title {
    color: var(--accent);
  }

  .card__count {
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  .card__domain {
    grid-column: 1 / -1;
    color: var(--text-tertiary);
    overflow-wrap: anywhere;
  }

  /* --- entrance ------------------------------------------------------------
     Gated on `no-preference` rather than leaning on the global reduced-motion
     brake: that brake shortens durations but leaves delays alone, which would
     hold a card invisible for its stagger and then pop it in. */

  @media (prefers-reduced-motion: no-preference) {
    .card {
      animation: card-in var(--dur-slow) var(--ease-out) both;
      animation-delay: calc(var(--stagger, 0) * 80ms);
    }
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
