---
/**
 * SiteGrid — the gallery view of /sites, and of its collection and domain
 * pages. briOS's /sites grid (`GoodWebsitesPageClient.tsx`,
 * `GoodWebsiteGalleryItem.tsx`), in markup and CSS:
 *
 *   - edge to edge, 1 / 2 / 3 / 4 columns at 640 / 1024 / 1536px, 2px gaps and
 *     2px of padding on a `--surface-3` canvas (transparent in dark);
 *   - a 40:21 crop of the top of the full-page capture, which grows 2% on
 *     hover over 300ms;
 *   - the name in a blurred pill bottom-left, faded in on hover where a
 *     pointer can hover and always shown where it cannot.
 *
 * One card per domain (`lib/screens.ts`): a site saved as three pages is one
 * card saying "3 screens", and the panel lists them. No preview card on a
 * tile: the tile already is the picture.
 *
 * Every tile is a link to `/sites/<slug>`. On /sites, `SitePanel.astro` turns
 * that click into the slide-over; everywhere else it is a plain page load.
 */
import type { SiteGroup } from "../lib/screens";

interface Props {
  groups: SiteGroup[];
}

const { groups } = Astro.props;

/**
 * Cards fade in one after another. Past this many the stagger stops growing,
 * so a gallery of forty does not leave the last card waiting three seconds.
 */
const STAGGER_CAP = 8;

/** The first row at the widest breakpoint is the LCP candidate: not lazy. */
const EAGER_COUNT = 4;
---

<ul class="grid" data-sites-grid>
  {
    groups.map(({ primary, screens }, index) => (
      <li class="tile" style={`--stagger: ${Math.min(index, STAGGER_CAP)}`}>
        <a
          class="tile__link"
          href={`/sites/${primary.slug}`}
          data-site-open
          data-slugs={screens.map((screen) => screen.site.slug).join(" ")}
        >
          <img
            class="tile__shot outlined"
            src={primary.shot}
            alt=""
            loading={index < EAGER_COUNT ? "eager" : "lazy"}
            fetchpriority={index < EAGER_COUNT ? "high" : "auto"}
            decoding="async"
          />
          <span class="tile__pills">
            <span class="pill pill--name">{primary.title}</span>
            {screens.length > 1 && <span class="pill pill--count">{screens.length} screens</span>}
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* Bleeds out of the shell's padding, as the /tools table does. */
  .grid {
    --canvas: var(--surface-3);

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
    width: calc(100% + 2 * var(--page-pad));
    margin: 0 calc(-1 * var(--page-pad));
    padding: 2px;
    background: var(--canvas);
  }

  /* briOS's `dark:bg-transparent`, under both of global.css's dark selectors. */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .grid {
      --canvas: transparent;
    }
  }

  :global(:root[data-theme="dark"]) .grid {
    --canvas: transparent;
  }

  @media (min-width: 640px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 1536px) {
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  :global(html[data-sites-view="list"]) .grid {
    display: none;
  }

  .tile {
    min-width: 0;
  }

  .tile__link {
    position: relative;
    display: block;
    aspect-ratio: 40 / 21;
    overflow: hidden;
    background: var(--surface-3);
  }

  .tile__link:focus-visible {
    outline-offset: -2px;
    border-radius: 0;
  }

  .tile__shot {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition-property: transform;
    transition-duration: 300ms;
    transition-timing-function: var(--ease-out);
  }

  .tile__link:hover .tile__shot {
    transform: scale(1.02);
  }

  /* briOS's `p-4` corner. */
  .tile__pills {
    position: absolute;
    inset: auto 1rem 1rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 0.5rem;
    pointer-events: none;
  }

  /* `h-7 rounded-full bg-black/50 px-2.5 saturate-150 backdrop-blur-3xl
     text-sm font-medium text-white`, at 60% black rather than 50%: white on
     50% black over a white screenshot is 3.95:1, under AA for 14px. */
  .pill {
    display: flex;
    align-items: center;
    min-width: 0;
    height: 1.75rem;
    padding-inline: 0.625rem;
    border-radius: var(--r-pill);
    background: rgb(0 0 0 / 0.6);
    backdrop-filter: saturate(1.5) blur(64px);
    -webkit-backdrop-filter: saturate(1.5) blur(64px);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pill--count {
    flex: none;
  }

  /* Where a pointer can hover, the name waits for it: briOS's motion values,
     opacity, 4px and 0.96 over 150ms. The count is data and always shows. */
  @media (min-width: 640px) and (hover: hover) {
    .pill--name {
      opacity: 0;
      transform: translateY(4px) scale(0.96);
      transition-property: opacity, transform;
      transition-duration: 150ms;
      transition-timing-function: var(--ease-out);
    }

    .tile__link:is(:hover, :focus-visible) .pill--name {
      opacity: 1;
      transform: none;
    }
  }

  /* The global brake shortens these; this also drops the zoom and the rise. */
  @media (prefers-reduced-motion: reduce) {
    .tile__link:hover .tile__shot,
    .pill--name {
      transform: none;
    }
  }

  /* --- entrance ------------------------------------------------------------
     Gated on `no-preference` rather than leaning on the global reduced-motion
     brake: that brake shortens durations but leaves delays alone, which would
     hold a card invisible for its stagger and then pop it in. */

  @media (prefers-reduced-motion: no-preference) {
    .tile {
      animation: card-in var(--dur-slow) var(--ease-out) both;
      animation-delay: calc(var(--stagger, 0) * 80ms);
    }
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
