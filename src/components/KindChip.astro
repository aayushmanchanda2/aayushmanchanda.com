---
/**
 * KindChip — what sort of thing a /library row points at.
 *
 * Third sibling of VerdictBadge and StatusChip, and as thin as both: the tone
 * system lives in `styles/chip.css`, and this file only decides which tone each
 * of the three words gets.
 *
 * `article` takes blue, the tone /experiments already gives `shipped`: it is the
 * thing on this page that is finished and asks to be sat down with. `post` is
 * gray on purpose — a saved post is the lightest row here, and any colour would
 * argue otherwise. `video` takes amber, which on /experiments means `paused`
 * and here means the same thing in a different register: it wants a block of
 * time before it gives anything back.
 *
 * A label and nothing else. It used to carry an `href` too, and that form was
 * the filter bar above the list, on the reasoning that a filter for `video` and
 * the `video` on a row are the same word about the same thing. `KindTabs` took
 * that job because the bar had to grow a selected state, and a selected state is
 * the one thing this vocabulary cannot express: the tone is already spent saying
 * which kind a row is, and the accent a selection would need is the blue an
 * `article` chip is wearing on the row underneath. So the chip went back to
 * being what it reads as, a label saying what a thing is, and the tab row says
 * where the reader is. Same three words, two jobs, neither one borrowed.
 */
import type { Kind } from "../lib/library";

/** Exhaustive by type: a new kind will not compile until it has a tone. */
const TONES: Record<Kind, string> = {
  article: "blue",
  post: "gray",
  video: "amber",
};

interface Props {
  kind: Kind;
}

const { kind } = Astro.props;
const tone = TONES[kind];
---

<span class="chip" data-tone={tone}>{kind}</span>
