---
/**
 * PostWall — `/library/kind/post` as a grid of `PostCard`s.
 *
 * Four across above 1100px, three above 900, two above 600, one below, with a
 * 12px gap (swiped.design's post grid). A grid rather than columns, so the
 * posts stay newest first reading across, and every card in a row stretches
 * to the tallest: the text is cut and clamped, so rows stay close in height.
 *
 * Only an entry with a post gets a card. One saved without a status id (a
 * profile link) keeps its row on /library, where a title alone still says
 * something.
 */
import type { LibraryEntry, Post } from "../lib/library";
import { entryHref } from "../lib/library";
import PostCard from "./PostCard.astro";

interface Props {
  /** Post-kind entries, in the list's own newest-first order. */
  entries: LibraryEntry[];
}

const { entries } = Astro.props;

const cards = entries.filter(
  (entry): entry is LibraryEntry & { post: Post } => entry.post !== null,
);
---

<ul class="wall">
  {
    cards.map((entry) => (
      <li>
        <PostCard post={entry.post} url={entry.url} mode="grid" href={entryHref(entry)} />
      </li>
    ))
  }
</ul>

<style>
  .wall {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
  }

  @media (max-width: 1100px) {
    .wall {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .wall {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .wall {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
