---
/**
 * PostWall — the /library Posts view as a grid of `PostCard`s.
 *
 * Masonry (VET-284): CSS columns, four from 1000px of its own width, three
 * from 700, two from 440, one below, 16px apart; each card is as tall as its
 * post and never splits across columns. Container widths rather than viewport
 * ones, because the wall sits beside the 350px list pane on a desktop and
 * alone on a phone (VET-258). Columns fill top to bottom, so newest first
 * reads down the first column, then the next.
 *
 * Only an entry with a post gets a card. One saved without a status id (a
 * profile link) keeps its row in the pane, where a title alone still says
 * something. Each card carries its tags for the pane's tag filter.
 *
 * `compact` is the /library All view's four (QA phase 2, B6): the words and
 * who said them, no pictures and no quoted post, two across until the wall is
 * 1000px wide, then four, so four cards never leave one alone on a row.
 */
import type { LibraryEntry, Post } from "../lib/library";
import { entryHref } from "../lib/library";
import PostCard from "./PostCard.astro";

interface Props {
  /** Post-kind entries, in the list's own newest-first order. */
  entries: LibraryEntry[];
  compact?: boolean;
}

const { entries, compact = false } = Astro.props;

const cards = entries.filter(
  (entry): entry is LibraryEntry & { post: Post } => entry.post !== null,
);
---

<div class="wallbox">
  <ul class:list={["wall", { "wall--compact": compact }]}>
    {
      cards.map((entry) => (
        <li data-tags={entry.tags.join(" ")}>
          <PostCard post={entry.post} url={entry.url} mode="grid" href={entryHref(entry)} keyline={entry.keyline} />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .wallbox {
    container-type: inline-size;
  }

  .wall {
    columns: 1;
    column-gap: 16px;
    margin: 0;
  }

  /* `inline-block` as well as `break-inside`: Safari splits a block across
     columns even when told not to, and a split card cuts its shadow. */
  .wall > li {
    display: inline-block;
    width: 100%;
    margin-bottom: 16px;
    break-inside: avoid;
  }

  /* The tag filter hides a card with `hidden`, which the display above beats. */
  .wall > li[hidden] {
    display: none;
  }

  @container (width >= 440px) {
    .wall {
      columns: 2;
    }
  }

  @container (width >= 700px) {
    .wall {
      columns: 3;
    }
  }

  @container (width >= 1000px) {
    .wall {
      columns: 4;
    }
  }

  @container (700px <= width < 1000px) {
    .wall--compact {
      columns: 2;
    }
  }

  .wall--compact :global(:is(.pc > .pm, .pc__cover, .pc--quoted)) {
    display: none;
  }
</style>
