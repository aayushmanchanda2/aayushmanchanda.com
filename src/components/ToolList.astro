---
/**
 * ToolList — the /tools table, and the only place one is rendered.
 *
 * briOS's /stack table: Name (icon and name), Description, Category, Verdict,
 * Date. Every row is one link to the tool's own page: a real `<a>` on the name,
 * which a press anywhere on the row follows (`lib/row-link.ts`), so the
 * keyboard gets one stop per row and a right click on the name still offers
 * "open in new tab". The sort buttons sit in
 * a header that sticks under the top bar.
 *
 * `/tools` puts filters and a grid view (`ToolGrid.astro`) around it; the
 * verdict and category pages render their subset. Rows keep file order until a
 * header is pressed (`lib/tools-table.ts`).
 */
import "../styles/table.css";
import AppIcon from "./AppIcon.astro";
import PreviewCard from "./PreviewCard.astro";
import VerdictBadge from "./VerdictBadge.astro";
import { formatDay } from "../lib/date";
import type { Tool } from "../lib/tools";
import { toolAttributes } from "./tool-attributes";
import type { SortKey } from "../lib/tools-table";

interface Props {
  tools: Tool[];
  /** The column a filter page already states in its h1: one value on every row. */
  drop?: "category" | "verdict";
}

const { tools, drop } = Astro.props;

const ALL: { id: string; label: string; sort: SortKey | null }[] = [
  { id: "name", label: "Name", sort: "name" },
  { id: "desc", label: "Description", sort: null },
  { id: "category", label: "Category", sort: "category" },
  { id: "verdict", label: "Verdict", sort: "verdict" },
  { id: "date", label: "Date", sort: "date" },
];
const COLUMNS = ALL.filter((column) => column.id !== drop);
---

<table class="table dtable">
  <thead class="thead">
    <tr class="head">
      {
        COLUMNS.map((column) => (
          <th scope="col" class={`th th--${column.id}`} data-sort-key={column.sort}>
            {column.sort ? (
              <button class="sort" type="button">
                {column.label}
                <span class="sort__arrow" />
              </button>
            ) : (
              column.label
            )}
          </th>
        ))
      }
    </tr>
  </thead>
  <tbody data-tool-rows>
    {
      tools.map((tool) => (
        <tr class="row" {...toolAttributes(tool)}>
          <td class="cell cell--name">
            <span class="row__name">
              <AppIcon tool={tool} size={32} />
              <a class="row__link" href={`/tools/${tool.slug}`} data-astro-prefetch="hover" data-panel-open>
                {tool.name}
              </a>
              {drop !== "verdict" && (
                <span class="row__verdict--phone">
                  <VerdictBadge verdict={tool.verdict} />
                </span>
              )}
            </span>
            <p class="row__desc row__desc--phone">{tool.description ?? tool.note}</p>
          </td>
          <td class="cell cell--desc">
            <p class="row__desc">{tool.description ?? tool.note}</p>
          </td>
          {drop !== "category" && <td class="cell cell--category">{tool.category}</td>}
          {drop !== "verdict" && (
            <td class="cell cell--verdict">
              <VerdictBadge verdict={tool.verdict} />
            </td>
          )}
          <td class="cell cell--date">
            <time datetime={tool.status_date}>{formatDay(tool.status_date)}</time>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<PreviewCard />

<style>
  /* The table itself is `styles/table.css › .dtable`, shared with /sites.

     The short columns take fixed widths at every size: inside the frame and
     48px of side padding, a one-twelfth track (briOS's grid) is narrower than
     a date ("Aug 17, 2026" is 88px) until well past 1600px. Every cell ends in
     16px; the outer cells add `--page-pad`. */
  .th--name { width: 27%; }
  .th--category { width: 9.5rem; }
  .th--verdict { width: 7.5rem; }
  .th--date { width: calc(6.75rem + var(--page-pad)); }

  /* A control: `--text-secondary` (the ink floor), 40px tall (the hit floor;
     briOS's header row is 36). */
  .sort {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 40px;
    color: var(--text-secondary);
    font-weight: inherit;
  }

  .sort:hover,
  .th[aria-sort] .sort {
    color: var(--text-primary);
  }

  /* The arrow is drawn, with an empty accessible name: `aria-sort` on the
     header already says which way. */
  .th[aria-sort="ascending"] .sort__arrow::before { content: "\2191" / ""; }
  .th[aria-sort="descending"] .sort__arrow::before { content: "\2193" / ""; }

  /* One line in tertiary, briOS's; the whole note is on the tool's page. */
  .row__desc {
    overflow: hidden;
    white-space: nowrap;
    color: var(--text-tertiary);
    text-overflow: ellipsis;
  }

  /* The phone copy under the name: two lines, the listing clamp. */
  .row__desc--phone {
    display: none;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    padding-top: 0.25rem;
    white-space: normal;
  }

  .row__verdict--phone {
    display: none;
    margin-left: auto;
    flex: none;
  }

  /* Phone width: one column. Icon, name and verdict on a line, the
     description full width under them (a verdict column left it 140px at
     320). Still a table: changing `display` on a tr or th strips table
     semantics in Safari, so columns are hidden, never restyled. The
     description and verdict columns hide and their phone copies show, so a
     screen reader meets one of each at any width. Category and date, header
     and cell, live on the tool's page. */
  @media (max-width: 639px) {
    .th--desc,
    .th--category,
    .th--verdict,
    .th--date,
    .cell--desc,
    .cell--category,
    .cell--verdict,
    .cell--date {
      display: none;
    }

    .th--name { width: auto; }
    /* The one visible cell is also the last edge: pad back to the frame. */
    :is(.th--name, .cell--name) { padding-right: var(--page-pad); }
    .cell--name { white-space: normal; }

    .row__desc--phone {
      display: -webkit-box;
    }

    .row__verdict--phone {
      display: block;
    }
  }

  /* 640 to 899px (a tablet, or a laptop at 200% zoom): the fixed columns left
     the description a few pixels and its header ran into Category (VET-307).
     It moves under the name, as on a phone; the other columns stay. */
  @media (min-width: 640px) and (max-width: 899px) {
    .th--desc,
    .cell--desc {
      display: none;
    }

    .cell--name { white-space: normal; }

    .row__desc--phone {
      display: -webkit-box;
    }
  }

  :global(html[data-tools-view="grid"]) .table {
    display: none;
  }

  /* 44px under a finger (VET-307): the header grows with it. */
  @media (pointer: coarse) {
    .sort {
      min-height: 44px;
    }
  }
</style>

<script>
  import "../lib/row-link";
  import { isSortKey, nextSort, sortItems, type Sort } from "../lib/tools-table";

  let sort: Sort = null;
  const heads = document.querySelectorAll<HTMLElement>("th[data-sort-key]");

  for (const head of heads) {
    head.querySelector("button")?.addEventListener("click", () => {
      const key = head.dataset.sortKey;
      if (!isSortKey(key)) return;
      sort = nextSort(sort, key);

      for (const other of heads) {
        if (sort !== null && other === head) other.setAttribute("aria-sort", sort.direction);
        else other.removeAttribute("aria-sort");
      }

      // The table and the grid carry the same keys, so both views keep one order.
      for (const list of document.querySelectorAll("[data-tool-rows]")) {
        list.append(...sortItems([...list.children], sort, (item, name) => item.getAttribute(name) ?? ""));
      }
    });
  }
</script>
