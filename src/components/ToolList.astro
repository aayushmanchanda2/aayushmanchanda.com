---
/**
 * ToolList — the /tools table, and the only place one is rendered.
 *
 * briOS's /stack table: Name (icon and name), Description, Category, Verdict,
 * Date. Every row is one link to the tool's own page: a real `<a>` on the name,
 * stretched over the row by its `::after`, so the keyboard gets one stop per
 * row and a right click still offers "open in new tab". The sort buttons sit in
 * a header that sticks under the top bar.
 *
 * `/tools` puts filters and a grid view (`ToolGrid.astro`) around it; the
 * verdict and category pages render their subset. Rows keep file order until a
 * header is pressed (`lib/tools-table.ts`).
 */
import AppIcon from "./AppIcon.astro";
import PreviewCard from "./PreviewCard.astro";
import VerdictBadge from "./VerdictBadge.astro";
import { formatDay } from "../lib/date";
import type { Tool } from "../lib/tools";
import { toolAttributes } from "./tool-attributes";
import type { SortKey } from "../lib/tools-table";

interface Props {
  tools: Tool[];
  /** The column a filter page already states in its h1: one value on every row. */
  drop?: "category" | "verdict";
}

const { tools, drop } = Astro.props;

const ALL: { id: string; label: string; sort: SortKey | null }[] = [
  { id: "name", label: "Name", sort: "name" },
  { id: "desc", label: "Description", sort: null },
  { id: "category", label: "Category", sort: "category" },
  { id: "verdict", label: "Verdict", sort: "verdict" },
  { id: "date", label: "Date", sort: "date" },
];
const COLUMNS = ALL.filter((column) => column.id !== drop);
---

<table class="table">
  <thead class="thead">
    <tr class="head">
      {
        COLUMNS.map((column) => (
          <th scope="col" class={`th th--${column.id}`} data-sort-key={column.sort}>
            {column.sort ? (
              <button class="sort" type="button">
                {column.label}
                <span class="sort__arrow" />
              </button>
            ) : (
              column.label
            )}
          </th>
        ))
      }
    </tr>
  </thead>
  <tbody data-tool-rows>
    {
      tools.map((tool) => (
        <tr class="row" {...toolAttributes(tool)}>
          <td class="cell cell--name">
            <span class="row__name">
              <AppIcon tool={tool} size={32} />
              <a class="row__link" href={`/tools/${tool.slug}`}>
                {tool.name}
              </a>
            </span>
            <p class="row__desc row__desc--phone">{tool.description ?? tool.note}</p>
          </td>
          <td class="cell cell--desc">
            <p class="row__desc">{tool.description ?? tool.note}</p>
          </td>
          {drop !== "category" && <td class="cell cell--category">{tool.category}</td>}
          {drop !== "verdict" && (
            <td class="cell cell--verdict">
              <VerdictBadge verdict={tool.verdict} />
            </td>
          )}
          <td class="cell cell--date">
            <time datetime={tool.status_date}>{formatDay(tool.status_date)}</time>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<PreviewCard />

<style>
  /* briOS's /stack, edge to edge: the table bleeds out of the shell's padding
     and its outer cells pad back by `--page-pad`, so names meet the title. */
  .table {
    width: calc(100% + 2 * var(--page-pad));
    margin-inline: calc(-1 * var(--page-pad));
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  /* Sticky under the bar. A `box-shadow` draws the rule because a collapsed
     border stays behind when a sticky cell moves. */
  .th {
    position: sticky;
    top: var(--bar-h);
    z-index: 1;
    padding: 0 1rem 0 0;
    background: var(--surface-2);
    box-shadow: inset 0 -1px 0 var(--hairline);
    color: var(--text-secondary);
    font-weight: 500;
    text-align: left;
    white-space: nowrap;
  }

  /* Under 1280px a one-span track is narrower than a date ("Aug 17, 2026" is
     88px), so the short columns take fixed widths. Every cell ends in 16px. */
  .th--name { width: 27%; }
  .th--category { width: 9.5rem; }
  .th--verdict { width: 7.5rem; }
  .th--date { width: calc(6.75rem + var(--page-pad)); }

  :is(.th, .cell):first-child { padding-left: var(--page-pad); }
  :is(.th, .cell):last-child { padding-right: var(--page-pad); }

  /* A control: `--text-secondary` (the ink floor), 40px tall (the hit floor;
     briOS's header row is 36). */
  .sort {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 40px;
    color: var(--text-secondary);
    font-weight: inherit;
    transition-property: color;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease);
  }

  .sort:hover,
  .th[aria-sort] .sort {
    color: var(--text-primary);
  }

  /* The arrow is drawn, with an empty accessible name: `aria-sort` on the
     header already says which way. */
  .th[aria-sort="ascending"] .sort__arrow::before { content: "\2191" / ""; }
  .th[aria-sort="descending"] .sort__arrow::before { content: "\2193" / ""; }

  /* --- one tool ----------------------------------------------------------- */

  .row {
    position: relative;
    transition-property: background-color;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease);
  }

  .row:hover { background: var(--surface-2); }

  /* `py-3`, briOS's 12px, and a 16px gap to the next column. */
  .cell {
    padding: 0.75rem 1rem 0.75rem 0;
    border-bottom: 1px solid var(--hairline);
    vertical-align: middle;
    color: var(--text-tertiary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .row__name { display: flex; align-items: center; gap: 0.75rem; }

  /* One line, briOS's `truncate font-medium`. */
  .row__link {
    min-width: 0;
    overflow: hidden;
    color: var(--text-primary);
    font-weight: 500;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The stretched link: the row is the target, the anchor is the one tab stop,
     and the focus ring goes round the row rather than round the name. */
  .row__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--r-lg);
  }

  .row__link:focus-visible { outline: none; }

  .row__link:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  /* One line in tertiary, briOS's; the whole note is on the tool's page. */
  .row__desc {
    overflow: hidden;
    white-space: nowrap;
    color: var(--text-tertiary);
    text-overflow: ellipsis;
  }

  /* The phone copy under the name: two lines, the listing clamp. */
  .row__desc--phone {
    display: none;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    padding: 0.25rem 0 0 calc(32px + 0.75rem);
    white-space: normal;
  }

  /* From 1280px, briOS's `grid-cols-12 gap-4 px-4` exactly (3/5/2/1/1). A fixed
     table ignores `calc(% + px)` widths, so columns are plain twelfths and the
     gaps are paid as padding that puts each content box where the grid does:
     track t = (W - 208px) / 12, Name 3t + 32 from 16px, Description 5t + 64. */
  @media (min-width: 1280px) {
    .th--name { width: 25%; }
    .th--category { width: 16.6667%; }
    .th--verdict, .th--date { width: 8.3333%; }

    .th--name, .cell--name { padding: 0 4px 0 16px; }
    .th--desc, .cell--desc { padding: 0 10.667px 0 12px; }
    .th--category, .cell--category { padding: 0 13.333px 0 5.333px; }
    .th--verdict, .cell--verdict { padding: 0 14.667px 0 2.667px; }
    .th--date, .cell--date { padding: 0 16px 0 1.333px; }
    .cell { padding-block: 0.75rem; }
  }

  /* Phone width, like briOS: icon and name with the description under them,
     then the verdict. Still a table: changing `display` on a tr or th strips
     table semantics in Safari, so columns are hidden, never restyled. The
     description column hides and its phone copy shows, so a screen reader
     meets one of the two at any width. Category and date, header and cell,
     live on the tool's page. */
  @media (max-width: 639px) {
    .th--desc,
    .th--category,
    .th--date,
    .cell--desc,
    .cell--category,
    .cell--date {
      display: none;
    }

    .th--name { width: auto; }
    .th--verdict { width: calc(6.5rem + var(--page-pad)); }
    .cell--name { white-space: normal; }
    .cell--verdict { vertical-align: top; }

    .row__desc--phone {
      display: -webkit-box;
    }
  }

  :global(html[data-tools-view="grid"]) .table {
    display: none;
  }
</style>

<script>
  import { isSortKey, nextSort, sortItems, type Sort } from "../lib/tools-table";

  let sort: Sort = null;
  const heads = document.querySelectorAll<HTMLElement>("th[data-sort-key]");

  for (const head of heads) {
    head.querySelector("button")?.addEventListener("click", () => {
      const key = head.dataset.sortKey;
      if (!isSortKey(key)) return;
      sort = nextSort(sort, key);

      for (const other of heads) {
        if (sort !== null && other === head) other.setAttribute("aria-sort", sort.direction);
        else other.removeAttribute("aria-sort");
      }

      // The table and the grid carry the same keys, so both views keep one order.
      for (const list of document.querySelectorAll("[data-tool-rows]")) {
        list.append(...sortItems([...list.children], sort, (item, name) => item.getAttribute(name) ?? ""));
      }
    });
  }
</script>
