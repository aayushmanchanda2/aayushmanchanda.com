---
/**
 * ToolList — the only place a tools list is rendered.
 *
 * `/tools` shows every entry under mono category headers (the
 * designengineer.tools model, where the category IS the navigation). The
 * verdict pages pass a subset and keep the headers; the category pages turn
 * them off, because there the h1 already says the category.
 *
 * One markup, two layouts. `/tools` sets `data-tools-view` on `<html>`
 * (`lib/tools-view.ts`), and `grid` turns each group's rows into cards. The
 * verdict and category pages never set it, so they are always the list.
 */
import { markFor } from "../lib/links";
import type { Tool } from "../lib/tools";
import { groupByCategory } from "../lib/tools";
import VerdictBadge from "./VerdictBadge.astro";
import { formatDay } from "../lib/date";

interface Props {
  tools: Tool[];
  grouped?: boolean;
}

const { tools, grouped = true } = Astro.props;

const groups = grouped
  ? groupByCategory(tools).map((group) => ({
      // Sentence case: the head is a label (design.md §2). The category stays
      // lowercase where it is a value, on an entry strip and in its route.
      heading: group.category.charAt(0).toUpperCase() + group.category.slice(1),
      tools: group.tools,
    }))
  : [{ heading: null, tools }];
---

<div class="list">
  {
    groups.map((group) => (
      <section class="group">
        {group.heading && (
          <h2 class="group__head mono">
            {group.heading}
            <span class="tabular-nums">{group.tools.length}</span>
          </h2>
        )}

        <ul class="group__rows">
          {group.tools.map((tool) => {
            const mark = markFor(tool);
            /*
              The product when there is one, the repository when there is not.
              A row is one link, and the one it should be is the place a reader
              would rather land: a page about the thing beats the source of it.
              Both are on the details page.
            */
            const href = tool.url ?? tool.repo;

            return (
            <li class="row">
              {mark.kind === "logo" ? (
                <img
                  class="row__mark outlined"
                  src={mark.src}
                  alt=""
                  width="28"
                  height="28"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                />
              ) : (
                /*
                  Decorative, so `aria-hidden`: the letter is the first letter
                  of the name sitting immediately beside it, and reading it out
                  would announce that letter twice.
                */
                <span class="row__mark row__mark--initial outlined mono" aria-hidden="true">
                  {mark.letter}
                </span>
              )}

              <span class="row__name">
                {href ? (
                  <a
                    class="row__link"
                    href={href}
                    rel="noopener nofollow"
                    target="_blank"
                  >
                    {tool.name}
                  </a>
                ) : (
                  tool.name
                )}
                <VerdictBadge verdict={tool.verdict} />
              </span>

              <span class="row__meta">
                <span class="row__date mono">
                  As of <time datetime={tool.status_date}>{formatDay(tool.status_date)}</time>
                </span>
                <a class="row__more mono" href={`/tools/${tool.slug}`}>
                  Details<span class="visually-hidden"> for {tool.name}</span>
                </a>
              </span>

              <p class="row__note">{tool.note}</p>
            </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</div>

<style>
  /* Sections are 2.5rem apart (design.md §2, the 8/16/40 rhythm). */
  .group + .group {
    margin-top: 2.5rem;
  }

  /* Same voice as "The mindscape" on the home page. The count is mono at the
     label's own size, which `global.css › .mono .tabular-nums` does. */
  .group__head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--text-tertiary);
  }

  .group__rows {
    margin-top: 1rem;
    border-top: 1px solid var(--hairline);
  }

  /* --- one tool ----------------------------------------------------------- */

  .row {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) auto;
    grid-template-areas:
      "mark name meta"
      ".    note meta";
    column-gap: 1rem;
    /* 8px inside a row, 16px either side of the rule between rows: design.md
       §2's rhythm */
    row-gap: 0.5rem;
    align-items: start;
    padding-block: 1rem;
    border-bottom: 1px solid var(--hairline);
    transition-property: border-color;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease);
  }

  .row:hover {
    border-bottom-color: var(--hairline-strong);
  }

  /* 28px, up from 16: ui-skills pairs a 40px logo with 14px text, and at 16
     beside a 17px name the logo was a speck. Centred on the name's first line
     box (17px × 1.35): the negative margins overhang it equally above and
     below, so the mark takes exactly one line of the track and the note under
     the name does not move down to make room for it. */
  .row__mark {
    grid-area: mark;
    width: 28px;
    height: 28px;
    margin-block: calc((1.0625rem * 1.35 - 28px) / 2);
    border-radius: 6px;
  }

  /* The mark for a tool with no product site: its own initial, not a borrowed
     logo. A repository-only row could show its GitHub owner's avatar instead,
     and deliberately does not — `lib/links.ts › markFor` has the reasoning and
     /privacy is the reason.

     The letter is stored in the name's own case (`lib/links.ts › markFor`)
     and capitalised here: an initial is a mark, not a word in the label voice,
     so it keeps the capital the uppercase mono label used to give it. */
  .row__mark--initial {
    display: grid;
    place-items: center;
    background: var(--dot);
    color: var(--text-secondary);
    /* 12px in a 28px box: the 9-in-16 it was, scaled with the box, and still
       well under the 17px name beside it. */
    font-size: 0.75rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .row__name {
    grid-area: name;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.65rem;
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .row__link {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: var(--hairline-strong);
  }

  .row__link:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  /* Two lines, the same cap `LibraryList.astro › .row__note` takes and for the
     same reason: a listing row is scanned, and the overflow has a page to live
     on. `details` at the end of the meta column is that page, and a tool's note
     renders whole on it.

     It costs this list almost nothing today — the longest note in
     `data/tools.json` is 169 characters, which is two lines at this measure —
     and that is the point of putting it here rather than waiting: the cap is
     what stops the twentieth verdict from being the one that quietly turns the
     directory into a page of paragraphs. */
  .row__note {
    grid-area: note;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .row__meta {
    grid-area: meta;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    /* optical: line the date up with the name, not the row box */
    padding-top: 0.2rem;
  }

  .row__date {
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  /* Carries its own underline: on touch there is no hover to reveal one, and
     a bare word next to the date would read as a second label. --text-secondary,
     not the date's --text-tertiary: this is a control (design.md §4, the ink floor). */
  .row__more {
    color: var(--text-secondary);
    text-decoration-line: underline;
    text-decoration-color: var(--hairline-strong);
  }

  .row:hover .row__more,
  .row__more:hover {
    color: var(--accent);
  }

  .row__more:hover {
    text-decoration-color: currentColor;
  }

  @media (max-width: 639px) {
    .row {
      grid-template-columns: 28px minmax(0, 1fr);
      grid-template-areas:
        "mark name"
        ".    note"
        ".    meta";
      row-gap: 0.5rem;
    }

    .row__meta {
      flex-direction: row;
      align-items: baseline;
      gap: 0.9rem;
      padding-top: 0.1rem;
    }
  }

  /* --- grid view ---------------------------------------------------------- */

  /* The same rows as cards, flowed the way `SiteGrid.astro › .grid` flows its
     shots: as many 15rem columns as fit, one at 375px. The category heads stay
     where they are; only each group's rows become a grid. Every rule is under
     the `<html>` attribute, so the list above is the whole of the default. */
  :global(html[data-tools-view="grid"]) .group__rows {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 16px;
    border-top: 0;
  }

  /* Logo, name and verdict, note, then the meta pinned to the foot: the note
     track takes the slack, so dates line up across a row of unequal cards. */
  :global(html[data-tools-view="grid"]) .row {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto 1fr auto;
    grid-template-areas:
      "mark"
      "name"
      "note"
      "meta";
    row-gap: 0.5rem;
    padding: 16px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
  }

  :global(html[data-tools-view="grid"]) .row:hover {
    border-color: var(--hairline-strong);
  }

  /* 40px and --r-md: the 6-on-28 of the list, scaled, lands on the 8px token
     rather than a new radius. */
  :global(html[data-tools-view="grid"]) .row__mark {
    width: 40px;
    height: 40px;
    margin: 0 0 0.25rem;
    border-radius: var(--r-md);
  }

  :global(html[data-tools-view="grid"]) .row__mark--initial {
    font-size: 1rem;
  }

  /* SiteGrid's card title size: a card is narrower than a row. */
  :global(html[data-tools-view="grid"]) .row__name {
    font-size: 0.9375rem;
  }

  :global(html[data-tools-view="grid"]) .row__note {
    align-self: start;
    font-size: 0.875rem;
  }

  :global(html[data-tools-view="grid"]) .row__meta {
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
    padding-top: 0.5rem;
  }
</style>
