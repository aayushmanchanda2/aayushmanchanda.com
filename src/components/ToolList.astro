---
/**
 * ToolList — the only place a tools list is rendered.
 *
 * `/tools` shows every entry under mono category headers (the
 * designengineer.tools model, where the category IS the navigation). The
 * verdict pages pass a subset and keep the headers; the category pages turn
 * them off, because there the h1 already says the category.
 */
import { markFor } from "../lib/links";
import type { Tool } from "../lib/tools";
import { groupByCategory } from "../lib/tools";
import VerdictBadge from "./VerdictBadge.astro";

interface Props {
  tools: Tool[];
  grouped?: boolean;
}

const { tools, grouped = true } = Astro.props;

const groups = grouped
  ? groupByCategory(tools).map((group) => ({
      heading: group.category,
      tools: group.tools,
    }))
  : [{ heading: null, tools }];
---

<div class="list">
  {
    groups.map((group) => (
      <section class="group">
        {group.heading && (
          <h2 class="group__head mono">
            {group.heading}
            <span class="group__count tabular-nums">{group.tools.length}</span>
          </h2>
        )}

        <ul class="group__rows">
          {group.tools.map((tool) => {
            const mark = markFor(tool);
            /*
              The product when there is one, the repository when there is not.
              A row is one link, and the one it should be is the place a reader
              would rather land: a page about the thing beats the source of it.
              Both are on the details page.
            */
            const href = tool.url ?? tool.repo;

            return (
            <li class="row">
              {mark.kind === "logo" ? (
                <img
                  class="row__mark outlined"
                  src={mark.src}
                  alt=""
                  width="16"
                  height="16"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                />
              ) : (
                /*
                  Decorative, so `aria-hidden`: the letter is the first letter
                  of the name sitting immediately beside it, and reading it out
                  would announce that letter twice.
                */
                <span class="row__mark row__mark--initial outlined mono" aria-hidden="true">
                  {mark.letter}
                </span>
              )}

              <span class="row__name">
                {href ? (
                  <a
                    class="row__link"
                    href={href}
                    rel="noopener nofollow"
                    target="_blank"
                  >
                    {tool.name}
                  </a>
                ) : (
                  tool.name
                )}
                <VerdictBadge verdict={tool.verdict} />
              </span>

              <span class="row__meta">
                <span class="row__date mono tabular-nums">
                  as of {tool.status_date}
                </span>
                <a class="row__more mono" href={`/tools/${tool.slug}`}>
                  details<span class="visually-hidden"> for {tool.name}</span>
                </a>
              </span>

              <p class="row__note">{tool.note}</p>
            </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .group + .group {
    margin-top: clamp(2.75rem, 7vw, 4rem);
  }

  /* Same voice as "THE MINDSCAPE" on the home page. */
  .group__head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    color: var(--faint);
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .group__count {
    font-size: 0.625rem;
  }

  .group__rows {
    margin-top: 1rem;
    border-top: 1px solid var(--hairline);
  }

  /* --- one tool ----------------------------------------------------------- */

  .row {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr) auto;
    grid-template-areas:
      "mark name meta"
      ".    note meta";
    column-gap: 1rem;
    row-gap: 0.3rem;
    align-items: start;
    padding-block: clamp(1rem, 2.2vw, 1.25rem);
    border-bottom: 1px solid var(--hairline);
    transition-property: border-color;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease);
  }

  .row:hover {
    border-bottom-color: var(--hairline-strong);
  }

  .row__mark {
    grid-area: mark;
    width: 16px;
    height: 16px;
    /* sits on the cap height of the name rather than its line box */
    margin-top: 0.25rem;
    border-radius: 3px;
  }

  /* The mark for a tool with no product site: its own initial, not a borrowed
     logo. A repository-only row could show its GitHub owner's avatar instead,
     and deliberately does not — `lib/links.ts › markFor` has the reasoning and
     /privacy is the reason.

     `letter-spacing: 0` undoes the `.mono` label tracking, which on a single
     centred glyph is not tracking at all: it is 0.08em of padding on the right
     only, and it lands the letter visibly left of centre in a 16px box. */
  .row__mark--initial {
    display: grid;
    place-items: center;
    background: var(--dot);
    color: var(--muted);
    /* 9px, not the label's 11px: the box is 16px and the name beside it is
       17px, so a mark set at label size shouts over both. */
    font-size: 0.5625rem;
    line-height: 1;
    letter-spacing: 0;
  }

  .row__name {
    grid-area: name;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.65rem;
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .row__link {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: var(--hairline-strong);
  }

  .row__link:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  /* Two lines, the same cap `LibraryList.astro › .row__note` takes and for the
     same reason: a listing row is scanned, and the overflow has a page to live
     on. `details` at the end of the meta column is that page, and a tool's note
     renders whole on it.

     It costs this list almost nothing today — the longest note in
     `data/tools.json` is 169 characters, which is two lines at this measure —
     and that is the point of putting it here rather than waiting: the cap is
     what stops the twentieth verdict from being the one that quietly turns the
     directory into a page of paragraphs. */
  .row__note {
    grid-area: note;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .row__meta {
    grid-area: meta;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
    /* optical: line the date up with the name, not the row box */
    padding-top: 0.2rem;
  }

  .row__date {
    color: var(--faint);
    white-space: nowrap;
  }

  /* Carries its own underline: on touch there is no hover to reveal one, and
     a bare mono word next to the date would read as a second label. --muted,
     not the date's --faint: this is a control (design.md §4, the ink floor). */
  .row__more {
    color: var(--muted);
    text-decoration-line: underline;
    text-decoration-color: var(--hairline-strong);
  }

  .row:hover .row__more,
  .row__more:hover {
    color: var(--accent);
  }

  .row__more:hover {
    text-decoration-color: currentColor;
  }

  @media (max-width: 639px) {
    .row {
      grid-template-columns: 1.5rem minmax(0, 1fr);
      grid-template-areas:
        "mark name"
        ".    note"
        ".    meta";
      row-gap: 0.45rem;
    }

    .row__meta {
      flex-direction: row;
      align-items: baseline;
      gap: 0.9rem;
      padding-top: 0.1rem;
    }
  }
</style>
