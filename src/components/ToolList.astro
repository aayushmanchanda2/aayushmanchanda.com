---
/**
 * ToolList — the /tools table, and the only place one is rendered.
 *
 * briOS's /stack table: Name (icon and name), Description, Category, Verdict,
 * Date. Every row is one link to the tool's own page: a real `<a>` on the name,
 * stretched over the row by its `::after`, so the keyboard gets one stop per
 * row and a right click still offers "open in new tab". The sort buttons sit in
 * a header that sticks under the top bar.
 *
 * `/tools` puts filters and a grid view (`ToolGrid.astro`) around it; the
 * verdict and category pages render their subset. Rows keep file order until a
 * header is pressed (`lib/tools-table.ts`).
 */
import AppIcon from "./AppIcon.astro";
import PreviewCard from "./PreviewCard.astro";
import VerdictBadge from "./VerdictBadge.astro";
import { formatDay } from "../lib/date";
import type { Tool } from "../lib/tools";
import { toolAttributes } from "../lib/tools";
import type { SortKey } from "../lib/tools-table";

interface Props {
  tools: Tool[];
  /** The column a filter page already states in its h1: one value on every row. */
  drop?: "category" | "verdict";
}

const { tools, drop } = Astro.props;

const ALL: { id: string; label: string; sort: SortKey | null }[] = [
  { id: "name", label: "Name", sort: "name" },
  { id: "desc", label: "Description", sort: null },
  { id: "category", label: "Category", sort: "category" },
  { id: "verdict", label: "Verdict", sort: "verdict" },
  { id: "date", label: "Date", sort: "date" },
];
const COLUMNS = ALL.filter((column) => column.id !== drop);
---

<table class="table">
  <thead class="thead">
    <tr class="head">
      {
        COLUMNS.map((column) => (
          <th scope="col" class={`th th--${column.id}`} data-sort-key={column.sort}>
            {column.sort ? (
              <button class="sort" type="button">
                {column.label}
                <span class="sort__arrow" />
              </button>
            ) : (
              column.label
            )}
          </th>
        ))
      }
    </tr>
  </thead>
  <tbody data-tool-rows>
    {
      tools.map((tool) => (
        <tr class="row" {...toolAttributes(tool)}>
          <td class="cell cell--name">
            <span class="row__name">
              <AppIcon tool={tool} size={32} />
              <a class="row__link" href={`/tools/${tool.slug}`}>
                {tool.name}
              </a>
            </span>
          </td>
          <td class="cell cell--desc">
            <p class="row__desc">{tool.description ?? tool.note}</p>
          </td>
          {drop !== "category" && <td class="cell cell--category">{tool.category}</td>}
          {drop !== "verdict" && (
            <td class="cell cell--verdict">
              <VerdictBadge verdict={tool.verdict} />
            </td>
          )}
          <td class="cell cell--date">
            <time datetime={tool.status_date}>{formatDay(tool.status_date)}</time>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<PreviewCard />

<style>
  .table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  /* Sticks under the 56px bar. A `box-shadow` rather than a border draws the
     rule, because a collapsed border stays behind when a sticky cell moves. */
  .th {
    position: sticky;
    top: var(--bar-h);
    z-index: 1;
    padding: 0 0.75rem 0 0;
    background: var(--bg);
    box-shadow: inset 0 -1px 0 var(--hairline);
    color: var(--text-tertiary);
    font-weight: 400;
    text-align: left;
    white-space: nowrap;
  }

  .th--name { width: 27%; padding-left: 0.25rem; }
  .th--category { width: 8.5rem; }
  .th--verdict { width: 6.5rem; }
  .th--date { width: 6.75rem; padding-right: 0; }

  /* A control, so `--text-secondary` and never the tertiary of a label
     (design.md §4, the ink floor). 40px tall: the whole header cell presses. */
  .sort {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 40px;
    color: var(--text-secondary);
    transition-property: color;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease);
  }

  .sort:hover,
  .th[aria-sort] .sort {
    color: var(--text-primary);
  }

  /* The arrow is drawn, with an empty accessible name: `aria-sort` on the
     header already says which way. */
  .th[aria-sort="ascending"] .sort__arrow::before { content: "\2191" / ""; }
  .th[aria-sort="descending"] .sort__arrow::before { content: "\2193" / ""; }

  /* --- one tool ----------------------------------------------------------- */

  .row {
    position: relative;
    transition-property: background-color;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease);
  }

  .row:hover {
    background: var(--surface-2);
  }

  .cell {
    padding: 0.625rem 0.75rem 0.625rem 0;
    border-bottom: 1px solid var(--hairline);
    vertical-align: middle;
    color: var(--text-tertiary);
  }

  .cell--date { padding-right: 0; white-space: nowrap; }
  .cell--name { padding-left: 0.25rem; }

  .row__name {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .row__link {
    min-width: 0;
    color: var(--text-primary);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.35;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  /* The stretched link: the row is the target, the anchor is the one tab stop,
     and the focus ring goes round the row rather than round the name. */
  .row__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--r-lg);
  }

  .row__link:focus-visible {
    outline: none;
  }

  .row__link:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  /* Two lines, the listing clamp: the whole note is on the tool's page. */
  .row__desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Stacked at phone width, like briOS: icon, name and verdict on one line,
     the description under the name. Category and date live on the tool's page.
     The header keeps the sort buttons as one row. */
  @media (max-width: 639px) {
    /* A flex row cannot keep a sticky cell inside it, so the head sticks. */
    .thead {
      position: sticky;
      top: var(--bar-h);
      z-index: 1;
      background: var(--bg);
    }

    .head {
      display: flex;
      gap: 1.25rem;
      box-shadow: inset 0 -1px 0 var(--hairline);
    }

    .th {
      position: static;
      width: auto;
      padding: 0;
      background: none;
      box-shadow: none;
    }

    .th--desc {
      display: none;
    }

    .row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "name verdict"
        "desc desc";
      column-gap: 0.75rem;
      padding-block: 0.75rem;
      border-bottom: 1px solid var(--hairline);
    }

    .row[hidden] {
      display: none;
    }

    .cell {
      padding: 0;
      border: 0;
    }

    .cell--name { grid-area: name; padding-left: 0; }
    .cell--verdict { grid-area: verdict; align-self: center; }
    .cell--desc { grid-area: desc; padding: 0.25rem 0 0 calc(32px + 0.75rem); }

    .cell--category,
    .cell--date {
      display: none;
    }
  }

  :global(html[data-tools-view="grid"]) .table {
    display: none;
  }
</style>

<script>
  import { isSortKey, nextSort, sortItems, type Sort } from "../lib/tools-table";

  let sort: Sort = null;
  const heads = document.querySelectorAll<HTMLElement>("th[data-sort-key]");

  for (const head of heads) {
    head.querySelector("button")?.addEventListener("click", () => {
      const key = head.dataset.sortKey;
      if (!isSortKey(key)) return;
      sort = nextSort(sort, key);

      for (const other of heads) {
        if (sort !== null && other === head) other.setAttribute("aria-sort", sort.direction);
        else other.removeAttribute("aria-sort");
      }

      // The table and the grid carry the same keys, so both views keep one order.
      for (const list of document.querySelectorAll("[data-tool-rows]")) {
        list.append(...sortItems([...list.children], sort, (item, name) => item.getAttribute(name) ?? ""));
      }
    });
  }
</script>
