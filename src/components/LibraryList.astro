---
/**
 * LibraryList — the only place the library list is rendered.
 *
 * `/library` shows everything; the two filter routes pass a subset. The domain
 * filter page turns the domain column off, because there the h1 already says
 * the domain and repeating it on every row would be the page telling a reader
 * something they came in knowing. Same call `ToolList` makes about its category
 * headers, for the same reason.
 *
 * The row is the /tools row anatomy with the favicon column removed. A tools
 * list is a list of products, and a mark is how you recognise one at a glance;
 * the library is mostly four hosts, so the same column would have been three
 * identical YouTube marks stacked down the page, plus a third-party request per
 * row to fetch them. The domain in mono does that job here and does it in text.
 *
 * **The title goes to the entry's own page, and the row keeps a way out.**
 * Every entry has a page since VET-63, so the title stops leaving — but a
 * library index is a directory, and scanning one and pressing straight through
 * to the thing is how it is actually read. Taking that away would have made
 * the detail page a toll rather than a destination. So the meta column carries
 * a `source` link, off-site, wearing the `.ext` arrow because it is now the one
 * control on the row that leaves and the arrow is the thing that says so
 * (design.md §5). Detail primacy, not exclusivity.
 *
 * The hostname above it keeps pointing at `/library/domain/<host>`. It is the
 * only entrance to those pages from a list, and a filter and a destination are
 * two different offers: one narrows this page, the other ends it.
 *
 * Where the title goes is not written here. `lib/library.ts › entryHref` owns
 * it, and the post card and the video tile read the same function, so the three
 * cannot drift.
 *
 * One page renders posts as cards instead of rows: `/library/kind/post`, which
 * hands the same entries to `PostWall.astro`. Everything else on /library is
 * this list, including the posts on the index.
 */
import KindChip from "./KindChip.astro";
import TagChips from "./TagChips.astro";
import { routeSlug } from "../lib/parse";
import type { LibraryEntry } from "../lib/library";
import { entryHref } from "../lib/library";

interface Props {
  entries: LibraryEntry[];
  /** Off on the domain filter page, where the h1 is already the domain. */
  showDomain?: boolean;
}

const { entries, showDomain = true } = Astro.props;

/**
 * The tags column is drawn only where something fills it.
 *
 * Most saves arrive tagged, but tagging happens in Raindrop and not in the
 * parser, so a filtered page can hold nothing but untagged rows — and a column
 * of empty cells is furniture claiming a third of the row's width for a value
 * the page does not have. Same honest-absence rule the section index runs on,
 * one grain smaller.
 *
 * Note that this is deliberately not the call `showDomain` makes. The domain
 * column goes off on the domain page because the h1 already says the one value
 * every row would repeat; the tag page keeps its column, because a tag cell is
 * a set and dropping it would take the *other* tags with it — and those are the
 * only thing on that page pointing anywhere the reader has not already been.
 */
const anyTags = entries.some((entry) => entry.tags.length > 0);
---

<ul class:list={["list", anyTags && "list--tags"]}>
  {
    entries.map((entry) => (
      /*
       * The slug as an id, kept now that it is no longer load-bearing.
       *
       * It was the command palette's answer for a row with no page: the
       * palette would not eject a reader to a third-party site from a
       * navigation control, so it sent them to `/library#slug` and the row in
       * context. Every entry has a real page now and the palette sends them
       * there (`lib/search-index.ts`), which leaves the id doing what an id on
       * a list row does anywhere: it is somewhere a link can point.
       *
       * Unique per page: the three filter routes render subsets of the same
       * list, and a slug appears at most once in any of them.
       */
      <li class="row" id={entry.slug}>
        <span class="row__name">
          {/*
            The entry's own page, on every row, with no `rel` and no new tab
            because it does not leave. `lib/library.ts › entryHref` is where
            that is decided, and the post card and the video tile read it too.
          */}
          <a class="row__link" href={entryHref(entry)}>
            {entry.title}
          </a>
          <KindChip kind={entry.kind} />
        </span>

        {entry.tags.length > 0 && (
          <div class="row__tags">
            <TagChips tags={entry.tags} />
          </div>
        )}

        <span class="row__meta">
          {showDomain && (
            <a
              class="row__domain mono"
              href={`/library/domain/${routeSlug(entry.domain)}`}
            >
              {entry.domain}
            </a>
          )}
          {/*
            The way out, and the only thing on the row that leaves. The visible
            word is `source` on every row, which is the right label for a
            control and the wrong accessible name in a list of forty of them, so
            the title rides along where only a screen reader hears it.
          */}
          <a
            class="row__source mono ext"
            href={entry.url}
            rel="noopener nofollow"
            target="_blank"
          >
            source<span class="visually-hidden">: {entry.title}</span>
          </a>
          <span class="row__date mono tabular-nums">{entry.saved_date}</span>
        </span>

        {entry.note && <p class="row__note">{entry.note}</p>}
      </li>
    ))
  }
</ul>

<style>
  .list {
    border-top: 1px solid var(--hairline);
  }

  .row {
    /* Arriving from /library#slug, the row should not sit flush against the
       top edge of the window. */
    scroll-margin-block: 5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "name meta"
      "note meta";
    column-gap: 1rem;
    row-gap: 0.3rem;
    align-items: start;
    padding-block: clamp(1rem, 2.2vw, 1.25rem);
    border-bottom: 1px solid var(--hairline);
    transition-property: border-color;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease);
  }

  .row:hover {
    border-bottom-color: var(--hairline-strong);
  }

  /* The tags line sits directly under the title, above the note: it is part of
     what the row *is*, the way the kind chip on the title line is, while the
     note is a sentence about it and the meta column is metadata. */
  .list--tags .row {
    grid-template-areas:
      "name meta"
      "tags meta"
      "note meta";
  }

  /* The database column, and the reason /library is a wide page.
     Above 900px — the site's one structural breakpoint, where the rail arrives
     and the shell has room — the tags stop being a third line and become a
     column, which is what makes twenty rows scannable by subject instead of
     readable one at a time. 13rem is the widest pair in the list measured, 201px
     for `founders` and `go to market`, plus a little air. A fixed width rather
     than `auto` because every row is its own grid: an `auto` column would start
     at a different x on every row, and a column with a ragged left edge is a
     column you cannot run your eye down. A pair too wide for it wraps to a
     second line, which `TagChips.astro` has already spaced for. */
  @media (min-width: 900px) {
    .list--tags .row {
      grid-template-columns: minmax(0, 1fr) 13rem auto;
      grid-template-areas:
        "name tags meta"
        "note tags meta";
    }
  }

  .row__tags {
    grid-area: tags;
    /* optical: line the first chip up with the title, not the row box */
    padding-top: 0.15rem;
  }

  .row__name {
    grid-area: name;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.65rem;
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .row__link {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: var(--hairline-strong);
  }

  .row__link:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  /* Two lines, and the rest is on the entry's own page.
     A row's note runs to 295 characters here, because a saved post's note is
     the post's own first 280 (`pipeline/entries.mjs › POST_NOTE_MAX`), and at
     this measure that is five lines under a one-line title. Twenty of those is
     a page you read rather than a directory you scan, which is Aayush's call
     on the shipped list and the reason for the clamp.

     **This is not the clamp `lib/post.ts` refuses, and the difference is what
     is behind it.** That one would have hidden 31,000 characters from the eye
     while still shipping every one of them inside the card's own anchor, whose
     accessible name is its text: clamped visually and endless aurally is
     design.md §7's parity rule pointing the wrong way. This hides at most three
     lines of a sentence that is already a summary, in a `<p>` that is not
     inside any link, on a row whose title goes to a page carrying the same note
     whole as its standfirst. Nobody is being shown less than they can reach.

     Two rather than one: a note here is one sentence about why the thing was
     saved, and cutting most of them mid-clause would leave a column of
     fragments. Two lines is where the long ones stop and the short ones are
     untouched. */
  .row__note {
    grid-area: note;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
    /* A note about a post is the post's own first 280 characters, and a post is
       full of links with no word boundary in them. One of them — a YouTube
       watch URL with three query parameters — is 178px wider than a 375px
       column on its own, and an unbreakable token does not overflow its
       paragraph quietly: it widens the **document**, and then the palette sheet
       and the MENU panel lay out at that width too. Same declaration
       `TweetCard.astro › .card__text` carries, for the same reason. */
    overflow-wrap: anywhere;
  }

  .row__meta {
    grid-area: meta;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
    /* optical: line the domain up with the title, not the row box */
    padding-top: 0.2rem;
  }

  /* Carries its own underline: on touch there is no hover to reveal one, and a
     bare mono hostname next to the date would read as a second label rather
     than as the way into that host's page. */
  /* Never wrapped, and deliberately uncapped.
     A hostname has no word boundaries a browser can find, so any width limit
     breaks it mid-token — `gumclaw.github.io` split across two lines as
     `GUMCLAW.GITH` / `UB.IO`, which reads as a rendering bug rather than as a
     wrap. The meta column is `auto` and the title column is `minmax(0, 1fr)`,
     so letting the domain take its natural width costs the title a little room
     and costs the row nothing. */
  .row__domain {
    /* --muted, not the date's --faint: this is a control (design.md §4, the
       ink floor). */
    color: var(--muted);
    text-decoration-line: underline;
    text-decoration-color: var(--hairline-strong);
    white-space: nowrap;
    text-align: right;
  }

  .row:hover .row__domain,
  .row__domain:hover {
    color: var(--accent);
  }

  .row__domain:hover {
    text-decoration-color: currentColor;
  }

  /* The quiet pattern, same as the domain above it: `--muted` because it is a
     control (design.md §4, the ink floor), and its own underline because on
     touch there is no hover to reveal one.

     Deliberately outside the `.row:hover` accent the domain takes. Two things
     lighting up when a pointer crosses the row would say the row has two
     primary destinations, and it has one: the title. This one is the door, and
     it colours when you are actually on it.

     No 40px block, which is design.md §4's stated exception for text: this is a
     word in a column of words, sitting the same distance from its neighbours as
     the domain and the date already sit from each other, and a toolbar-sized
     box around it would put a toolbar into every row. */
  .row__source {
    color: var(--muted);
    text-decoration-line: underline;
    text-decoration-color: var(--hairline-strong);
    white-space: nowrap;
    text-align: right;
  }

  .row__source:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .row__date {
    color: var(--faint);
    white-space: nowrap;
  }

  @media (max-width: 639px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "name"
        "note"
        "meta";
      row-gap: 0.45rem;
    }

    /* Same order the two-column form uses, stacked: title, what it is about,
       what I said about it, when it arrived. */
    .list--tags .row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "name"
        "tags"
        "note"
        "meta";
    }

    /* The column becomes a line, and the line has to be allowed to break.
       Three items now — the host, the way out, and the date — and a long
       hostname puts them past a 287px phone column: `thealgorithmicbridge.com`
       alone is over half of it. An unwrapped flex row does not overflow its
       own box quietly, it widens the **document**, and then every fixed
       surface on the page (the palette sheet, the MENU panel) lays out at that
       width too. Same call `.foot__meta` and the tab row make, for the same
       reason. */
    .row__meta {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: flex-start;
      gap: 0.35rem 0.9rem;
      padding-top: 0.1rem;
    }

    .row__domain,
    .row__source {
      text-align: left;
    }
  }
</style>
