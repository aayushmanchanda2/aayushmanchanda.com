---
/**
 * ImageFrame — the ShotFrame treatment for an image we did not shoot.
 *
 * Same graph-paper backdrop, hairline border, sharp corners, and 1px optical
 * outline as the /sites frame, so a whiteboard photo on a note and a screenshot
 * on a gallery card read as the same furniture.
 *
 * What it does not do is reserve the box. ShotFrame reserves its own in CSS —
 * by `aspect-ratio` on a card, by the scroller's fixed height on a details page
 * — because every shot is a full-page capture of unknown height. A scratch note
 * is whatever came off a phone camera, and cropping it to a ratio would crop
 * someone's handwriting, so the frame lets the image keep its own proportions
 * and caps its height instead. The trade is a small layout shift on first
 * paint, and it is the right way round.
 */
interface Props {
  /** Web path under /notes. */
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<span class="frame dotted-grid dotted-grid--fine">
  <img
    class="frame__image outlined"
    src={src}
    alt={alt}
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
</span>

<style>
  .frame {
    display: block;
    padding: 8px;
    background-color: var(--bg);
    border: 1px solid var(--hairline);
    /* Sharp corners, same as the /sites frame. */
    border-radius: 0;
  }

  .frame__image {
    display: block;
    width: auto;
    /* Tall photos should not push the caption off the screen. */
    max-height: 78svh;
    margin-inline: auto;
    border-radius: 0;
    background-color: var(--bg);
  }
</style>
