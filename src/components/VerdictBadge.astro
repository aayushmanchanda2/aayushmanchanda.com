---
/**
 * VerdictBadge — a /tools verdict, rendered as a chip.
 *
 * The colours used to live here. They moved to `.chip` in styles/chip.css when
 * /experiments needed the same treatment for its statuses, so the tints,
 * hairlines, and dark-mode inks are now defined once for both sections.
 * What is left is the only thing that was ever specific to /tools: which
 * tone a verdict earns.
 *
 * Rendered output is unchanged — same element shape, same words, same hues.
 */
import type { Verdict } from "../lib/tools";

/** Exhaustive by type: a new verdict will not compile until it has a tone. */
const TONES: Record<Verdict, string> = {
  using: "green",
  watching: "amber",
  "on-hold": "gray",
  skipped: "red",
};

interface Props {
  verdict: Verdict;
}

const { verdict } = Astro.props;
---

<span class="chip" data-tone={TONES[verdict]}>{verdict}</span>
