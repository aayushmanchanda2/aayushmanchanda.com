---
/**
 * SiteFoundations — a saved site's design tokens, as things you can take: a
 * port of ui-skills' `design-md-foundations.astro` in our shape (sans labels,
 * mono values, hairline rows, design.md §3), with "Copy as DESIGN.md" for its
 * source pane. A closed `<details>` (VET-242) whose summary names the groups.
 * Copy and "Show all N" are `lib/site-detail.ts` and `lib/copy-flash.ts`; the
 * groups are `lib/foundations.ts`. Inline styles may interpolate tokens
 * because `lib/design-md.ts › parseDesign` holds their shape.
 */
import type { SiteDesign } from "../lib/design-md";
import { toDesignMd } from "../lib/design-md";
import { formatDay } from "../lib/date";
import { PROPERTIES, SPECIMEN_MAX, familiesOf, foundationGroups, specimenFamily } from "../lib/foundations";

interface Props {
  design: SiteDesign;
  /** The site's title and domain, for the DESIGN.md name and Overview line. */
  title: string;
  domain: string;
}

const { design, title, domain } = Astro.props;
const markdown = toDesignMd(design, { title, domain });

const groups = foundationGroups(design);
const familyList = familiesOf(design);
---

<details class="found" data-copy-root>
  <summary class="found__summary">
    <h2 class="found__title mono">Design</h2>
    <span class="found__groups">{groups.map((group) => group.head).join(", ")}</span>
    <span class="found__chevron" aria-hidden="true"></span>
  </summary>
  <div class="found__head">
    <p class="found__note">Read from {domain} on <time datetime={design.read_date}>{formatDay(design.read_date)}</time>.</p>
    <button type="button" class="found__md mono press" data-copy={markdown} data-copy-name="DESIGN.md">
      <span data-copy-label aria-hidden="true">Copy as DESIGN.md</span>
      <span class="visually-hidden">Copy {title}'s tokens as DESIGN.md</span>
    </button>
  </div>

  {
    groups.map((group) => (
      <div class="group">
        <h3 class="group__head mono">{group.head}</h3>
        {group.head === "Typography" ? (
          <>
            <p class="found__note">Rendered in your fallback if {familyList} isn't installed.</p>
            <ul class="styles" id={group.id}>
              {design.type.map((style, index) => (
                <li class="style" data-tail={index >= group.cap ? "" : undefined}>
                  <div class="style__specimen">
                    <span class="style__aa" aria-hidden="true" style={`font-family: ${specimenFamily(style.fontFamily, style.name)}; font-size: min(${style.fontSize}, ${SPECIMEN_MAX}); font-weight: ${style.fontWeight}; letter-spacing: ${style.letterSpacing};`}>Aa</span>
                    <span class="style__name">{style.name}</span>
                  </div>
                  <ul class="rows">
                    {PROPERTIES.map(([key, label]) => (
                      <li>
                        <button type="button" class="row row--prop" data-copy={style[key]} aria-label={`Copy ${style.name} ${label.toLowerCase()} ${style[key]}`}>
                          <span class="row__name">{label}</span>
                          <span class="row__value" data-copy-label aria-hidden="true">{style[key]}</span>
                        </button>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <ul class="rows" id={group.id}>
            {group.rows.map((row, index) => (
              <li data-tail={index >= group.cap ? "" : undefined}>
                <button type="button" class="row" data-copy={row.value} aria-label={`Copy ${group.head.toLowerCase()} ${row.name} ${row.value}`}>
                  <span class="row__visual">
                    <span class={group.visual} style={row.paint} aria-hidden="true" />
                  </span>
                  <span class="row__name">{row.name}</span>
                  <span class="row__value" data-copy-label aria-hidden="true">{row.value}</span>
                </button>
              </li>
            ))}
          </ul>
        )}
        {group.count > group.cap && (
          <button type="button" class="tag tag--more" data-more hidden aria-expanded="false" aria-controls={group.id} data-label={`Show all ${group.count}`}>Show all {group.count}</button>
        )}
      </div>
    ))
  }

  <p class="visually-hidden" role="status" data-copy-status></p>
</details>

<style>
  /* 40px above, the section rhythm (design.md §2). Each token group is a
     section of its own, so the groups sit 40px apart too; 8px inside one. */
  .found,
  .group {
    margin-top: 2.5rem;
  }

  /* The whole row is the toggle, 40px tall, the hit floor. */
  .found__summary {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-height: 40px;
    padding-block: 0.625rem;
    border-bottom: 1px solid var(--hairline);
    list-style: none;
    cursor: pointer;
  }

  .found__summary::-webkit-details-marker {
    display: none;
  }

  .found__groups {
    flex: 1;
    min-width: 0;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  /* A chevron drawn from two borders, pointing down, flipping up when open. */
  .found__chevron {
    width: 7px;
    height: 7px;
    margin-right: 0.25rem;
    border-right: 1.5px solid var(--text-secondary);
    border-bottom: 1.5px solid var(--text-secondary);
    transform: translateY(-2px) rotate(45deg);
    transition-property: transform;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease);
  }

  .found[open] .found__chevron {
    transform: translateY(1px) rotate(-135deg);
  }

  @media (hover: hover) {
    .found__summary:hover .found__chevron {
      border-color: var(--text-primary);
    }
  }

  .found__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  /* ShotActions' `.act`: a housekeeping control at --text-secondary, 40px tall. */
  .found__md {
    min-height: 40px;
    padding-inline: 0.5rem;
    margin-right: -0.5rem;
    color: var(--text-secondary);
    cursor: pointer;
  }

  .found__note,
  .style__name,
  .group__head {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  .group > .found__note,
  .group > .rows,
  .styles,
  .tag--more {
    margin-top: 0.5rem;
  }

  .rows {
    border-top: 1px solid var(--hairline);
  }

  /* The facts table's columns (global.css › .fact): 7rem for the picture of
     the token, then its name, then the value you copy. 40px tall, the floor. */
  .row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    width: 100%;
    min-height: 2.5rem;
    padding-block: 0.375rem;
    border-bottom: 1px solid var(--hairline);
    text-align: left;
    cursor: pointer;
  }

  .row--prop {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .row__visual {
    display: flex;
  }

  .row__name {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* A value reads exactly as it will arrive (design.md §2). */
  .row__value {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    text-align: right;
    transition-property: color;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease);
  }

  .row:focus-visible .row__value {
    color: var(--text-primary);
  }

  /* Gated: a tapped control's `:hover` latches on touch (design.md §4). */
  @media (hover: hover) {
    .row:hover .row__value,
    .found__md:hover {
      color: var(--text-primary);
    }
  }

  /* ui-skills' 16px swatch with a 1px edge, so white on white is a chip. */
  .swatch {
    width: 16px;
    height: 16px;
    box-shadow: inset 0 0 0 1px var(--hairline-strong);
  }

  .bar {
    height: 8px;
    max-width: 100%;
    background: var(--text-secondary);
  }

  /* The site's radius on a 48px box: corners that are data, like a swatch's
     colour, not a fifth radius of ours (design.md §3, sharp corners). */
  .shape {
    width: 48px;
    height: 48px;
    border: 1px solid var(--hairline-strong);
    background: var(--hairline);
  }

  .styles {
    display: grid;
    gap: 1rem;
  }

  .style {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0.5rem 1rem;
  }

  .style__specimen {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }

  .style__aa {
    line-height: 1.1;
    color: var(--text-primary);
  }

  /* `.tag` and `.style` set `display`, which beats the UA's `[hidden]`. */
  .tag--more[hidden],
  li[hidden] {
    display: none;
  }

  @media (max-width: 599px) {
    .style {
      grid-template-columns: minmax(0, 1fr);
    }

    .row:not(.row--prop) {
      grid-template-columns: 6rem minmax(0, 1fr) auto;
    }
  }
</style>
