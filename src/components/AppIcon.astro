---
/**
 * AppIcon — an entry's mark, shaped like an app icon.
 *
 * Three layers in one grid cell, top first (`lib/links.ts › markFor`):
 *
 *   1. the logo, live from img.logo.dev for the entry's domain (VET-254; the
 *      free plan does not license keeping a copy, so /privacy names the host)
 *   2. on that image's `error`, the same `<img>` swaps once to
 *      `public/icons/<slug>.webp`, the site's own icon, when the pipeline kept one
 *   3. when that fails too, or there was nothing to ask for, the image removes
 *      itself and the letter underneath shows: the initial on its identity hue
 *      (`lib/tags.ts › hueSlot`, painted by `styles/chip.css › .monogram`)
 *
 * The letter is always rendered, under the picture, so a failed logo costs no
 * layout shift and no script beyond the one-line handler. `letter={false}` is
 * for the tool page's Source line, where the name is already set right above:
 * with no picture the tile hides instead.
 *
 * The shape is Apple's continuous corner: a superellipse, |x|^5 + |y|^5 = 1,
 * sampled at 96 points into one path (`global.css › --squircle`, shared with the
 * ⌘K palette's rows) and applied as a mask so it scales
 * with the box. A circular `border-radius` has a visible seam where the curve
 * meets the straight edge; this has none. The 0.5px ring is the same shape
 * minus itself inset by a pixel, in `--outline`, so a white icon keeps an edge
 * on a white page.
 *
 * Always decorative: every caller sets the entry's name right beside it, so the
 * tile is `aria-hidden` and the image `alt=""`.
 *
 * Size is the `size` prop, unless an ancestor sets `--icon-size`: the /tools
 * grid view grows every row's icon from 28 to 40 that way, with no second markup.
 */
import { markFor } from "../lib/links";
import { hueSlot } from "../lib/tags";

interface Props {
  tool: { slug: string; name: string; url?: string | null; logoDomain?: string | null };
  size: 16 | 28 | 32 | 40 | 60;
  letter?: boolean;
  class?: string;
}

// `rest` carries the caller's scope attribute, so its `class` styles land here.
const { tool, size, letter = true, class: className, ...rest } = Astro.props;
const mark = markFor(tool);
const src = mark.logo ?? mark.icon;

/* Swap to the self-hosted icon once, then give up to the letter. */
const onerror = "this.dataset.fallback?(this.src=this.dataset.fallback,this.removeAttribute('data-fallback')):this.remove()";
---

<span
  class:list={["app-icon", className]}
  style={`--size: ${size}px`}
  aria-hidden="true"
  {...rest}
>
  {
    letter && (
      <span class="app-icon__letter monogram" data-hue={hueSlot(tool.slug)}>
        {mark.letter}
      </span>
    )
  }
  {
    src && (
      <img
        src={src}
        data-fallback={mark.logo ? mark.icon : null}
        alt=""
        width={size}
        height={size}
        loading="lazy"
        decoding="async"
        draggable="false"
        referrerpolicy="strict-origin-when-cross-origin"
        onerror={onerror}
      />
    )
  }
</span>

<style>
  .app-icon {
    --edge: var(--icon-size, var(--size));

    position: relative;
    flex: none;
    display: grid;
    inline-size: var(--edge);
    block-size: var(--edge);
    mask: var(--squircle) center / 100% 100% no-repeat;
    user-select: none;
    -webkit-user-select: none;
  }

  /* The ring: the squircle minus a copy 1px smaller, so 0.5px shows on each side. */
  .app-icon::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--outline);
    mask:
      var(--squircle) center / 100% 100% no-repeat,
      var(--squircle) center / calc(100% - 1px) calc(100% - 1px) no-repeat;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* Picture over letter, one cell. White under the picture: a transparent
     logo reads the way a home screen flattens it, and the letter never shows
     through. */
  .app-icon > * {
    grid-area: 1 / 1;
  }

  .app-icon img {
    inline-size: 100%;
    block-size: 100%;
    background: #fff;
    -webkit-user-drag: none;
  }

  /* `letter={false}` and no picture left: no empty ring. */
  .app-icon:not(:has(img, .app-icon__letter)) {
    display: none;
  }

  /* `.monogram` brings the hue fill and the ink; the box and the type scale
     with the tile instead of its 48px circle. 0.43 is the 12-in-28 the /tools
     letter has always been. */
  .app-icon__letter {
    --monogram-size: 100%;
    border-radius: 0;
    font-size: calc(var(--edge) * 0.43);
    text-transform: uppercase;
  }
</style>
