---
/**
 * EntryBlock — the short version of a library entry (VET-273, VET-277), as
 * rows of the "Written by AI" box (`EntrySection.astro`, VET-279): the next
 * step (private only), who it is for, the tip (its lead under the
 * highlighter), time and needs as chips, a prompt to copy
 * (`lib/copy-flash.ts`; "our prompt" when we wrote it), first steps. Each
 * row is a `.fact` (global.css): label left, value right, stacked on a phone.
 * The caller supplies the `dl` and the copy root.
 */
import type { Block } from "../lib/library";
import { leadSentence } from "../lib/reader.mjs";

interface Props {
  block: Block;
}

const { block } = Astro.props;
const [lead, rest] = leadSentence(block.tip);
---

{block.next_step && (
  <div class="fact blk__next">
    <dt>Do this next</dt>
    <dd>
      <svg class="blk__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2.75 8 H12.5 M8.75 4.25 L12.5 8 L8.75 11.75" /></svg>
      <span>{block.next_step}</span>
    </dd>
  </div>
)}
<div class="fact">
  <dt>Best for</dt>
  <dd>{block.best_for}</dd>
</div>
<div class="fact blk__tip">
  <dt>The tip</dt>
  <dd>{rest ? <><mark class="hl">{lead}</mark> {rest}</> : lead}</dd>
</div>
{block.time && (
  <div class="fact">
    <dt>Time</dt>
    <dd>
      <span class="blk__tag">
        <svg class="blk__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 2.5 A5.5 5.5 0 1 1 7.99 2.5 Z M8 5 V8 H10.5" /></svg>
        {block.time.text}
        {block.time.source === "estimate" && <span class="blk__est">(estimate)</span>}
      </span>
    </dd>
  </div>
)}
{block.needs.length > 0 && (
  <div class="fact">
    <dt>What you need</dt>
    <dd>
      <ul class="blk__chips" role="list">{block.needs.map((need) => <li class="blk__tag">{need}</li>)}</ul>
    </dd>
  </div>
)}
{block.prompt && (
  <div class="fact">
    <dt>The prompt</dt>
    <dd class="blk__prompt">
      <p class="blk__text" data-block-prompt>{block.prompt.text}</p>
      <div class="blk__tools">
        {block.prompt.ours && <span class="chip" data-tone="gray">our prompt</span>}
        <button type="button" class="ctl press" data-copy={block.prompt.text} data-copy-name="the prompt" data-copy-select="[data-block-prompt]">
          <svg class="blk__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5.75 5.75 H13 V13 H5.75 Z M10.25 5.75 V3 H3 V10.25 H5.75" /></svg>
          <span class="blk__label" data-copy-label aria-hidden="true">Copy</span>
          <span class="visually-hidden">Copy the prompt</span>
        </button>
      </div>
    </dd>
  </div>
)}
<div class="fact">
  <dt>Start here</dt>
  <dd>
    <ol class="blk__steps" role="list">
      {block.start_here.map((step) => <li>{step}</li>)}
    </ol>
  </dd>
</div>

<script>
  import { wireAllCopy } from "../lib/copy-flash";
  import { reveal } from "../lib/reveal";

  wireAllCopy();
  // The tip's lead sweeps in like every other highlighter mark (ReaderBlocks).
  reveal("mark.hl:not([data-static])", "hl--on", 0.5);
</script>

<style>
  .blk__icon {
    flex: none;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: square;
  }

  /* The one row to act on: full ink after an amber pen arrow. Not the accent:
     blue is for links and controls, and this line is neither. */
  .blk__next dd {
    display: flex;
    gap: 0.625rem;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-primary);
  }

  .blk__next .blk__icon {
    margin-top: 0.3rem;
    color: var(--pen-amber);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The hero line; its first sentence sits under the pen when there is a
     second to set it off. */
  .blk__tip dd {
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--text-primary);
  }

  /* chip.css's tag, inert: a fill instead of an outline and the 4px corner an
     inline code chip takes, because the 8px outlined tag is a link (design.md
     §3). It wraps, since a need can be a whole phrase, and a URL in one breaks
     anywhere inside the column (VET-284: Simon's "tools.simonwillison.net/..."
     need is one token). `word-break` as well, since it is the one that also
     shrinks a flex item's min-content in every engine. */
  .blk__tag {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 1.75rem;
    padding: 0.3rem 0.625rem;
    border-radius: var(--r-sm);
    background: var(--surface-3);
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--text-secondary);
  }

  .blk__est,
  .blk__steps li::before {
    color: var(--text-tertiary);
  }

  .blk__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  /* A hairline slip for the words to paste, its controls on a line under. */
  .blk__prompt {
    padding: 0.875rem 1rem 0.75rem;
    border: 1px solid var(--hairline);
    background: var(--surface-2);
  }

  .blk__text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-primary);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .blk__tools {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .blk__tools .chip {
    margin-right: auto;
  }

  .blk__tools .blk__icon {
    width: 14px;
    height: 14px;
  }

  /* copy-flash writes "copied"; the button reads "Copied". */
  .blk__label {
    text-transform: capitalize;
  }

  /* Numbered like a checklist: a mono figure in its own column. */
  .blk__steps {
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .blk__steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.5rem;
  }

  .blk__steps li::before {
    content: counter(step);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
</style>
