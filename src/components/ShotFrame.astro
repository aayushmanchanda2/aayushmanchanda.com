---
/**
 * ShotFrame — a screenshot on graph paper.
 *
 * The save.design treatment from the plan: a dotted-grid backdrop, a hairline
 * border, sharp corners, and a 1px optical outline on the imagery itself so a
 * white screenshot does not bleed into a white page.
 *
 * Two modes over one full-page capture:
 *
 *   - the default (an entry) puts the whole capture inside a fixed-height
 *     window you scroll through. The picture IS the content there.
 *   - `crop` (a gallery card) shows the top of the same file at 8:5. A card is
 *     a thing you skim past; a card that scrolled would be a scroll trap.
 *
 * Neither mode loads the full file on a phone or in a card (VET-309): the crop
 * is `lib/thumbs.ts`'s 8:5 copies (AVIF, then WebP, three widths), and the
 * entry's full page is a 780px copy under 48rem, the original above it.
 *
 * Both carry `width`/`height` so their boxes are reserved before the bytes
 * land: the crop's copy size, the full shot's own (`lib/assets.ts › webpSize`).
 */
import { webpSize } from "../lib/assets";
import { cropOf, phoneOf } from "../lib/thumbs";
interface Props {
  /** Web path of the full-page shot. */
  src: string;
  alt: string;
  /** The top of the capture at 8:5, for a gallery card. */
  crop?: boolean;
  /** Above the fold: not lazy. */
  eager?: boolean;
  /** The page's LCP image: `fetchpriority="high"`. One per page. */
  priority?: boolean;
  /** The crop's `sizes`: how wide the card is at each breakpoint. */
  sizes?: string;
}

const { src, alt, crop = false, eager = false, priority = false, sizes = "100vw" } = Astro.props;

/* The full shot's own size: on a phone the scroller lets it run full height
   (`height: auto` below 48rem), and without these the text under it jumped
   when the bytes landed (VET-281). */
const size = crop ? null : webpSize(src);
const copies = cropOf(src);

const img = {
  alt,
  loading: eager ? ("eager" as const) : ("lazy" as const),
  decoding: "async" as const,
  fetchpriority: priority ? ("high" as const) : ("auto" as const),
};
---

<span class="frame dotted-grid dotted-grid--fine">
  {
    crop ? (
      <picture>
        <source type="image/avif" srcset={copies.avif} sizes={sizes} />
        <img class="crop outlined" src={copies.src} srcset={copies.webp} sizes={sizes} width={copies.width} height={copies.height} {...img} />
      </picture>
    ) : (
      /*
        Focusable and named: a scrollable region that only a mouse can reach is
        a region a keyboard user cannot read. `tabindex` is what gives the arrow
        keys somewhere to land.
      */
      <span class="scroller" tabindex="0" role="region" aria-label={alt}>
        <picture>
          <source media="(max-width: 48rem)" srcset={phoneOf(src)} />
          <img class="scroller__shot" src={src} {...img} {...size} />
        </picture>
      </span>
    )
  }
</span>

<style>
  .frame {
    display: block;
    padding: 8px;
    background-color: var(--bg);
    border: 1px solid var(--hairline);
    /* Sharp corners are the /sites house style: the screenshots supply all the
       softness this page needs. */
    border-radius: 0;
  }

  picture {
    display: contents;
  }

  /* Anchored to the top so a card shows the masthead, the part of a site you
     recognise. */
  .crop {
    display: block;
    width: 100%;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    object-position: top center;
    border-radius: 0;
    background-color: var(--bg);
  }

  .scroller {
    /* Column flex, not block, only so of `justify-content` below can reach it. */
    display: flex;
    flex-direction: column;
    /* `safe` is the whole point: it centres a shot shorter than the frame and
       falls back to flush-top the moment one is taller, instead of centring the
       overflow and putting the masthead out of reach above the scroll origin.
       A browser that does not know the keyword drops the declaration and gets
       flush-top everywhere, which is the same behaviour minus the nicety. */
    justify-content: safe center;
    /* Fixed, not `max-height`, so the frame is one size whatever the shot's
       length. Tall enough to read a layout, short enough that the page's own
       scroll is still reachable past the bottom of it. */
    height: clamp(20rem, 70dvh, 46rem);
    overflow-y: auto;
    overflow-x: hidden;
    /* `auto`, stated rather than left to the default, because the obvious thing
       to write here is `contain` and it is wrong.

       `contain` stops scroll CHAINING: once the shot hits its last pixel the
       wheel stops meaning anything, and the page behind it sits still until the
       pointer is physically moved off the frame. On a details page whose main
       content IS this frame, that is a trap — the reader scrolls to the bottom
       of the picture, keeps scrolling to read the notes under it, and nothing
       happens. `contain` earns its keep on a modal, where the thing behind
       genuinely should not move (see the palette and the mobile nav); it costs
       more than it saves on a region sitting in the normal flow of a page.

       So: reach either edge and the page takes over, which is what every other
       scroller on the web does. */
    overscroll-behavior-y: auto;
    /* iOS gives a nested scroller momentum only when it is asked to. */
    -webkit-overflow-scrolling: touch;
    background-color: var(--bg);

    /* `outline` rather than the `.outlined` inset shadow: a shadow is painted
       under the element's own children, so a 12,000px screenshot would cover
       it. An outline is painted on top and does not travel with the scroll. */
    outline: 1px solid var(--outline);
    outline-offset: -1px;

    /* The standard properties, which is what actually governs here: every
       current engine honours these, and a browser that reads them ignores the
       `::-webkit-scrollbar` rules below entirely. */
    scrollbar-width: thin;
    scrollbar-color: var(--hairline-strong) transparent;
  }

  /* On touch and on a phone the shot is the page (VET-279): full height in the
     flow, scrolled by the page itself. A box of nested scroll under a finger
     caught every swipe that started on it, which on a phone is most of the
     screen, and on iOS the page moved while the shot stayed on its first
     screen. */
  @media (pointer: coarse), (max-width: 48rem) {
    .scroller {
      height: auto;
      overflow: visible;
    }
  }

  /* Same line, two steps louder — the frame IS the focus ring. */
  .scroller:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Dead code on anything that understands `scrollbar-width`, which is every
     engine shipping today — kept for Safari before 18.2, where these are the
     only vocabulary for a quiet scrollbar and the alternative is the default
     one sitting on top of the screenshot. */
  .scroller::-webkit-scrollbar {
    width: 10px;
  }

  .scroller::-webkit-scrollbar-track {
    background: transparent;
  }

  .scroller::-webkit-scrollbar-thumb {
    background-color: var(--hairline-strong);
    /* Inset by a transparent border so the thumb reads as a hairline rail
       rather than a bar bolted to the edge of the screenshot. */
    background-clip: padding-box;
    border: 3px solid transparent;
    border-radius: var(--r-pill);
  }

  .scroller:hover::-webkit-scrollbar-thumb {
    background-color: var(--text-tertiary);
  }

  .scroller__shot {
    display: block;
    width: 100%;
    height: auto;
    /* A flex item defaults to shrinking to fit the line. Without this a tall
       shot would be squashed into the frame instead of overflowing it, and the
       scroller would have nothing to scroll. */
    flex: 0 0 auto;
    border-radius: 0;
  }
</style>
