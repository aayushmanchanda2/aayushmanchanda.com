---
/**
 * LibraryFeed — a compact list of library entries: the kind glyph, the title,
 * the TLDR on one line, then the source and the saved date. Each row goes to
 * the entry's page. /library's All view shows the latest saves in it, and its
 * Articles view lists every article in it on a phone, where there is no pane
 * (VET-258). It keeps what the old rows list showed that mattered: title,
 * kind, source and date.
 *
 * `filterable` writes the tags onto each row, so the library's filter narrows
 * it (`lib/library-pane.ts › FILTER`).
 *
 * An entry with a block shows its tip on the one line instead of the TLDR
 * (VET-273), else the teaser (`lib/library.ts › rowSummary`), so an entry
 * with no TLDR yet still says something (VET-284).
 */
import KindIcon from "./KindIcon.astro";
import type { LibraryEntry } from "../lib/library";
import { entryHref, rowSummary } from "../lib/library";
import { formatDay } from "../lib/date";

interface Props {
  entries: LibraryEntry[];
  filterable?: boolean;
}

const { entries, filterable = false } = Astro.props;
---

<ul class="feed">
  {
    entries.map((entry) => {
      const line = entry.block?.tip ?? rowSummary(entry);
      return (
        <li data-tags={filterable ? entry.tags.join(" ") : undefined}>
          <a href={entryHref(entry)} data-astro-prefetch="hover">
            <KindIcon kind={entry.kind} />
            <span class="feed__body">
              <b>{entry.title}</b>
              {line && <span class="feed__tldr">{line}</span>}
              <small>
                <span>{entry.domain}</span>
                <time datetime={entry.saved_date}>{formatDay(entry.saved_date)}</time>
              </small>
            </span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .feed {
    display: flex;
    flex-direction: column;
    max-width: 48rem;
  }

  /* A hairline between two items (E8, VET-282): a phone's Articles list is
     a column of titles, and without a rule they run together. */
  .feed li + li {
    border-top: 1px solid var(--hairline);
  }

  /* The pane row's look: a 12px-radius block, hover instant and the same
     fill as a selected row (design.md §1, §4). The glyph sits on the title's
     first line. */
  .feed a {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem 0.875rem;
    margin-inline: -0.875rem;
    border-radius: var(--r-lg);
    color: var(--text-primary);
    text-decoration: none;
  }

  @media (hover: hover) {
    .feed a:hover {
      background: var(--surface-selected);
      box-shadow: var(--shadow-contrast);
    }
  }

  .feed :global(.ki) {
    margin-top: 0.25rem;
  }

  .feed__body {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .feed b {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .feed__tldr {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .feed small {
    display: flex;
    gap: 0.4rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text-tertiary);
  }

  /* The separator is CSS with an empty alt, never a character (design.md §6). */
  .feed small > * + *::before {
    content: "\00b7" / "";
    margin-right: 0.4rem;
  }
</style>
