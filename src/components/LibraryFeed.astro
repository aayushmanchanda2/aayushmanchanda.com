---
/**
 * LibraryFeed — a compact list of library entries: the kind glyph, the title,
 * the TLDR on one line, then the source and the saved date. Each row goes to
 * the entry's page. /library's All view shows the latest saves in it, and its
 * Articles view lists every article in it on a phone, where there is no pane
 * (VET-258). It keeps what the old rows list showed that mattered: title,
 * kind, source and date.
 *
 * `filterable` writes the tags onto each row, so the pane's tag select narrows
 * it (`lib/library-pane.ts › FILTER`). The All view's latest twelve leave it
 * off: a "latest" list that a filter could empty would be a different list.
 *
 * An entry with a block shows its tip on the one line instead of the TLDR
 * (VET-273). `quiet` is the "Also saved" list: title, domain and date only.
 */
import KindIcon from "./KindIcon.astro";
import type { LibraryEntry } from "../lib/library";
import { entryHref } from "../lib/library";
import { formatDay } from "../lib/date";

interface Props {
  entries: LibraryEntry[];
  filterable?: boolean;
  quiet?: boolean;
}

const { entries, filterable = false, quiet = false } = Astro.props;
---

<ul class:list={["feed", quiet && "feed--quiet"]}>
  {
    entries.map((entry) => (
      <li data-tags={filterable ? entry.tags.join(" ") : undefined}>
        <a href={entryHref(entry)} data-astro-prefetch="hover">
          {!quiet && <KindIcon kind={entry.kind} />}
          <span class="feed__body">
            <b>{entry.title}</b>
            {!quiet && (entry.block?.tip ?? entry.tldr) && <span class="feed__tldr">{entry.block?.tip ?? entry.tldr}</span>}
            <small>
              <span>{entry.domain}</span>
              <time datetime={entry.saved_date}>{formatDay(entry.saved_date)}</time>
            </small>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .feed {
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-width: 48rem;
  }

  /* The pane row's look: a 12px-radius block, hover instant and the same
     fill as a selected row (design.md §1, §4). The glyph sits on the title's
     first line. */
  .feed a {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem 0.875rem;
    margin-inline: -0.875rem;
    border-radius: var(--r-lg);
    color: var(--text-primary);
    text-decoration: none;
  }

  @media (hover: hover) {
    .feed a:hover {
      background: var(--surface-selected);
      box-shadow: var(--shadow-contrast);
    }
  }

  .feed :global(.ki) {
    margin-top: 0.25rem;
  }

  .feed__body {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .feed b {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .feed__tldr {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .feed--quiet a {
    padding-block: 0.5rem;
  }

  .feed--quiet b {
    font-weight: 400;
    color: var(--text-secondary);
  }

  .feed small {
    display: flex;
    gap: 0.4rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text-tertiary);
  }

  /* The separator is CSS with an empty alt, never a character (design.md §6). */
  .feed small > * + *::before {
    content: "\00b7" / "";
    margin-right: 0.4rem;
  }
</style>
