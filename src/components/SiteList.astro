---
/**
 * SiteList — the list view of /sites, in the /tools table's style
 * (`styles/table.css › .dtable`, QA phase 2, B5): Name (the 32px icon and the
 * name), Domain, Collections, Saved. Under 640px only Name shows, with the
 * domain under it, the way the /tools table keeps one column on a phone.
 *
 * The rows carry the hover preview card (`lib/preview-card.ts`): here the row
 * is words, so the picture is what the card adds. Each row is one link to
 * `/sites/<slug>` (a press anywhere on it follows the name's, `lib/row-link.ts`),
 * which `DetailPanel.astro` opens in the slide-over.
 */
import "../styles/table.css";
import AppIcon from "./AppIcon.astro";
import CollectionChips from "./CollectionChips.astro";
import PreviewCard from "./PreviewCard.astro";
import { formatDay } from "../lib/date";
import { paletteFamilies } from "../lib/hues";
import { previewAttributes } from "../lib/preview-card";
import type { SiteGroup } from "../lib/screens";

interface Props {
  groups: SiteGroup[];
}

const { groups } = Astro.props;
---

<table class="list dtable" data-sites-list>
  <thead>
    <tr>
      <th scope="col" class="th--name">Name</th>
      <th scope="col" class="th--domain">Domain</th>
      <th scope="col" class="th--collections">Collections</th>
      <th scope="col" class="th--saved">Saved</th>
    </tr>
  </thead>
  <tbody>
    {
      groups.map(({ primary, screens }) => (
        <tr
          {...previewAttributes({ image: primary.shot, name: primary.title, domain: primary.domain, note: primary.like })}
          data-hues={paletteFamilies(primary.palette).join(" ")}
        >
          <td>
            <span class="row__name">
              <AppIcon tool={{ slug: primary.slug, name: primary.title, url: primary.url, logoDomain: primary.logoDomain }} size={32} />
              <span class="row__text">
                <a
                  class="row__link"
                  href={`/sites/${primary.slug}`} data-astro-prefetch="hover"
                  data-panel-open
                  data-slugs={screens.map((screen) => screen.site.slug).join(" ")}
                >
                  {primary.title}
                </a>
                <span class="row__phone">{primary.domain}</span>
              </span>
            </span>
          </td>
          <td class="cell--wide">{primary.domain}</td>
          <td class="cell--wide"><CollectionChips collections={primary.collections} linked={false} /></td>
          <td class="cell--wide">
            <time datetime={primary.saved_date}>{formatDay(primary.saved_date)}</time>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<PreviewCard />

<script>
  import "../lib/row-link";
</script>

<style>
  .list {
    display: none;
  }

  :global(html[data-sites-view="list"]) .list {
    display: table;
  }

  .th--name { width: 40%; }
  .th--saved { width: calc(6.75rem + var(--page-pad)); }

  .row__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .row__phone {
    display: none;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Phone width: Name only, the domain under it. Columns hide, header and
     cell together, so the table keeps its semantics (see `ToolList.astro`). */
  @media (max-width: 639px) {
    .th--domain,
    .th--collections,
    .th--saved,
    .cell--wide {
      display: none;
    }

    .th--name { width: auto; }

    .row__phone { display: block; }
  }
</style>
