---
/**
 * The window as a postage stamp (VET-262): the mat and its perforation
 * (VET-255, VET-260), the white margin band and keyline inside it, the
 * denomination printed on the keyline, and the postmark. Decorative, so all of
 * it is `aria-hidden`; `styles/frame.css` draws it.
 */
import { formatDay } from "../lib/date";
import { experiments } from "../lib/experiments";
import { feedItems } from "../lib/feeds";
import { NOW_UPDATED } from "../lib/now";
import { FEED_SECTIONS, type FeedSection, getSections } from "../lib/sections";

interface Props {
  /** The nav section this page sits in, e.g. "/tools". */
  href?: string;
  /** True on the section's own index page, where the count and postmark show. */
  index: boolean;
}

const { href, index } = Astro.props;

/** /now is in the nav but is no section: its name, no count, and `NOW_UPDATED` on the postmark. */
const now = href === "/now";
const current = now ? { name: "Now" } : (await getSections()).find((section) => section.href === href);
const denomination = current && (index && "count" in current ? `${current.name} · ${current.count}` : current.name);

/** The section's newest entry, the date its feed would say it last changed.
    /experiments has no feed, so its newest start date stands in (VET-280). */
const feed = index && FEED_SECTIONS.find((section): section is FeedSection => section === href);
const updated = now
  ? NOW_UPDATED
  : feed
  ? (await feedItems(feed)).map((item) => item.date).sort().at(-1)
  : index && href === "/experiments"
    ? experiments.map((experiment) => experiment.started).sort().at(-1)
    : undefined;
---

<div class="stamp" aria-hidden="true">
  <span class="stamp__mark">2026</span>
  {denomination && <span class="stamp__mark stamp__mark--end">{denomination}</span>}
  {["top", "bottom", "left", "right"].map((edge) => <i class="stamp__edge" data-edge={edge}></i>)}
</div>
<div class="mat" aria-hidden="true"><div class="mat__shade"><div class="mat__paper"></div></div></div>
{
  current && updated && (
    <svg class="postmark" viewBox="0 0 200 96" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <g class="postmark__waves">
          <path d="M2 30q9-7 18 0t18 0 18 0 18 0 18 0 18 0" />
          <path d="M6 48q9-7 18 0t18 0 18 0 18 0 18 0 14 0" />
          <path d="M2 66q9-7 18 0t18 0 18 0 18 0 18 0 18 0" />
        </g>
        <path d="M149 5c25-1 44 19 43 44s-20 44-45 43-43-21-42-46 19-40 46-41" />
        <path d="M148 17c17 0 31 14 31 31s-14 31-32 31-30-15-30-32 14-30 31-30" stroke-width="1.5" />
      </g>
      <g fill="currentColor" font-size="10" text-anchor="middle">
        <text x="148" y="40">{current.name.toUpperCase()}</text>
        {formatDay(updated).toUpperCase().split(", ").map((line, i) => (
          <text x="148" y={53 + i * 12}>{line}</text>
        ))}
      </g>
    </svg>
  )
}

<style>
  /* The postmark: a cancellation struck across the stamp's top edge,
     the circle over mat, band and bar, the waves trailing left along the bar's
     empty stretch. Cancelling ink, not the section's: `--text-primary`, faint,
     so it reads on the mat and on the paper and the bar under it still reads.
     Over `.mat` to cross the edge; left of Search where Search shows. */
  .postmark {
    position: fixed;
    top: 0;
    right: calc(var(--frame) + 0.5rem);
    z-index: 41;
    width: clamp(7rem, 12vw, 10rem);
    pointer-events: none;
    color: var(--text-primary);
    opacity: 0.2;
    rotate: -8deg;
    /* struck by hand, so one wear layer more than the printed marks */
    mask: var(--ink-wear), var(--ink-wear) 71px 29px;
    mask-composite: intersect;
    font-family: var(--font-mono);
  }

  @media (min-width: 600px) {
    .postmark {
      right: calc(var(--frame) + 7rem);
    }
  }

  /* Under 600px the trail runs to the right edge: the waves would cross it,
     so only the ring is struck. */
  @media (max-width: 599px) {
    .postmark__waves {
      display: none;
    }
  }

  /* On touch (VET-285, H3): a fast fling on an iPad outruns the painter, and
     a tile not yet painted shows the canvas colour, which was the mat's, so
     the mat smeared through the page. The canvas is paper there; the mat
     layer still draws every gutter and hole. The paper's lift goes too: two
     drop-shadows over a window-sized masked layer is the costliest thing to
     redraw when a fling makes iOS repaint the fixed layers. */
  @media (pointer: coarse) {
    :global(:root) {
      background: var(--bg);
    }

    .mat__shade {
      filter: none;
    }
  }
</style>
