---
/**
 * EntryDetail — a library entry's detail: the header (title, the domain as
 * the one way out, the strip of facts whose values are filter links), then
 * three boxes so who wrote what reads at a glance (VET-279, `EntrySection`):
 *
 *   - **Written by AI**: the TLDR, the block, the digest, the filed note and,
 *     on a private entry, why it was saved and the sweep's note. The agents
 *     drafted every one of these, the public `note` included.
 *   - **In my words**: only what he typed himself (his Raindrop and Telegram
 *     notes, his own `why`). Absent when there is none; no empty box.
 *   - **The source**: the post or video, its moments, the piece's highlights
 *     and excerpt, his Raindrop highlights, and on an article the way out.
 *
 * Shared by `pages/library/[slug].astro`, /library's Articles view (the
 * title an `h2` linking to the entry there) and `PrivateEntry.astro`, which
 * passes `why`. design.md §3 has the reasoning.
 */
import DigestBlocks from "./DigestBlocks.astro";
import DraftBlock from "./DraftBlock.astro";
import EntryBlock from "./EntryBlock.astro";
import EntryLink from "./EntryLink.astro";
import EntrySection from "./EntrySection.astro";
import KindChip from "./KindChip.astro";
import KindIcon from "./KindIcon.astro";
import Moments from "./Moments.astro";
import TagChips from "./TagChips.astro";
import PostCard from "./PostCard.astro";
import ReaderBlocks from "./ReaderBlocks.astro";
import VideoFacade from "./VideoFacade.astro";
import type { LibraryEntry } from "../lib/library";
import type { Why } from "../lib/private";
import { entryHref, libraryDomains } from "../lib/library";
import { libraryPreview } from "../lib/assets";
import { formatDay } from "../lib/date";
import { VOICE_FIELDS } from "../lib/markdown";

interface Props {
  entry: LibraryEntry;
  /** `h2` where the page has its own `h1`; the title then links to the entry. */
  level?: "h1" | "h2";
  /** A private entry's own parts (`lib/private.ts › whyOf`). */
  why?: Why;
}

const { entry, level = "h1", why } = Astro.props;
const Title = level;
const sectionLevel = level === "h1" ? "h2" : "h3";
// The hover card itself ships with `LibraryPane`, on both pages that render this.
const preview = libraryPreview(entry);
const rows = (pairs: [string, string | null | undefined][]) => pairs.filter((pair): pair is [string, string] => Boolean(pair[1]));
// The filed note is not on a read post: there it copies the card (VET-221).
const filed = rows([["Filed note", entry.post ? null : entry.note], ["Why it’s here", why?.why], ["Hermes", why?.sweep]]);
// His words only. A drafted `why` is the draft's, never one of these.
const mine = rows([["Raindrop note", why?.mine], ["Telegram", why?.telegram], [VOICE_FIELDS.find((field) => field.key === "why")?.label ?? "Why", entry.why]]);
const marks = why?.highlights ?? [];
const ai = Boolean(entry.tldr || entry.block || entry.digest || entry.draft || filed.length);
// More from this host, when there is more: its filter page's only way in (VET-281).
const host = libraryDomains.find((group) => group.domain === entry.domain && group.entries.length > 1);
const source = Boolean(entry.post || entry.video || entry.moments.length || entry.highlights.length || entry.excerpt || marks.length || entry.kind === "article");
---

<header>
  <Title class="page-title page-title--entry">
    {level === "h1" ? entry.title : <a class="title-link" href={entryHref(entry)}>{entry.title}</a>}
  </Title>
  <p class="out">
    <EntryLink class="ext" href={entry.url} {...preview}>{entry.domain}</EntryLink>
    {host && <a class="out__more" href={`/library/domain/${host.slug}`}>{host.entries.length} saved</a>}
  </p>

  {/* A `ul` of facts (dots are CSS); every value is a filter link. Tags take their own line (VET-223). */}
  <ul class="strip mono">
    <li class="strip__item">
      <a class="strip__chip" href={`/library/kind/${entry.kind}`}>
        <KindChip kind={entry.kind} />
      </a>
    </li>
    <li class="strip__item">
      Saved <time datetime={entry.saved_date}>{formatDay(entry.saved_date)}</time>
    </li>
    {
      entry.digest && (
        <li class="strip__item">
          Digested <time datetime={entry.digest.digested}>{formatDay(entry.digest.digested)}</time>
        </li>
      )
    }
    {
      entry.draft && (
        <li class="strip__item">
          Drafted <time datetime={entry.draft.drafted}>{formatDay(entry.draft.drafted)}</time>
        </li>
      )
    }
    {
      entry.tags.length > 0 && (
        <li class="strip__item strip__item--tags">
          <TagChips tags={entry.tags} />
        </li>
      )
    }
  </ul>

</header>

{
  ai && (
    <EntrySection level={sectionLevel} label="Written by AI" id="sec-ai" icon="ai" copy={Boolean(entry.block?.prompt)}>
      <dl>
        {entry.tldr && (
          <div class="fact tldr">
            <dt>TLDR</dt>
            <dd>{entry.tldr}</dd>
          </div>
        )}
        {entry.block && <EntryBlock block={entry.block} />}
        {entry.digest && <DigestBlocks digest={entry.digest} />}
        {filed.map(([label, text]) => (
          <div class="fact">
            <dt>{label}</dt>
            <dd>{text}</dd>
          </div>
        ))}
      </dl>
      {entry.draft && <div class="sec__body"><DraftBlock draft={entry.draft} /></div>}
    </EntrySection>
  )
}

{
  mine.length > 0 && (
    <EntrySection level={sectionLevel} label="In my words" id="sec-mine" icon="pen">
      <dl class="mine">
        {mine.map(([label, text]) => (
          <div class="fact">
            <dt>{label}</dt>
            <dd>{text}</dd>
          </div>
        ))}
      </dl>
    </EntrySection>
  )
}

{
  source && (
    <EntrySection level={sectionLevel} label="The source" id="sec-source">
      <KindIcon slot="icon" kind={entry.kind} />
      {(entry.post || entry.video || entry.moments.length > 0) && (
        <div class="sec__body media">
          {entry.post && <PostCard post={entry.post} url={entry.url} mode="page" keyline={entry.keyline} />}
          {entry.video && <VideoFacade entry={{ ...entry, video: entry.video }} />}
          <Moments moments={entry.moments} />
          {entry.media_retrieved && (entry.post || entry.video) && (
            <p class="media__saved mono">Media saved <time datetime={entry.media_retrieved}>{formatDay(entry.media_retrieved)}</time></p>
          )}
        </div>
      )}
      {(entry.highlights.length > 0 || entry.excerpt || marks.length > 0) && (
        <dl>
          <ReaderBlocks highlights={entry.highlights} excerpt={entry.excerpt} url={entry.url} domain={entry.domain} mine={marks} />
        </dl>
      )}
      {entry.kind === "article" && (
        <p class="sec__body">
          <EntryLink class="ext ctl press" href={entry.url} {...preview}>Read the full article</EntryLink>
        </p>
      )}
    </EntrySection>
  )
}

<style>
  /* The /tools strip. **The 1.25rem row gap is a hit area, not a rhythm**: a
     tag reaches 0.375rem past its box and the kind chip 0.62rem, so wrapped
     lines need 2 × 0.62rem or one target covers the next (measured 9.9px at
     375px before it). Adjacent targets may touch, never overlap (design.md §4). */
  .strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 0.5rem;
    /* title to strip is 16px: §2's rhythm, 8 / 16 / 40 */
    margin-top: 1rem;
    color: var(--text-tertiary);
  }

  /* The TLDR: the lead line, what the source says in a sentence (VET-233). */
  .tldr dd {
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--text-primary);
  }

  /* His words are the loudest lines on the page, his line breaks kept. */
  .mine dd {
    font-size: 1.0625rem;
    color: var(--text-primary);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* The post or video fills the box's padded body; the moments sit under it. */
  .media > :global(*) {
    margin-top: 0;
  }

  .media > :global(* + *) {
    margin-top: 1.25rem;
  }

  /* When the copies here were made (VET-65): meta, so tertiary. */
  .media__saved {
    color: var(--text-tertiary);
  }

  .strip__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* The alt-text form, so a screen reader never reads "middle dot". */
  .strip__item + .strip__item::before {
    content: "\00b7" / "";
    color: var(--hairline-strong);
  }

  /* The tags on a line of their own with no separator: a dot starting a line
     is the orphan this removes (VET-223). */
  .strip__item--tags {
    flex-basis: 100%;
  }

  .strip__item + .strip__item--tags::before {
    content: none;
  }

  /* the chip does the talking; the anchor only carries the target */
  .strip__chip {
    position: relative;
    display: inline-flex;
    text-decoration: none;
    transition-property: opacity;
    transition-duration: var(--dur);
    transition-timing-function: var(--ease);
  }

  /* design.md §4's 40px floor, `chip.css › .tag::after`'s offsets: 0.62rem
     past a 20.3px box, horizontal only so it cannot swallow the domain link. */
  .strip__chip::after {
    content: "";
    position: absolute;
    inset: -0.62rem 0;
  }

  .strip__chip:hover {
    opacity: 0.75;
  }

  /* --- the header ---------------------------------------------------------- */

  /* The domain, linked out, 8px under the title: a control, so
     --text-secondary (design.md §4, the ink floor). */
  .out {
    margin-top: 0.5rem;
    overflow-wrap: anywhere;
  }

  .out :global(a) {
    color: var(--text-secondary);
    text-decoration: none;
    transition-property: color;
    transition-duration: var(--dur);
    transition-timing-function: var(--ease);
  }

  .out :global(a:hover) {
    color: var(--accent);
  }

  .out__more::before {
    content: "·";
    margin-inline: 0.5em;
    color: var(--text-tertiary);
  }

  .title-link {
    color: inherit;
    text-decoration: none;
  }

  @media (hover: hover) {
    .title-link:hover {
      color: var(--accent);
    }
  }

  /* 44px under a finger (VET-307): the kind chip reaches further, and the
     host links grow by padding and give it back by margin; 8px more under the
     host line keeps its targets off the kind chip's. */
  @media (pointer: coarse) {
    .strip__chip::after {
      inset: -0.75rem 0;
    }

    .out {
      padding-bottom: 0.5rem;
    }

    .out :global(a) {
      padding-block: 12px;
      margin-block: -12px;
    }
  }
</style>
