---
/**
 * VoiceBlocks — the entry in his own words, under mono labels.
 *
 * The swipe.md convention: a verdict tells you where something landed, and a
 * one-line note tells you roughly why, but neither says what it is actually
 * like to use. These do. Four fields, one labelled block each, prose
 * underneath.
 *
 * Both details pages render this, and both hand it whatever they have. /sites
 * only ever has two of the four, so the props are all optional rather than
 * making a gallery entry pass `why={null} try={null}` to say nothing twice.
 *
 * Absent means absent. A field that is null contributes no block, and a caller
 * with nothing at all gets no wrapper, no heading and no rule — the component
 * renders literally nothing. That is the whole point of the field being
 * optional: an empty labelled box is worse than silence, because it reads as a
 * page that failed rather than a tool he has not written up yet.
 *
 * The labels, their order, and which field is machine text all come from
 * `lib/markdown.ts › VOICE_FIELDS` — the same list the markdown variants render
 * from. They used to be a second copy written out here, under a comment in that
 * file claiming the two matched exactly, and they drifted: this file's
 * `What I don’t` carried a typographic apostrophe and the markdown's carried a
 * typewriter one, so a /tools entry and its own `.md` twin disagreed about the
 * label on every dislike he had written. A comment asking two lists to stay in
 * step is not a mechanism. There is one list now, and `lib/voice.test.mjs`
 * fails if this file stops reading it.
 *
 * The order that list fixes: why (when to reach for it) orients, like and
 * dislike are the judgement, and try is the way out into actually using the
 * thing, so it goes last.
 */

import { VOICE_FIELDS, type Voice } from "../lib/markdown";

/**
 * Exactly `Voice`, which is what the markdown side reads. Named `Props` because
 * that is the interface Astro types the component from, but it must not grow a
 * field of its own: a fifth block belongs in `VOICE_FIELDS`, where both
 * renderings can see it.
 */
interface Props extends Voice {}

const voice: Voice = Astro.props;

interface Block {
  /** Sentence case, printed as written: the label voice has no case transform. */
  label: string;
  body: string;
  /**
   * Machine text — a command to paste, or a bare URL. Set in mono at reading
   * size rather than in the prose face, because a command in a proportional
   * font is a command you have to squint at before you trust it.
   */
  code?: boolean;
}

const blocks: Block[] = VOICE_FIELDS.flatMap(({ key, label, code }) => {
  const body = voice[key];
  // Absent means absent, and both kinds of absent mean it: /sites passes
  // neither `why` nor `try` at all, /tools passes null for a field he has not
  // written up. Neither contributes a block.
  return body === undefined || body === null ? [] : [{ label, body, code }];
});
---

{
  blocks.length > 0 && (
    <div class="voice">
      {blocks.map((block) => (
        <section class="voice__block">
          <h2 class="voice__label mono">{block.label}</h2>
          <p class:list={["voice__body prose", block.code && "voice__body--code"]}>
            {block.body}
          </p>
        </section>
      ))}
    </div>
  )
}

<style>
  /* A label at --text-tertiary over a `.prose` body (`styles/prose.css`),
     the note page's reading type, the same as DigestBlocks beside it on a
     library entry (VET-231).

     No rules between blocks, unlike /privacy, which hairlines every section as it
     is a long document you scan for the clause you came for. Three or four
     short blocks on an entry page are one thought, and ruling them would slice
     it up and then compete with the facts table underneath. Gap does the work. */
  .voice {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .voice__label {
    color: var(--text-tertiary);
    /* the label is metadata; the paragraph under it carries the reading size */
    line-height: 1.6;
  }

  .voice__body {
    margin-top: 0.5rem;
  }

  .voice__body--code {
    font-family: var(--font-mono);
    /* mono runs wide, so it steps down to sit level with the prose around it */
    font-size: 0.875rem;
    /* full ink: this is the one line on the page a reader is meant to copy */
    color: var(--text-primary);
    /* a long install command must wrap rather than push the column sideways */
    overflow-wrap: anywhere;
  }

</style>
