---
/**
 * /me/library (VET-274): the library pane itself, the public rows with the
 * private ones merged in, as the page's one column at every width, the way
 * Notes shows its list: kind segments with "Private", the tags, month
 * headers, each row's tip, lock-marked private rows and "Also saved" last.
 * One list and one `FILTER`, so a phone gets the same filters a desktop does.
 * "Private" and "Sign out" sit in the top bar, from `lib/signed-in.ts`, as on
 * every page while he is signed in.
 */
import Base from "../layouts/Base.astro";
import PrivatePane from "./PrivatePane.astro";
import type { LibraryEntry } from "../lib/library";

interface Props {
  rows: LibraryEntry[];
}

const { rows } = Astro.props;
---

<Base title="Private library · Aayush Manchanda" description="Private." noindex full>
  <section class="plist">
    <h1 class="page-title plist__head">Private <span class="plist__count tabular-nums">{rows.length}</span></h1>
    <PrivatePane rows={rows} />
  </section>
</Base>

<style>
  .plist {
    max-width: 40rem;
    margin-inline: auto;
  }

  .plist__head {
    margin-bottom: 1rem;
  }

  .plist__count {
    color: var(--text-tertiary);
  }

  /* The pane out of its side column: in the page's flow and scroll, so its
     toolbar and month headers stick under the site's bar instead. */
  .plist :global(.pane) {
    display: block;
    --pane-top: calc(var(--frame) + var(--bar-h));
  }

  .plist :global(.pane__bar) {
    top: var(--pane-top);
    padding-inline: 0;
  }

  .plist :global(.pane .pane__month) {
    top: calc(var(--pane-top) + var(--pane-bar, 5.375rem));
    padding-inline: 0;
  }

  .plist :global(.pane__tags),
  .plist :global(.pane ul) {
    padding-inline: 0;
  }

  .plist :global(.pane li > a) {
    margin-inline: -0.875rem;
  }
</style>
