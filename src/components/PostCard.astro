---
/**
 * PostCard — a saved x.com post, drawn here from the repo. No embed, no script.
 *
 * swiped.design's `.tcard`: header, text, media, quoted post, footer. Every
 * picture and video is our copy under `/posts/<id>/` (`pipeline/post.mjs`), so
 * the page is final on first paint and the browser never talks to X.
 *
 * Three modes. `grid` is a tile on `/library/kind/post`: the text is cut at
 * `POST_CARD_MAX` and clamped, the date links to the entry, and "Read more"
 * appears when there is more. `page` is the entry's own page: the whole text.
 * `quoted` is the nested card inside either.
 *
 * An X Article renders its header only (cover, title, "Read on X"). Its body
 * is not republished; the default slot is where F3's highlights go.
 *
 * The words themselves are `PostText.astro`: lists, links and the keyline.
 */
import type { Post } from "../lib/library";
import { formatDay } from "../lib/date";
import { hueSlot } from "../lib/tags";
import { POST_CARD_MAX, clipText, isClipped, monogram, originalUrl } from "../lib/post";
import PostMedia from "./PostMedia.astro";
import PostText from "./PostText.astro";
import XGlyph from "./XGlyph.astro";

interface Props {
  post: Post;
  /** The saved URL: the way out when the post has no id. */
  url: string;
  mode: "grid" | "page" | "quoted";
  /** The entry's own page. Grid only. */
  href?: string;
  /** The line to mark in the text, word for word (VET-264). */
  keyline?: string | null;
}

const { post, url, mode, href, keyline = null } = Astro.props;
const grid = mode === "grid";
const original = originalUrl(post, url);
const clipped = grid && isClipped(post.text, POST_CARD_MAX);
const text = grid ? clipText(post.text, POST_CARD_MAX) : post.text;
const Root = mode === "quoted" ? "div" : "article";
const initial = monogram(post.author);
---

<Root class:list={["pc", `pc--${mode}`]}>
  <header class="pc__head">
    {
      post.avatar ? (
        <img class="pc__avatar" src={post.avatar} alt="" width="40" height="40" decoding="async" />
      ) : (
        initial !== "" && (
          <span class="pc__avatar monogram" data-hue={hueSlot(post.handle)} aria-hidden="true">
            {initial}
          </span>
        )
      )
    }
    <span class="pc__who">
      <span class="pc__name">{post.author}</span>
      <span class="pc__handle">@{post.handle}</span>
    </span>
    {mode !== "quoted" && <span class="pc__mark"><XGlyph /></span>}
  </header>

  {
    post.article && (
      <div class="pc__article">
        {post.article.cover && (
          <img class="pc__cover outlined" src={post.article.cover} alt="" loading="lazy" decoding="async" />
        )}
        <p class="pc__article-title">{post.article.title}</p>
        <slot />
        <a class="pc__out ext" href={original} rel="noopener nofollow" target="_blank">Read on X</a>
      </div>
    )
  }

  {!post.article && <PostText text={text} links={post.links} keyline={keyline} mode={mode} />}

  {post.media.length > 0 && <PostMedia media={post.media} author={post.author} original={original} />}

  {post.quoted && <Astro.self post={post.quoted} url={originalUrl(post.quoted, original)} mode="quoted" />}

  <footer class="pc__foot">
    {
      grid && href ? (
        <a class="pc__date" href={href}><time datetime={post.date}>{formatDay(post.date)}</time></a>
      ) : (
        <time class="pc__date" datetime={post.date}>{formatDay(post.date)}</time>
      )
    }
    {clipped && href && <a class="pc__more" href={href}>Read more</a>}
    {
      post.removed ? (
        <span class="pc__gone">Removed on X</span>
      ) : (
        !post.article && (
          <a class="pc__out ext" href={original} rel="noopener nofollow" target="_blank">
            {mode === "quoted" ? "Open" : "Open original post"}
          </a>
        )
      )
    }
  </footer>
</Root>

<style>
  .pc {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--hairline);
    background: var(--bg);
    color: var(--text-primary);
  }

  .pc--grid {
    height: 100%;
  }

  .pc--quoted {
    gap: 0.5rem;
    padding: 0.75rem;
  }

  .pc__head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
  }

  .pc__avatar {
    --monogram-size: 40px;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-size: 1rem;
  }

  .pc--quoted .pc__avatar {
    --monogram-size: 20px;
    width: 20px;
    height: 20px;
    font-size: 0.625rem;
  }

  .pc__who {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }

  .pc--quoted .pc__who {
    flex-direction: row;
    gap: 0.375rem;
  }

  .pc__name {
    overflow: hidden;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pc__handle {
    overflow: hidden;
    color: var(--text-secondary);
    font-size: 0.875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pc__mark {
    display: inline-flex;
    margin-left: auto;
    color: var(--text-primary);
  }

  .pc__out,
  .pc__more {
    color: var(--accent);
    text-decoration: none;
    transition-property: opacity;
    transition-duration: var(--dur);
    transition-timing-function: var(--ease);
  }

  .pc__out:hover,
  .pc__more:hover {
    opacity: 0.75;
  }

  /* A tile's media is one 16:10 box whatever it holds, so a four-photo post
     is no taller than a one-photo post and rows stay close in height. */
  .pc--grid > :global(.pm) {
    aspect-ratio: 16 / 10;
  }

  .pc--grid > :global(.pm) :global(:is(img, video)) {
    height: 100%;
    aspect-ratio: auto;
  }

  /* A quoted post on a tile is who and what; the rest is on the entry. */
  .pc--grid .pc--quoted :is(:global(.pm), .pc__cover, .pc__out, .pc__foot) {
    display: none;
  }

  .pc__article {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pc__cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 2;
    object-fit: cover;
  }

  .pc__article-title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .pc__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    margin-top: auto;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .pc__foot .pc__out {
    margin-left: auto;
  }

  .pc__date {
    color: inherit;
    text-decoration: none;
  }
</style>
