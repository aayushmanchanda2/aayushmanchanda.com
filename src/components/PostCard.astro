---
/**
 * PostCard — a saved x.com post, drawn here from the repo. No embed, no script.
 *
 * swiped.design's `.tcard`: header, text, media, quoted post, footer. Every
 * picture and video is our copy under `/posts/<id>/` (`pipeline/post.mjs`), so
 * the page is final on first paint and the browser never talks to X.
 *
 * Three modes. `grid` is a tile on `/library/kind/post`: the text is cut at
 * `POST_CARD_MAX` and clamped. `page` is the entry's own page: the whole text.
 * `quoted` is the nested card inside either.
 *
 * The foot has one pattern (QA phase 2, B8): the date, then on a tile "Read
 * more" to the entry, then a lone ↗ to the original on X, named for a screen
 * reader and 40px to a finger. An X Article renders its header only (cover,
 * title); its body is not republished, and the same ↗ is the way to it. The
 * default slot is where F3's highlights go.
 *
 * The words themselves are `PostText.astro`: lists, links and the keyline.
 */
import type { Post } from "../lib/library";
import { formatDay } from "../lib/date";
import { hueSlot } from "../lib/tags";
import { POST_CARD_MAX, clipText, monogram, originalUrl } from "../lib/post";
import PostMedia from "./PostMedia.astro";
import PostText from "./PostText.astro";
import XGlyph from "./XGlyph.astro";

interface Props {
  post: Post;
  /** The saved URL: the way out when the post has no id. */
  url: string;
  mode: "grid" | "page" | "quoted";
  /** The entry's own page. Grid only. */
  href?: string;
  /** The line to mark in the text, word for word (VET-264). */
  keyline?: string | null;
}

const { post, url, mode, href, keyline = null } = Astro.props;
const grid = mode === "grid";
const original = originalUrl(post, url);
const text = grid ? clipText(post.text, POST_CARD_MAX) : post.text;
const Root = mode === "quoted" ? "div" : "article";
const initial = monogram(post.author);
---

<Root class:list={["pc", `pc--${mode}`]}>
  <header class="pc__head">
    {
      post.avatar ? (
        <img class="pc__avatar" src={post.avatar} alt="" width="40" height="40" decoding="async" draggable="false" />
      ) : (
        initial !== "" && (
          <span class="pc__avatar monogram" data-hue={hueSlot(post.handle)} aria-hidden="true">
            {initial}
          </span>
        )
      )
    }
    <span class="pc__who">
      <span class="pc__name">{post.author}</span>
      <span class="pc__handle">@{post.handle}</span>
    </span>
    {mode !== "quoted" && <span class="pc__mark"><XGlyph /></span>}
  </header>

  {
    post.article && (
      <div class="pc__article">
        {post.article.cover && (
          <img class="pc__cover outlined" src={post.article.cover} alt="" loading="lazy" decoding="async" />
        )}
        <p class="pc__article-title">{post.article.title}</p>
        <slot />
      </div>
    )
  }

  {!post.article && <PostText text={text} links={post.links} keyline={keyline} mode={mode} />}

  {post.media.length > 0 && <PostMedia media={post.media} author={post.author} original={original} />}

  {post.quoted && <Astro.self post={post.quoted} url={originalUrl(post.quoted, original)} mode="quoted" />}

  <footer class="pc__foot">
    <time datetime={post.date}>{formatDay(post.date)}</time>
    {grid && href && <a class="pc__more" href={href}>Read more</a>}
    {
      post.removed ? (
        <span class="pc__gone">Removed on X</span>
      ) : (
        <a class="pc__out ext" href={original} rel="noopener nofollow" target="_blank" aria-label="Original post on X"></a>
      )
    }
  </footer>
</Root>

<style>
  .pc {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--hairline);
    background: var(--bg);
    color: var(--text-primary);
  }

  /* A tile lifts off the page (E7, VET-282; VET-284), so neighbours read as
     separate posts: `--card-edge`, `--card-bg` and `--card-shadow`, tuned per
     theme in global.css. Its height is its content's (the masonry wall). */
  .pc--grid {
    border-color: var(--card-edge);
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
  }

  .pc--quoted {
    gap: 0.5rem;
    padding: 0.75rem;
  }

  .pc__head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
  }

  .pc__avatar {
    --monogram-size: 40px;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-size: 1rem;
  }

  .pc--quoted .pc__avatar {
    --monogram-size: 20px;
    width: 20px;
    height: 20px;
    font-size: 0.625rem;
  }

  .pc__who {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }

  .pc--quoted .pc__who {
    flex-direction: row;
    gap: 0.375rem;
  }

  .pc__name {
    overflow: hidden;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pc__handle {
    overflow: hidden;
    color: var(--text-secondary);
    font-size: 0.875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* `flex: none`: a long name squeezed the mark below 14px (B8). */
  .pc__mark {
    display: inline-flex;
    flex: none;
    margin-left: auto;
    color: var(--text-primary);
  }

  .pc__more {
    color: var(--accent);
    text-decoration: none;
    transition-property: opacity;
    transition-duration: var(--dur);
    transition-timing-function: var(--ease);
  }

  .pc__more:hover {
    opacity: 0.75;
  }

  /* The way out: the ↗ alone (`.ext`), drawn at 16px in secondary ink and
     given the 40px glyph target by negative margins, so the row keeps its
     height. Accent on hover, like every link out. */
  .pc__out {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin: -0.75rem -0.75rem -0.75rem auto;
    color: var(--text-secondary);
    font-size: 1rem;
    text-decoration: none;
  }

  @media (hover: hover) {
    .pc__out:hover {
      color: var(--accent);
    }
  }

  /* A quoted post on a tile is who and what; the rest is on the entry. */
  .pc--grid .pc--quoted :is(:global(.pm), .pc__cover, .pc__foot) {
    display: none;
  }

  .pc__article {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pc__cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 2;
    object-fit: cover;
  }

  .pc__article-title {
    overflow-wrap: anywhere;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .pc__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    margin-top: auto;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  /* 44px under a finger (VET-307): the ↗ and Read more, the same room back by margin. */
  @media (pointer: coarse) {
    .pc__out {
      width: 44px;
      height: 44px;
      margin: -0.875rem -0.875rem -0.875rem auto;
    }

    .pc__more {
      padding-block: 11px;
      margin-block: -11px;
    }
  }
</style>
