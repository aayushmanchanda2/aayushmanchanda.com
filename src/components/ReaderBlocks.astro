---
/**
 * ReaderBlocks — what a saved piece says in its own words (VET-246): up to five
 * passages as pull-quotes under a highlighter, then the excerpt, quoted and
 * cited. Never the piece itself: `lib/reader.mjs` caps both, and that cap is
 * the copyright line.
 *
 * The mark is drawn whole in the markup. `styles/prose.css › .hl` arms it (0% wide) only
 * where the pre-paint script has run and motion is allowed, and the script
 * releases each one as it scrolls into view, once. No script, reduced motion
 * and print all get a static, full mark.
 */
import Doodle from "./Doodle.astro";
import EntryLink from "./EntryLink.astro";
import type { Highlight } from "../lib/library";

interface Props {
  highlights: Highlight[];
  excerpt: string | null;
  url: string;
  domain: string;
}

const { highlights, excerpt, url, domain } = Astro.props;
---

{
  highlights.length > 0 && (
    <section class="block" aria-labelledby="highlights">
      <h2 class="accent-bar" id="highlights">Highlights</h2>
      <div class="pulled">
        <Doodle class="pulled__bracket" shape="bracket" variant={2} stroke={1.5} stretch draw />
        <ul class="quotes">
          {highlights.map((highlight) => (
            <li>
              <blockquote class="quote" cite={url}>
                <p>
                  <mark class="hl" data-color={highlight.color}>{highlight.text}</mark>
                </p>
              </blockquote>
              {highlight.note && <p class="quote__note">{highlight.note}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

{
  excerpt && (
    <figure class="block excerpt">
      <blockquote cite={url}>
        <p>{excerpt}</p>
      </blockquote>
      <figcaption class="quote__note">
        From <cite><EntryLink href={url}>{domain}</EntryLink></cite>
      </figcaption>
    </figure>
  )
}

<script>
  import { reveal } from "../lib/reveal";

  // Every sweeping mark on the page; a grid's are static.
  reveal("mark.hl:not([data-static])", "hl--on", 0.5);
</script>

<style>
  .block {
    max-width: 40rem;
    margin-top: 2.5rem;
  }

  /* The pull-quotes sit inside a pen bracket (VET-251), indented to the
     excerpt, so the two quoted blocks start on one edge. */
  .pulled {
    position: relative;
    padding-left: 1rem;
  }

  .pulled__bracket {
    position: absolute;
    left: -0.25rem;
    top: 0.2rem;
    bottom: 0.2rem;
    width: 0.625rem;
    height: calc(100% - 0.4rem);
  }

  .quotes {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* A pull-quote: the reading size a step up, in primary ink. */
  .quote p {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--text-primary);
  }

  .quote__note {
    margin-top: 0.5rem;
    color: var(--text-tertiary);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .quote__note :global(a) {
    color: var(--text-secondary);
  }

  /* The excerpt reads as the source talking: quoted body text, a hairline
     rule on the left, the source named underneath. */
  .excerpt blockquote {
    padding-left: 1rem;
    border-left: 2px solid var(--hairline-strong);
    color: var(--text-secondary);
    font-size: 1.125rem;
    line-height: 1.6;
  }
</style>
