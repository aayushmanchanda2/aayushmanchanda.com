---
/**
 * ReaderBlocks — what a saved piece says in its own words (VET-246): up to five
 * passages as pull-quotes under a highlighter, then the excerpt, quoted and
 * cited, then his own Raindrop highlights on a private entry, as `.fact` rows of "The source" box (`EntrySection.astro`, VET-279).
 * Never the piece itself: `lib/reader.mjs` caps both, and that cap is
 * the copyright line.
 *
 * The mark is drawn whole in the markup. `styles/prose.css › .hl` arms it (0% wide) only
 * where the pre-paint script has run and motion is allowed, and the script
 * releases each one as it scrolls into view, once. No script, reduced motion
 * and print all get a static, full mark.
 */
import Doodle from "./Doodle.astro";
import EntryLink from "./EntryLink.astro";
import type { Highlight } from "../lib/library";
import type { RaindropHighlight } from "../lib/private";

interface Props {
  highlights: Highlight[];
  excerpt: string | null;
  url: string;
  domain: string;
  /** His own Raindrop highlights, on a private entry. */
  mine?: RaindropHighlight[];
}

const { highlights, excerpt, url, domain, mine = [] } = Astro.props;
---

{
  highlights.length > 0 && (
    <div class="fact">
      <dt>Highlights</dt>
      <dd class="pulled">
        <Doodle class="pulled__bracket" shape="bracket" variant={2} stroke={1.5} stretch draw />
        <ul class="quotes">
          {highlights.map((highlight) => (
            <li>
              <blockquote class="quote" cite={url}>
                <p>
                  <mark class="hl" data-color={highlight.color}>{highlight.text}</mark>
                </p>
              </blockquote>
              {highlight.note && <p class="quote__note">{highlight.note}</p>}
            </li>
          ))}
        </ul>
      </dd>
    </div>
  )
}

{
  excerpt && (
    <div class="fact">
      <dt>Excerpt</dt>
      <dd>
        <figure class="excerpt">
          <blockquote cite={url}>
            <p>{excerpt}</p>
          </blockquote>
          <figcaption class="quote__note">
            From <cite><EntryLink href={url}>{domain}</EntryLink></cite>
          </figcaption>
        </figure>
      </dd>
    </div>
  )
}

{
  mine.length > 0 && (
    <div class="fact">
      <dt>My highlights</dt>
      <dd>
        <ul class="quotes">
          {mine.map((mark) => (
            <li>
              <mark class="hl">{mark.text}</mark>
              {mark.note && <p class="quote__note">{mark.note}</p>}
            </li>
          ))}
        </ul>
      </dd>
    </div>
  )
}

<script>
  import { reveal } from "../lib/reveal";

  // Every sweeping mark on the page; a grid's are static.
  reveal("mark.hl:not([data-static])", "hl--on", 0.5);
</script>

<style>
  /* The pull-quotes sit inside a pen bracket (VET-251), indented to the
     excerpt, so the two quoted blocks start on one edge. */
  .pulled {
    position: relative;
    padding-left: 1rem;
  }

  .pulled__bracket {
    position: absolute;
    left: -0.25rem;
    top: 0.2rem;
    bottom: 0.2rem;
    width: 0.625rem;
    height: calc(100% - 0.4rem);
  }

  .quotes {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* A pull-quote: a step over the row's reading size, in primary ink. */
  .quote p {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text-primary);
  }

  .quote__note {
    margin-top: 0.375rem;
    color: var(--text-tertiary);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .quote__note :global(a) {
    color: var(--text-secondary);
  }

  /* The excerpt reads as the source talking: quoted body text, a hairline
     rule on the left, the source named underneath. */
  .excerpt blockquote {
    padding-left: 1rem;
    border-left: 2px solid var(--hairline-strong);
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>
