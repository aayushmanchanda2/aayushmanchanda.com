---
/**
 * SoundToggle — the UI tick on or off, beside the theme toggle in the footer.
 *
 * Same build as `ThemeToggle.astro`: a 14px glyph in a 40px hit area, swapped
 * by CSS. The state is `aria-pressed` and the name stays "Sound", so a screen
 * reader hears one control that is on or off rather than a name that changes.
 * `lib/ui-sound.ts` owns the press and corrects `aria-pressed` on load; it
 * ships "true", the default for anyone without reduced motion or a choice.
 */
---

<button
  type="button"
  class="st press"
  data-sound-toggle
  aria-label="Sound"
  aria-pressed="true"
  title="Sound on"
>
  <svg class="st__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path
      d="M2 6 H4.5 L8 3 V13 L4.5 10 H2 Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
      stroke-linejoin="round"></path>
    <path
      class="st__on"
      d="M10.5 5.8 A3 3 0 0 1 10.5 10.2 M12.3 4 A5.5 5.5 0 0 1 12.3 12"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"></path>
    <path
      class="st__off"
      d="M10.5 6 L14.5 10 M14.5 6 L10.5 10"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"></path>
  </svg>
</button>

<style>
  .st {
    position: relative;
    display: inline-flex;
    align-self: center;
    cursor: pointer;
    color: var(--text-secondary);
  }

  @media (hover: hover) {
    .st:hover {
      color: var(--accent);
    }
  }

  .st::before {
    content: "";
    position: absolute;
    left: -13px;
    top: -13px;
    width: 40px;
    height: 40px;
  }

  .st__icon {
    display: block;
    width: 14px;
    height: 14px;
  }

  .st[aria-pressed="true"] .st__off,
  .st[aria-pressed="false"] .st__on {
    display: none;
  }
</style>
