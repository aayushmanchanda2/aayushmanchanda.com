---
/**
 * LibraryViews — /library's main area, whose layout follows the kind (VET-258).
 * The list pane beside it (`LibraryPane.astro`) is the index; this is what the
 * kind shows:
 *
 *   - **All**: beside the pane, the editorial front page (`LibraryMix.astro`).
 *     On a phone, where the pane hides, the list is the page (VET-282): Apple
 *     Notes on iPhone, a large title that folds into the top bar as it
 *     scrolls away, the search field and the filters under it, then the rows
 *     as inset groups under their month headers (`LibraryNotes.astro`). A row
 *     opens its entry, whose top bar reads
 *     "‹ Library" (`Breadcrumbs.astro`).
 *   - **Articles**: list-detail. Beside the pane, the newest article opens here
 *     through `EntryDetail`, the entry page's own markup, the way Notes opens
 *     on the latest note. On a phone there is no pane, so the view is the list.
 *   - **Posts**: the `PostWall` grid of `PostCard`s.
 *   - **Videos**: `VideoGrid`, posters at 16:9.
 *
 * Every view ends with its "Also saved" group (`LibraryAlso.astro`): All and
 * each kind count both groups (the filtering model in `lib/library-pane.ts`).
 * A route renders only its own view (B15), and `FILTER`, at the foot of this
 * component, runs the kind, tag and text filter over the view's items.
 */
import Mark from "./Mark.astro";
import EntryDetail from "./EntryDetail.astro";
import LibraryAlso from "./LibraryAlso.astro";
import LibraryFeed from "./LibraryFeed.astro";
import LibraryMix from "./LibraryMix.astro";
import LibraryNotes from "./LibraryNotes.astro";
import LibraryTags from "./LibraryTags.astro";
import LibraryToolbar from "./LibraryToolbar.astro";
import PostWall from "./PostWall.astro";
import VideoGrid from "./VideoGrid.astro";
import type { Kind } from "../lib/library";
import { KIND_BLURBS, feed } from "../lib/library";
import { FILTER, PREPAINT } from "../lib/library-pane";

interface Props {
  /** The view this route shows: its kind, "" for All. */
  start: Kind | "";
}

const { start } = Astro.props;

// The main feed; each view's "Also saved" entries sit in its own group (VET-273).
const of = (kind: Kind) => feed.filter((entry) => entry.kind === kind);
const articles = of("article");
const [reading] = articles;
const posts = of("post").filter((entry) => entry.post !== null);
const videos = of("video");
---

<h1 class="page-title" data-large-title><Mark shape="underline-double" variant={3}>Library</Mark></h1>

<div class="views__bar">
  <LibraryToolbar />
  <LibraryTags />
</div>

{
  start === "" && (
    <section class="view" data-view="" aria-label="Latest">
      <p class="standfirst">
        Articles, posts and videos I saved to read or watch. My agents digested
        some: cliff notes and a call on whether they&rsquo;re worth your time.
      </p>
      <div class="view__body view__mix">
        <LibraryMix />
        <LibraryAlso kind="" />
      </div>
      <LibraryNotes />
    </section>
  )
}

{
  start === "article" && (
    <section class="view" data-view="article" aria-label="Articles">
      {reading && (
        <div class="view__reader">
          <EntryDetail entry={reading} level="h2" />
        </div>
      )}
      <div class="view__list">
        <p class="standfirst">{KIND_BLURBS.article}</p>
        <div class="view__body">
          <LibraryFeed entries={articles} filterable />
          <LibraryAlso kind="article" />
        </div>
      </div>
    </section>
  )
}

{
  start === "post" && (
    <section class="view" data-view="post" aria-label="Posts">
      <p class="standfirst">{KIND_BLURBS.post}</p>
      <div class="view__body">
        <PostWall entries={posts} />
        <LibraryAlso kind="post" />
      </div>
    </section>
  )
}

{
  start === "video" && (
    <section class="view" data-view="video" aria-label="Videos">
      <p class="standfirst">{KIND_BLURBS.video}</p>
      <div class="view__body">
        <VideoGrid entries={videos} />
        <LibraryAlso kind="video" />
      </div>
    </section>
  )
}

<script is:inline set:html={FILTER} />
<script is:inline set:html={PREPAINT} />
<script>
  // The large title folds into the top bar (iOS): while it is on screen the
  // bar's own "Library" steps aside, and it comes back as the title scrolls
  // under the bar. All only, where the bar's last step is "Library" too; a
  // kind route's bar names the kind. Without scripting the bar keeps it.
  const title = document.querySelector('[data-large-title]:has(~ [data-view=""])');
  const root = document.documentElement;
  if (title) {
    new IntersectionObserver(([seen]) => root.toggleAttribute("data-title-shown", !!seen?.isIntersecting), {
      rootMargin: "-100px 0px 0px 0px",
    }).observe(title);
  }
</script>

<style>
  /* The phone toolbar: the pane (and its toolbar) hides under 48rem of the
     split (`LibraryPane.astro`), so this one shows exactly there. */
  .views__bar {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .view__body {
    margin-top: var(--gap-masthead);
  }

  .view :global(.mix__head) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    color: var(--text-tertiary);
  }

  .view :global(.mix__head a) {
    color: var(--text-secondary);
    text-decoration: underline;
    text-decoration-color: var(--hairline-strong);
    text-underline-offset: 3px;
  }

  @media (hover: hover) {
    .view :global(.mix__head a:hover) {
      color: var(--accent);
      text-decoration-color: currentColor;
    }
  }

  /* The phone's list (All, under 48rem): the page is the list, as in Notes. */
  .view__mix,
  .view[data-view=""] .standfirst {
    display: none;
  }

  /* The bar's "Library" steps aside while the large title shows (the script
     above), on a phone where the title folds into the bar. */
  @media (max-width: 767px) {
    :global(.crumbs__here) {
      transition-property: opacity;
      transition-duration: var(--dur-fast);
      transition-timing-function: var(--ease);
    }

    :global(html[data-title-shown] .crumbs__here) {
      opacity: 0;
    }
  }

  @container split (width >= 48rem) {
    .views__bar {
      display: none;
    }

    .view__mix,
    .view[data-view=""] .standfirst {
      display: block;
    }
  }

  /* Articles: the reader beside the pane, the list without one. The reader is
     the entry page's 48rem centred detail. */
  .view__reader {
    display: none;
    max-width: 48rem;
    margin: var(--gap-masthead) auto 0;
  }

  @container split (width >= 48rem) {
    .view__reader {
      display: block;
      margin-top: 0;
    }

    .view__list {
      display: none;
    }

    /* The article is the page there, as on its own: the "Library" masthead
       over it would be a second title, so it stays for a screen reader only. */
    .page-title:has(~ .view[data-view="article"]) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
