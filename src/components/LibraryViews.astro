---
/**
 * LibraryViews — /library's main area, whose layout follows the kind (VET-258).
 * The list pane beside it (`LibraryPane.astro`) is the index; this is what the
 * kind shows:
 *
 *   - **All**: the latest twelve saves as a compact feed (`LibraryFeed`).
 *   - **Articles**: list-detail. Beside the pane, the newest article opens here
 *     through `EntryDetail`, the entry page's own markup, the way Notes opens
 *     on the latest note; a "pick one" empty state would be a click that
 *     shows nothing. On a phone there is no pane, so the view is the list.
 *   - **Posts**: the `PostWall` grid of `PostCard`s.
 *   - **Videos**: posters at 16:9 with the title and the source under them.
 *     A tile opens the entry's page, where the play facade lives.
 *
 * All four render at build, and the route's kind is the one not `hidden`, so
 * without scripting /library shows All and `/library/kind/<kind>` shows its
 * view. `lib/library-pane.ts › FILTER` runs at the foot of this component,
 * after the views exist: it swaps views in place on a segment press, keeps the
 * kind in `?kind=`, and replays it on Back and Forward.
 */
import EntryDetail from "./EntryDetail.astro";
import LibraryFeed from "./LibraryFeed.astro";
import LibraryToolbar from "./LibraryToolbar.astro";
import PostWall from "./PostWall.astro";
import type { Kind, LibraryEntry, Video } from "../lib/library";
import { KIND_BLURBS, entryHref, library } from "../lib/library";
import { FILTER, PREPAINT } from "../lib/library-pane";
import { formatDay } from "../lib/date";

interface Props {
  /** The view shown on load: the route's kind, "" for All. */
  start: Kind | "";
}

const { start } = Astro.props;

/** How many saves the All view leads with. */
const LATEST = 12;

const of = (kind: Kind) => library.filter((entry) => entry.kind === kind);
const articles = of("article");
const [reading] = articles;
/** A video with no poster (`video: null`) has nothing to show; it keeps its pane row. */
const videos = of("video").filter(
  (entry): entry is LibraryEntry & { video: Video } => entry.video !== null,
);
---

<h1 class="page-title">Library</h1>

<div class="views__bar">
  <LibraryToolbar id="view-tag" />
</div>

<section class="view" data-view="" hidden={start !== ""} aria-label="Latest">
  <p class="standfirst">
    Articles, posts and videos I saved to read or watch. The ones I&rsquo;ve
    read carry cliff notes and a call on whether they&rsquo;re worth your time.
  </p>
  <div class="view__body">
    <LibraryFeed entries={library.slice(0, LATEST)} />
  </div>
</section>

<section class="view" data-view="article" hidden={start !== "article"} aria-label="Articles">
  {
    reading && (
      <div class="view__reader">
        <EntryDetail entry={reading} level="h2" />
      </div>
    )
  }
  <div class="view__list">
    <p class="standfirst">{KIND_BLURBS.article}</p>
    <div class="view__body">
      <LibraryFeed entries={articles} filterable />
    </div>
  </div>
</section>

<section class="view" data-view="post" hidden={start !== "post"} aria-label="Posts">
  <p class="standfirst">{KIND_BLURBS.post}</p>
  <div class="view__body">
    <PostWall entries={of("post")} />
  </div>
</section>

<section class="view" data-view="video" hidden={start !== "video"} aria-label="Videos">
  <p class="standfirst">{KIND_BLURBS.video}</p>
  <ul class="view__body vgrid">
    {
      videos.map((entry) => (
        <li data-tags={entry.tags.join(" ")}>
          <a class="vtile" href={entryHref(entry)}>
            <img class="vtile__thumb outlined" src={entry.video.thumb} alt="" loading="lazy" decoding="async" />
            <b>{entry.title}</b>
            <small>
              <span>{entry.domain}</span>
              <time datetime={entry.saved_date}>{formatDay(entry.saved_date)}</time>
            </small>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<script is:inline set:html={FILTER} />
<script is:inline set:html={PREPAINT} />

<style>
  /* The phone toolbar: the pane (and its toolbar) hides under 48rem of the
     split (`LibraryPane.astro`), so this one shows exactly there. */
  .views__bar {
    margin-top: 1.5rem;
  }

  @container split (width >= 48rem) {
    .views__bar {
      display: none;
    }
  }

  .view__body {
    margin-top: var(--gap-masthead);
  }

  /* Articles: the reader beside the pane, the list without one. The reader is
     the entry page's 48rem centred detail. */
  .view__reader {
    display: none;
    max-width: 48rem;
    margin: var(--gap-masthead) auto 0;
  }

  @container split (width >= 48rem) {
    .view__reader {
      display: block;
      margin-top: 0;
    }

    .view__list {
      display: none;
    }

    /* The article is the page there, as on its own: the "Library" masthead
       over it would be a second title, so it stays for a screen reader only. */
    .page-title:has(~ .view[data-view="article"]:not([hidden])) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* Videos: posters at 16:9, 15rem at the least: three across beside the
     pane at 1280px, four at 1600, one on a phone. */
  .vgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    gap: 2rem 1rem;
  }

  .vtile {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--text-primary);
    text-decoration: none;
  }

  /* A poster's shape is known, so 16:9 rather than §8's 8:5 crop; a 480x360
     fallback still lands right under `cover` (`VideoFacade.astro`). */
  .vtile__thumb {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: 0.5rem;
  }

  .vtile b {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .vtile small {
    display: flex;
    gap: 0.4rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text-tertiary);
  }

  .vtile small > * + *::before {
    content: "\00b7" / "";
    margin-right: 0.4rem;
  }

  /* Instant, like every tile a pointer sweeps across (design.md §4). */
  @media (hover: hover) {
    .vtile:hover .vtile__thumb {
      opacity: 0.82;
    }

    .vtile:hover b {
      color: var(--accent);
    }
  }
</style>
