---
/**
 * MobileNav — the emblemo flourish below 900px.
 *
 * A rotated vertical "MENU" label welded to the left edge; tapping it slides a
 * full-height electric-blue panel in from the left, white items in Geist Mono,
 * entering on a ~70ms stagger. Every transition is a CSS transition (never a
 * keyframe animation) so an interrupted open/close reverses from wherever it
 * happens to be, rather than snapping.
 *
 * "below 900px", not "< 900px", and that is not a style preference. A bare `<`
 * anywhere in the frontmatter — inside a comment included — makes the Astro
 * compiler lose the `Props` interface when it generates TSX, so `Astro.props`
 * degrades to `Record<string, any>` and every prop on this component silently
 * stops being typed. `npm run check` is what caught it. Write the word.
 */
import ThemeToggle from "./ThemeToggle.astro";
import { normalize } from "../lib/links";
import type { NavItem } from "../lib/sections";

interface Props {
  items: NavItem[];
  pathname: string;
}

const { items, pathname } = Astro.props;

const current = normalize(pathname);
---

<div class="mnav" data-mnav>
  <button
    type="button"
    class="mnav__trigger mono press"
    data-mnav-toggle
    aria-expanded="false"
    aria-controls="mobile-nav-panel"
  >
    Menu
  </button>

  <div class="mnav__scrim" data-mnav-scrim hidden></div>

  <div
    class="mnav__panel"
    id="mobile-nav-panel"
    data-mnav-panel
    role="dialog"
    aria-modal="true"
    aria-label="Site navigation"
    style={`--search-i:${items.length}`}
  >
    <button
      type="button"
      class="mnav__close press"
      data-mnav-close
      aria-label="Close menu"
    >
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path
          d="M3 3 L13 13 M13 3 L3 13"
          stroke="currentColor"
          stroke-width="1.25"
          stroke-linecap="square"></path>
      </svg>
    </button>

    <nav aria-label="Primary">
      <ul class="mnav__list">
        {
          items.map((item, i) => (
            <li class="mnav__item" style={`--i:${i}`}>
              <a
                class="mnav__link"
                href={item.href}
                data-mnav-link
                aria-current={
                  normalize(item.href) === current ? "page" : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/*
      The two controls a touch reader cannot get to any other way: the palette,
      which has no Cmd+K to press here, and the theme, whose only other home is
      a footer that is a long scroll away below 900px.

      Deliberately quieter than the section links and set below them: these are
      ways to work the site, not a sixth and seventh section. They enter
      together on the beat after the last link, continuing the same stagger.
    */}
    <div class="mnav__actions">
      {/*
        `data-mnav-search` is what the script below hangs the "close this panel
        first" behaviour on; `data-palette-open` is what `lib/palette.ts`
        listens for.
      */}
      <button
        class="mnav__search mono press"
        type="button"
        data-mnav-search
        data-palette-open
      >
        Search
      </button>

      <ThemeToggle variant="panel" />
    </div>
  </div>
</div>

<style>
  .mnav {
    display: block;
  }

  @media (min-width: 900px) {
    .mnav {
      display: none;
    }
  }

  /* --- edge label -------------------------------------------------------- */

  .mnav__trigger {
    position: fixed;
    top: 50%;
    /* Welded to the left edge, which in landscape on a notched phone is the
       edge the notch is on. Inert until `viewport-fit=cover`; see the panel
       below and design.md §3. */
    left: env(safe-area-inset-left);
    translate: 0 -50%;
    z-index: 60;
    /* reads bottom-to-top, like the emblemo edge label */
    writing-mode: vertical-rl;
    rotate: 180deg;
    padding: 1rem 0.75rem;
    color: var(--muted);
    cursor: pointer;
    /* a tap must open the menu, not select the word "Menu" */
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition-property: color;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease);
  }

  /* The hover half is gated: closing the panel puts this control back on
     screen, and on touch the tap that opened it latches `:hover` — the label
     would sit accent-blue after the panel had gone, reading as stuck
     (design.md §4). The expanded state is real state and stays ungated. */
  @media (hover: hover) {
    .mnav__trigger:hover {
      color: var(--accent);
    }
  }

  .mnav__trigger[aria-expanded="true"] {
    color: var(--accent);
  }

  /* --- scrim ------------------------------------------------------------- */

  .mnav__scrim {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: rgb(0 0 0 / 0.4);
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--dur);
    transition-timing-function: var(--ease-out);
  }

  .mnav__scrim[hidden] {
    display: none;
  }

  .mnav__scrim[data-open] {
    opacity: 1;
  }

  /* --- panel ------------------------------------------------------------- */

  .mnav__panel {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 80;
    width: min(86vw, 380px);
    height: 100%;
    height: 100svh;

    /* A full-height sheet against the left edge: in portrait its foot is under
       the home indicator, in landscape its whole left side is under the notch.
       `max()` rather than adding the inset to the padding — the panel's own
       padding is already larger than every inset on every current device, so
       adding would double-pad it; `max()` only ever takes over when an inset is
       genuinely bigger than the breathing room the design already asked for.

       Inert today. `env()` is `0px` until the viewport meta says
       `viewport-fit=cover`, and `layouts/Base.astro` does not say it, so iOS
       letterboxes the page and there is nothing under a notch to fix. Written
       now because the padding is the thing that would be wrong first, and
       because `max()` degrades to exactly the old `clamp()` while the insets
       are zero — this is a no-op on today's build by construction, not by
       luck. design.md §3 carries the note and the audit that flipping the meta
       would need. */
    --mnav-pad: clamp(1.5rem, 6vw, 2.5rem);
    padding-top: max(var(--mnav-pad), env(safe-area-inset-top));
    padding-right: max(var(--mnav-pad), env(safe-area-inset-right));
    padding-bottom: max(var(--mnav-pad), env(safe-area-inset-bottom));
    padding-left: max(var(--mnav-pad), env(safe-area-inset-left));

    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--accent-panel);
    color: var(--accent-panel-ink);
    overscroll-behavior: contain;
    overflow-y: auto;

    visibility: hidden;
    transform: translateX(-100%);
    /* transform animates; visibility flips only after the slide-out finishes */
    transition-property: transform, visibility;
    transition-duration: var(--dur-slow), 0s;
    transition-delay: 0s, var(--dur-slow);
    transition-timing-function: var(--ease-out);
  }

  .mnav__panel[data-open] {
    visibility: visible;
    transform: translateX(0);
    transition-delay: 0s, 0s;
  }

  .mnav__close {
    position: absolute;
    top: clamp(0.75rem, 4vw, 1.25rem);
    right: clamp(0.75rem, 4vw, 1.25rem);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: var(--accent-panel-ink);
    cursor: pointer;
    opacity: 0.75;
  }

  .mnav__close:hover {
    opacity: 1;
  }

  .mnav__close svg {
    width: 16px;
    height: 16px;
  }

  .mnav__close:focus-visible,
  .mnav__link:focus-visible {
    outline: 2px solid var(--accent-panel-ink);
    outline-offset: 4px;
  }

  /* --- items ------------------------------------------------------------- */

  .mnav__list {
    display: flex;
    flex-direction: column;
    gap: clamp(0.35rem, 2vw, 0.75rem);
    margin: 0;
  }

  .mnav__item {
    opacity: 0;
    transform: translateX(-14px);
    transition-property: opacity, transform;
    transition-duration: var(--dur);
    transition-timing-function: var(--ease-out);
    /* closing: everything leaves together, no stagger to sit through */
    transition-delay: 0s;
  }

  .mnav__panel[data-open] .mnav__item {
    opacity: 1;
    transform: translateX(0);
    transition-delay: calc(80ms + var(--i) * 70ms);
  }

  .mnav__link {
    display: inline-block;
    position: relative;
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 8.5vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: var(--accent-panel-ink);
    text-decoration: none;
    padding-block: 0.15em;
    transition-property: opacity;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease);
  }

  .mnav__link:not([aria-current]) {
    opacity: 0.62;
  }

  .mnav__link:hover,
  .mnav__link:active {
    opacity: 1;
  }

  /* current page marker — a hairline under the label */
  .mnav__link[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.1em;
    height: 1px;
    background: currentColor;
  }

  /* --- actions ------------------------------------------------------------ */

  /* The row is what enters, not the controls in it: one delay to keep in step
     with the links above instead of one per control. */
  .mnav__actions {
    align-self: start;
    margin-top: clamp(1.5rem, 6vw, 2.25rem);
    display: flex;
    align-items: center;
    gap: 1.25rem;
    opacity: 0;
    transform: translateX(-14px);
    transition-property: opacity, transform;
    transition-duration: var(--dur);
    transition-timing-function: var(--ease-out);
    transition-delay: 0s;
  }

  .mnav__panel[data-open] .mnav__actions {
    opacity: 1;
    transform: translateX(0);
    /* Lands after the last section link, continuing the same stagger. */
    transition-delay: calc(80ms + var(--search-i, 6) * 70ms);
  }

  /* No `transition-property` here: this button carries `.press`, which already
     names `border-color`, and a second declaration would race it depending on
     stylesheet order. The entrance belongs to the row above. */
  .mnav__search {
    padding: 0.5rem 0.9rem;
    color: var(--accent-panel-ink);
    border: 1px solid rgb(255 255 255 / 0.4);
    cursor: pointer;
  }

  .mnav__search:hover {
    border-color: var(--accent-panel-ink);
  }

  .mnav__search:focus-visible {
    outline: 2px solid var(--accent-panel-ink);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .mnav__item,
    .mnav__actions {
      transform: none;
    }
    .mnav__panel {
      transition-delay: 0s, 0s;
    }
  }
</style>

<script>
  function initMobileNav(root: HTMLElement) {
    const toggle = root.querySelector<HTMLButtonElement>("[data-mnav-toggle]");
    const panel = root.querySelector<HTMLElement>("[data-mnav-panel]");
    const scrim = root.querySelector<HTMLElement>("[data-mnav-scrim]");
    const close = root.querySelector<HTMLButtonElement>("[data-mnav-close]");
    if (!toggle || !panel || !scrim || !close) return;

    const desktop = window.matchMedia("(min-width: 900px)");
    let open = false;

    // A const arrow rather than a function declaration, so the four non-null
    // narrowings the guard above just established still hold inside it. A
    // hoisted `function` is reachable from before the guard as far as
    // TypeScript is concerned, which is what used to force a `!` onto every
    // one of these lines.
    const setOpen = (next: boolean) => {
      if (next === open) return;
      open = next;

      toggle.setAttribute("aria-expanded", String(next));
      document.documentElement.style.overflow = next ? "hidden" : "";

      /**
       * The panel is `aria-modal`, and `inert` is what makes that true for a
       * keyboard: without it, Tab walks off the last control in here and into
       * the page behind the scrim — focusable, invisible, pointer-dead. The
       * marked surfaces are the shell, the skip link and the site mark
       * (`layouts/Base.astro`, `SiteMark.astro`); the theme live region is
       * deliberately unmarked so the panel's own toggle still announces. The
       * trigger goes inert too — it sits under the scrim while the panel is
       * up — and comes back before focus returns to it below.
       */
      const inertables = Array.from(
        document.querySelectorAll<HTMLElement>("[data-mnav-inert]"),
      );

      if (next) {
        scrim.hidden = false;
        // one frame so the [hidden] -> display change lands before the
        // opacity transition starts
        requestAnimationFrame(() => scrim.setAttribute("data-open", ""));
        panel.setAttribute("data-open", "");
        close.focus({ preventScroll: true });
        for (const el of inertables) el.inert = true;
        toggle.inert = true;
      } else {
        for (const el of inertables) el.inert = false;
        toggle.inert = false;
        scrim.removeAttribute("data-open");
        panel.removeAttribute("data-open");
        toggle.focus({ preventScroll: true });
      }
    };

    // Keep the scrim out of the a11y/hit-test tree once it has faded out,
    // but never mid-transition (that would kill the fade).
    scrim.addEventListener("transitionend", (e) => {
      if (e.propertyName === "opacity" && !open) scrim.hidden = true;
    });

    toggle.addEventListener("click", () => setOpen(!open));
    close.addEventListener("click", () => setOpen(false));
    scrim.addEventListener("click", () => setOpen(false));

    // Close on item tap (matters for same-page links, where no navigation
    // would otherwise tear the panel down).
    root
      .querySelectorAll<HTMLAnchorElement>("[data-mnav-link]")
      .forEach((link) => link.addEventListener("click", () => setOpen(false)));

    /**
     * The search row hands over to the palette, and this panel gets out of the
     * way first — two stacked modals is a state neither of them should have to
     * reason about.
     *
     * This listener is on the button, so it runs in the target phase, before
     * the delegated `[data-palette-open]` listener that `lib/palette.ts` puts
     * on `document` sees the same click in the bubble phase. That ordering is
     * the DOM's, not a bundling accident: the panel is always closed by the
     * time the palette opens and takes focus.
     */
    root
      .querySelector<HTMLButtonElement>("[data-mnav-search]")
      ?.addEventListener("click", () => setOpen(false));

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || !open) return;

      // An open palette owns Escape. Asked of the document rather than settled
      // by listener order, which is a bundling detail: the same reasoning the
      // /sites entry pages use for their own Escape handler. In practice the
      // two are never open together — the search row above closes this panel
      // on its way out — so this is the guard for the case where something
      // opens the palette while the panel is up without going through it.
      if (document.querySelector("[data-palette][data-open]")) return;

      e.preventDefault();
      setOpen(false);
    });

    // Rotating a phone into the desktop breakpoint hides the panel via CSS —
    // make sure the scroll lock and focus state go with it.
    desktop.addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }

  document
    .querySelectorAll<HTMLElement>("[data-mnav]")
    .forEach((root) => initMobileNav(root));
</script>
