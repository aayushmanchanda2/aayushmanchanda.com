---
/**
 * MobileNav — the section nav, at every width.
 *
 * A four-dot menu button at the left of the top bar; pressing it slides a
 * full-height electric-blue panel in from the left, white items in Geist Mono,
 * entering on a ~70ms stagger. Every transition is a CSS transition (never a
 * keyframe animation) so an interrupted open/close reverses from wherever it
 * happens to be, rather than snapping.
 *
 * This file is the trigger and the scrim; `MobileNavPanel.astro` is the panel
 * and `lib/mnav.ts` the open and close.
 *
 * Never type the less-than sign in this frontmatter. A bare one
 * anywhere in it — inside a comment included — makes the Astro
 * compiler lose the `Props` interface when it generates TSX, so `Astro.props`
 * degrades to `Record<string, any>` and every prop on this component silently
 * stops being typed. `npm run check` is what caught it. Write the word.
 */
import MobileNavPanel from "./MobileNavPanel.astro";
import type { NavItem } from "../lib/sections";

interface Props {
  items: NavItem[];
  pathname: string;
}

const { items, pathname } = Astro.props;
---

<div class="mnav" data-mnav>
  {/*
    Four 4px squares in a 2x2 grid, 3px apart, swapping to an X while the
    panel is open. The label carries the verb because the glyph has no word.
  */}
  <button
    type="button"
    class="mnav__trigger press"
    data-mnav-toggle
    aria-expanded="false"
    aria-controls="mobile-nav-panel"
    aria-label="Open menu"
  >
    <svg class="mnav__dots" viewBox="0 0 11 11" aria-hidden="true" focusable="false">
      <path d="M0 0h4v4H0zM7 0h4v4H7zM0 7h4v4H0zM7 7h4v4H7z" fill="currentColor"></path>
    </svg>
    <svg class="mnav__x" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <path
        d="M5 5 L15 15 M15 5 L5 15"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        fill="none"></path>
    </svg>
  </button>

  <div class="mnav__scrim" data-mnav-scrim hidden></div>

  <MobileNavPanel items={items} pathname={pathname} />
</div>

<style>
  /* --- trigger --------------------------------------------------------- */

  /* The first thing in the top bar (`layouts/Base.astro`), at every width:
     with the dash rail gone (VET-225), this panel is the section nav on
     desktop too. A 40px square, 44px under a finger. */
  .mnav__trigger {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r-md);
    color: var(--text-secondary);
    cursor: pointer;
    transition-property: color, background-color;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease);
  }

  @media (pointer: coarse) {
    .mnav__trigger {
      width: 44px;
      height: 44px;
    }
  }

  .mnav__dots { width: 11px; height: 11px; shape-rendering: crispEdges; }
  .mnav__x { display: none; width: 20px; height: 20px; }
  .mnav__trigger[aria-expanded="true"] .mnav__dots { display: none; }
  .mnav__trigger[aria-expanded="true"] .mnav__x { display: block; }

  /* The hover half is gated: closing the panel puts this control back on
     screen, and on touch the tap that opened it latches `:hover` — the button
     would sit tinted after the panel had gone, reading as stuck (design.md
     §4). The expanded state is real state and stays ungated. */
  @media (hover: hover) {
    .mnav__trigger:hover {
      background: var(--surface-3);
      color: var(--text-primary);
    }
  }

  .mnav__trigger[aria-expanded="true"] {
    color: var(--text-primary);
  }

  /* --- scrim ------------------------------------------------------------- */

  .mnav__scrim {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: rgb(0 0 0 / 0.4);
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--dur);
    transition-timing-function: var(--ease-out);
  }

  .mnav__scrim[hidden] {
    display: none;
  }

  .mnav__scrim[data-open] {
    opacity: 1;
  }

</style>

<script>
  import { initMobileNav } from "../lib/mnav";

  for (const root of document.querySelectorAll<HTMLElement>("[data-mnav]")) initMobileNav(root);
</script>
