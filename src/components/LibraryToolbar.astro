---
/**
 * LibraryToolbar — the kind segments and a live count (VET-245). It tops the
 * list pane on every library page, and /library draws a second one above its
 * view for phones, where the pane is hidden (VET-258). The tag filter sits
 * under it (`LibraryTags.astro`, VET-267). `lib/library-pane.ts › FILTER`
 * wires every copy on the page.
 */
import KindSegments from "./KindSegments.astro";
import { kindGroups, library } from "../lib/library";
---

<div class="ltools">
  <KindSegments groups={kindGroups} total={library.length} />
  <p class="ltools__count tabular-nums" aria-live="polite" data-filter-count>{library.length} entries</p>
</div>

<style is:global>
  /* Global and namespaced, like the pane: no scoped-style attributes on 139
     pages. */
  /* A container, so the segments can drop their counts by the room they get
     (`KindSegments.astro`), not by the viewport. */
  .ltools {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ltools .seg {
    width: 100%;
  }

  .ltools__count {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    white-space: nowrap;
  }
</style>
