---
/**
 * LibraryToolbar — the kind segments and a live count (VET-245). It tops the
 * list pane on every library page, and /library draws a second one above its
 * view for phones, where the pane is hidden (VET-258). The tag filter sits
 * under it (`LibraryTags.astro`, VET-267). `lib/library-pane.ts › FILTER`
 * wires every copy on the page. Every count here is the main feed's; the
 * "Also saved" group counts itself in the pane (VET-273).
 */
import KindSegments from "./KindSegments.astro";
import { feed, kindGroups } from "../lib/library";

const groups = kindGroups.map((group) => ({ ...group, entries: group.entries.filter((entry) => !entry.also_saved) }));
---

<div class="ltools">
  <KindSegments groups={groups} total={feed.length} />
  <p class="ltools__count tabular-nums" aria-live="polite" data-filter-count>{feed.length} entries</p>
</div>

<style is:global>
  /* Global and namespaced, like the pane: no scoped-style attributes on every
     entry page. */
  /* A container, so the segments can drop their counts by the room they get
     (`KindSegments.astro`), not by the viewport. */
  .ltools {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ltools .seg {
    width: 100%;
  }

  .ltools__count {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    white-space: nowrap;
  }
</style>
