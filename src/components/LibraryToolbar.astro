---
/**
 * LibraryToolbar — the kind segments, a tag select and a live count (VET-245).
 * It tops the list pane on every library page, and /library draws a second one
 * above its view for phones, where the pane is hidden (VET-258).
 * `lib/library-pane.ts › FILTER` wires every copy on the page; `id` keeps the
 * two selects' labels apart.
 */
import KindSegments from "./KindSegments.astro";
import { kindGroups, library, libraryTags } from "../lib/library";
import { tagLabel } from "../lib/tags";

interface Props {
  id: string;
}

const { id } = Astro.props;

/** Busiest first, ties alphabetical: `TagFilters.astro`'s order. */
const tags = [...libraryTags].sort(
  (a, b) => b.entries.length - a.entries.length || a.slug.localeCompare(b.slug),
);
---

<div class="ltools">
  <KindSegments groups={kindGroups} total={library.length} />
  <div class="ltools__row">
    <label class="visually-hidden" for={id}>Tag</label>
    <select class="select" id={id} data-tag-set>
      <option value="">All tags</option>
      {tags.map((group) => <option value={group.slug}>{tagLabel(group.slug)} ({group.entries.length})</option>)}
    </select>
    <p class="ltools__count tabular-nums" aria-live="polite" data-filter-count>{library.length} entries</p>
  </div>
</div>

<style is:global>
  /* Global and namespaced, like the pane: no scoped-style attributes on 139
     pages. */
  .ltools {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ltools .seg {
    width: 100%;
  }

  .ltools__row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .ltools__row .select {
    flex: 1;
    min-width: 0;
  }

  .ltools__count {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    white-space: nowrap;
  }
</style>
