---
/**
 * TagChips — what a saved link is about, as links out to everything else
 * filed the same way.
 *
 * The sibling of `CollectionChips.astro`, one section over and one vocabulary
 * apart. A collection is gray because a collection name means nothing on a
 * scale and a row of them belongs under a palette; a tag is the same kind of
 * word but it lives in a *column*, twenty rows deep, and there the job changes:
 * the reader is scanning for the two or three rows about one thing.
 *
 * It went dot, then hued outline with a drawn mark, then plain (VET-219): a
 * grey outlined box with the word in it, ibelick/ui-skills' TopicTag. The word
 * is what a reader scans for, so nothing else competes with it.
 * `styles/chip.css › .tag` is the whole paint.
 *
 * The label drops the hyphens (`tagLabel`), the href keeps them. The slug is
 * the filter value and the join key; the reader only ever needs the words.
 * A chip opens /library filtered to its tag (`?tags=`, VET-282): the tag
 * pages that stood alone are gone, and `vercel.json` 308s their URLs there.
 *
 * A row of these on an entry says what that entry is about.
 * `components/LibraryTags.astro` is the other shape the same chip takes, the
 * library's tag filter, and the two share `.tag` so a chip a reader pressed on
 * a row and a tag they ticked in the filter are visibly the same control.
 */
import { tagLabel } from "../lib/tags";

interface Props {
  /** Tag slugs, as stored on the entry. */
  tags: string[];
}

const { tags } = Astro.props;
---

<ul class="tags">
  {
    tags.map((slug) => (
      <li>
        <a class="tag" href={`/library?tags=${slug}`}>
          {tagLabel(slug)}
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* A `ul`, so a link about two things is two items to anything reading the
     page out loud. `global.css` already takes the bullets and the padding off
     every list on the site.

     The row gap is the one number here worth explaining: each 28px chip claims
     a 40px hit area through an `::after` that reaches 0.375rem above and below
     it, so two wrapped lines closer than 0.75rem would have overlapping targets
     and the upper chip would eat presses meant for the lower one. Adjacent
     targets may touch, never overlap. The column gap is ui-skills' `gap-2`. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 0.5rem;
    margin: 0;
  }

  /* A block `li` puts an `inline-flex` chip in a line box, and a line box is as
     tall as the inherited strut — 25.59px of it round the old 20.27px chip, so
     a wrapped row of tags carried 5.32px of leading nobody asked for and the
     chips did not sit where the gap said they would. A flex item blockifies its
     child and the strut has nothing to hold. Aayush noticed
     it on the old tag filter row (VET-114). */
  .tags li {
    display: flex;
  }
</style>
