---
/**
 * TagChips — what a saved link is about, as links out to everything else
 * filed the same way.
 *
 * The sibling of `CollectionChips.astro`, one section over and one vocabulary
 * apart. A collection is gray because a collection name means nothing on a
 * scale and a row of them belongs under a palette; a tag is the same kind of
 * word but it lives in a *column*, twenty rows deep, and there the job changes:
 * the reader is scanning for the two or three rows about one thing.
 *
 * So the hue draws the outline and the mark inside it, and the words stay at
 * the page's ink. It shipped as a 6px dot first and Aayush reversed it on
 * sight: the dot was too quiet to find a subject by, which is the one thing it
 * was there to do. `styles/chip.css › .tag` is the whole paint and carries the
 * reversal; `components/TagGlyph.astro` is the drawing; `lib/tags.ts` decides
 * which of the seven hues each word wears.
 *
 * The label drops the hyphens (`tagLabel`), the href keeps them. The slug is
 * the route and the join key; the reader only ever needs the words.
 *
 * A row of these on an entry says what that entry is about.
 * `components/TagFilters.astro` is the other shape the same chip takes — the
 * whole vocabulary at the top of a list, with the one you are standing on
 * marked — and the two share `.tag` so a chip a reader pressed on a row and a
 * chip they pressed at the top of the page are visibly the same control.
 */
import TagGlyph from "./TagGlyph.astro";
import { hueSlot, tagLabel } from "../lib/tags";

interface Props {
  /** Tag slugs, as stored on the entry. */
  tags: string[];
}

const { tags } = Astro.props;
---

<ul class="tags">
  {
    tags.map((slug) => (
      <li>
        <a class="tag" data-hue={hueSlot(slug)} href={`/library/tag/${slug}`}>
          <TagGlyph slug={slug} />
          {tagLabel(slug)}
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* A `ul`, so a link about two things is two items to anything reading the
     page out loud. `global.css` already takes the bullets and the padding off
     every list on the site.

     The row gap is the one number here worth explaining: each chip claims a
     40px hit area through an `::after` that reaches 0.62rem above and below it,
     so two wrapped lines closer than 1.25rem would have overlapping targets and
     the upper chip would eat presses meant for the lower one. Same arithmetic
     the rail dashes settle at a 41px pitch, and the same conclusion: adjacent
     targets may touch, never overlap. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 0.5rem;
    margin: 0;
  }

  /* A block `li` puts an `inline-flex` chip in a line box, and a line box is as
     tall as the inherited strut — 25.59px of it round a 20.27px chip, so a
     wrapped row of tags carried 5.32px of leading nobody asked for and the
     chips did not sit where the gap said they would. A flex item blockifies its
     child and the strut has nothing to hold. `TagFilters.astro › .filters__row
     li` is the same line for the same reason, and it is where Aayush noticed
     it. */
  .tags li {
    display: flex;
  }
</style>
