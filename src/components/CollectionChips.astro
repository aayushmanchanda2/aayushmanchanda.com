---
/**
 * CollectionChips — the collections one site is in, as links out to them.
 *
 * Fourth user of the chip vocabulary in `styles/chip.css`, after VerdictBadge,
 * StatusChip and KindChip, and now the only user of the `chip--link` form:
 * these are filters, so they get the filter's affordances rather than a
 * label's. The other filter bar the site had, the one over /library, is a
 * segmented control now (`KindSegments.astro`). It needed a selected state,
 * and a chip's tone is already spent saying something else.
 *
 * Gray, always. The other three components pick a tone per word because their
 * words mean something on a scale — `using` is not `skipped`, `shipped` is not
 * `paused`. A collection name means nothing of the sort; `portfolios` is not
 * better or worse than `personal-sites`, and colouring them would invent a
 * gradient that is not there. Gray is also the quietest tone in the system,
 * which is right for a row that sits in a facts table under a palette.
 *
 * The label drops the hyphens (`collectionLabel`), the href keeps them. The
 * slug is the route and the join key; the reader only ever needs the words.
 *
 * Three places draw it: a site's facts, the filter row on /sites, and the
 * /sites list's Collections column, where `linked={false}` makes them labels
 * because the whole row is already one link to the site.
 */
import { collectionLabel } from "../lib/sites";

interface Props {
  /** Collection slugs, as stored on the entry. */
  collections: string[];
  /** Off inside a row that is already a link. */
  linked?: boolean;
}

const { collections, linked = true } = Astro.props;
---

<ul class="collections">
  {
    collections.map((slug) => (
      <li>
        {linked ? (
          <a class="chip chip--link" data-tone="gray" href={`/sites/collection/${slug}`}>
            {collectionLabel(slug)}
          </a>
        ) : (
          <span class="chip" data-tone="gray">{collectionLabel(slug)}</span>
        )}
      </li>
    ))
  }
</ul>

<style>
  /* A `ul`, so a site being in three collections is three items to anything
     reading the page out loud rather than one run-on line. `global.css` already
     takes the bullets and the padding off every list on the site. */
  .collections {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
  }

  /* 44px under a finger (VET-307). Two wrapped 44px targets that do not
     overlap need 44px from line to line, so the chip grows to the `.tag`'s
     28px and the lines sit 16px apart, the /library tag rhythm, instead of a
     21px chip with a 29px hole under it (VET-57). The flex item drops the
     line box that padded each chip by 5px more. */
  @media (pointer: coarse) {
    .collections {
      row-gap: 1rem;
    }

    .collections li {
      display: flex;
    }

    .collections :global(.chip--link) {
      position: relative;
      padding-block: 0.5rem;
    }

    .collections :global(.chip--link)::after {
      content: "";
      position: absolute;
      inset: -8px 0;
    }
  }
</style>
