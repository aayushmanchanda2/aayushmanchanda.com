---
/**
 * "Sign out" on /me pages (VET-274 follow-up): Clerk's `signOut`, then home.
 * Its script loads Clerk the way `ClerkSignIn.astro` does, so render it on
 * /me pages only; the key comes from the data Clerk's middleware writes into
 * /me responses. `bar` is the copy in the top bar (`Base.astro`'s `bar` slot).
 */
interface Props {
  bar?: boolean;
}

const { bar = false } = Astro.props;
---

<button type="button" class:list={["signout mono press", bar && "signout--bar"]} data-sign-out>Sign out</button>

<script>
  import { runInjectionScript } from "@clerk/astro/internal";

  // A load that fails (no key on this deployment) leaves the button to retry.
  const loaded = runInjectionScript({}).catch(() => undefined);
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-sign-out]")) {
    button.addEventListener("click", async () => {
      button.disabled = true;
      await loaded;
      if (window.Clerk) await window.Clerk.signOut({ redirectUrl: "/" });
      else button.disabled = false;
    });
  }
</script>

<style>
  /* The bar's search control's look: a text button, secondary ink, accent on hover. */
  .signout {
    flex-shrink: 0;
    min-height: 40px;
    padding: 0.625rem 0.5rem;
    color: var(--text-secondary);
    cursor: pointer;
    transition-property: color;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease);
  }

  .signout:disabled {
    cursor: progress;
    color: var(--text-tertiary);
  }

  @media (hover: hover) {
    .signout:not(:disabled):hover {
      color: var(--accent);
    }
  }

  /* Search holds the bar's free space from 600px; under it search is hidden and this takes it. */
  .signout--bar {
    margin-left: auto;
  }

  @media (min-width: 600px) {
    .signout--bar {
      margin-left: 0.25rem;
    }
  }
</style>
