---
/**
 * KindIcon — a 14px glyph for what a library row points at: a page for an
 * article, a speech bubble for a post, a play mark for a video. Drawn on the
 * icon system's 16-unit grid at a 1.25 stroke (`ShotActions.astro`), in
 * `--text-tertiary`, so it is a shape the eye can scan down a list without
 * adding a colour.
 *
 * A CSS mask rather than an inline `<svg>`, because the pane repeats 139 rows
 * on 139 pages: a row pays for one element. The kind's word stays inside it,
 * pushed out of the box (image replacement, not `display: none`), so a screen
 * reader still hears it. The styles are global (`styles/kind-icon.css`)
 * because the ⌘K palette builds the same `<i>` in the browser on every page.
 */
import type { Kind } from "../lib/library";

interface Props {
  kind: Kind;
}

const { kind } = Astro.props;
---

<i class="ki" data-kind={kind}>{kind}</i>
