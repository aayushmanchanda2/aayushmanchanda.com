---
/**
 * Base — the site shell: fonts, tokens, the top bar, footer.
 *
 * Fonts are bundled from npm (@fontsource-variable/*) and served from our own
 * origin. The site loads nothing from a third-party CDN.
 */
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
// `?url` imports so the preload links below carry the same hashed filenames
// the bundled CSS references. A hand-written path would break silently on the
// next @fontsource update: the preload would 404, the CSS would still work,
// and every page would quietly pay for a file it never uses.
import geistLatinWoff2 from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistMonoLatinWoff2 from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import "../styles/global.css";
// after global.css: both of these read tokens defined there
import "../styles/chip.css";
import "../styles/palette.css";
import "../styles/kind-icon.css";
import "../styles/prose.css";
import "../styles/frame.css";
import "../styles/forced-colors.css";

import CommandPalette from "../components/CommandPalette.astro";
import Footer from "../components/Footer.astro";
import PullRefresh from "../components/PullRefresh.astro";
import Stamp from "../components/Stamp.astro";
import TopBar from "../components/TopBar.astro";
import { normalize } from "../lib/links";
import { markdownVariantFor } from "../lib/markdown";
import type { Crumb, JsonLd } from "../lib/schema";
import { serialize, trailOf } from "../lib/schema";
import type { NavItem } from "../lib/sections";
import { FEEDS, getSections } from "../lib/sections";
import { type OgImage, ogImageFor } from "../lib/og";
import { absolute } from "../lib/site";
import { PREPAINT, THEME_COLORS } from "../lib/theme";
import { PREPAINT as SOUND_PREPAINT } from "../lib/ui-sound";
import { signedInCheck } from "../lib/signed-in-check";

interface Props {
  title?: string;
  description?: string;
  /**
   * Structured data for this page, serialised into one `ld+json` block.
   *
   * A prop rather than a `<slot name="head">` because the value is data, not
   * markup: the layout keeps sole ownership of how it gets serialised, and a
   * page cannot push arbitrary script into the head through it.
   *
   * Typed as `JsonLd` rather than a bare object, so the only thing a page can
   * pass is something a builder in `lib/schema.ts` returned. That is what keeps
   * the parity rule enforceable in one file instead of on twelve pages: there is
   * no route by which a page hand-writes a node with a rating on it. Multiple
   * entities travel in that document's `@graph`, which is why one block per page
   * is still enough.
   */
  jsonLd?: JsonLd;
  /**
   * This response is not a document at a URL, so it claims none.
   *
   * The 404 is the only caller and the only page that can be. It is served at
   * whatever address the reader actually typed, so `/404/` — the path it
   * happens to be built at — is not its URL, is not a canonical form of the
   * URL it was served at, and is not a page anyone should be sent back to. So
   * `rel=canonical` and `og:url` are omitted rather than pointed somewhere
   * plausible: aiming them at `/` would claim the error page is a duplicate of
   * the home page, which is a different false statement, not a fix.
   *
   * `noindex` says the same thing to a crawler that the missing canonical says
   * by omission. `robots.txt` cannot: it allows everything on purpose, because
   * there are no private routes here, and disallowing `/404` there would only
   * stop the page being *fetched*, which is not the same as stopping it being
   * *indexed*.
   */
  noindex?: boolean;
  /**
   * Run the content edge to edge, with side padding only: the index pages
   * (/tools, /sites, /library, a library entry's list-detail, and every filter
   * page under them), the way briOS's list pages fill the viewport under the
   * bar. Reading pages leave it out and keep the centred `--page-max` column.
   *
   * It lifts `.shell__main`'s cap and sets the shell's side padding to 1rem,
   * briOS's `px-4`; it never touches the footer, which keeps `--page-max` on
   * every page because the colophon closes every page the same way.
   * `lib/wide.test.mjs` holds that scope.
   */
  full?: boolean;
  /**
   * The top bar's trail after home, for a page with no `BreadcrumbList` in
   * its JSON-LD and no nav section of its own (the footer pages). Everything
   * else leaves it out and gets the trail worked out below.
   */
  trail?: Crumb[];
  /**
   * The share card. Left out, the page gets its own from `lib/og.ts` (a
   * section index, a tool, a site, a library entry, a note, /about), its
   * section's on a filter page, or the site card.
   */
  image?: OgImage;
}

const {
  title = "Aayush Manchanda",
  description = "Aayush Manchanda co-founded Orbis, runs Vetted, and builds things with AI. Software he ran, sites he saved, and what he's reading, each with a date on it.",
  jsonLd,
  noindex = false,
  full = false,
} = Astro.props;

/**
 * Home, then the sections. Only sections that have entries come back from
 * `getSections()`, so an empty one is never linked from the nav.
 */
const navItems: NavItem[] = [
  { href: "/", label: "Home" },
  ...(await getSections()).map((section) => ({ href: section.href, label: section.name })),
];

const hasPane = Astro.slots.has("pane");

const pathname = Astro.url.pathname;

/**
 * The top bar's trail, in order of authority: the page's own `BreadcrumbList`
 * (so the JSON-LD and the visible trail are one list), then an explicit
 * `trail`, then the nav section this path sits in. Home gets an empty trail.
 */
const section = navItems.find(
  (item) => item.href !== "/" && `${normalize(pathname)}/`.startsWith(`${item.href}/`),
);
/** The mat colour behind the stamp frame (`styles/frame.css`): the nav section's
 * slug, `home`, or `other` for the footer pages, the 404 and /design. */
const matSection = section ? section.href.slice(1) : pathname === "/" ? "home" : "other";

const trail: Crumb[] = trailOf(jsonLd) ??
  Astro.props.trail ??
  (section ? [{ name: section.label, path: section.href }] : []);

/**
 * The canonical URL for this page, with no trailing slash: the spelling every
 * internal link uses, and the only one Vercel serves (`vercel.json` 308s `/x/`).
 *
 * Built through `absolute()` rather than `Astro.site`, though the two hold the
 * same value: `Astro.site` is typed `URL | undefined`, and reading the origin
 * from the module that owns it keeps the DNS cutover a genuinely one-line
 * change instead of one line plus a fallback that could quietly disagree.
 */
const canonical = absolute(normalize(pathname));

const image = Astro.props.image ?? (await ogImageFor(normalize(pathname)));
const ogImage = absolute(image.src);

/**
 * This page's markdown variant, if it has one. Advertising it with
 * `rel=alternate` gives an agent a way to find the markdown by reading the
 * HTML, without having to know the `Accept` negotiation trick.
 *
 * Looked up in `lib/markdown.ts` rather than derived from the path: this layout
 * wraps every page on the site, most of which have no variant, and appending
 * `.md` to a pathname would advertise a file that is not there.
 *
 * The trailing slash goes first because Astro builds directory-format routes,
 * so this page's own pathname arrives as `/tools/`.
 */
const variant = markdownVariantFor(normalize(pathname));

/** The combined feed everywhere, plus this section's own on its pages. */
const feeds = FEEDS.filter((feed) => feed.path === "/" || feed.path === section?.href);
const markdownVariant = variant === null ? null : absolute(variant);
---

<!doctype html>
<html lang="en" data-section={matSection}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    {/* The home-screen icons (`scripts/og.mjs`, `npm run og`). */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    {/*
      The two latin font files, preloaded. Both faces are on every page — the
      prose is Geist, every label is Geist Mono — but without these the browser
      cannot start either fetch until the stylesheet has arrived and been
      parsed, so the fonts sit a round trip behind text they are already late
      for and arrive as a visible swap. Latin only: it is the subset every page
      uses, and the others stay behind their `unicode-range` until a glyph asks.
      `crossorigin` is load-bearing — fonts fetch in CORS mode even from our own
      origin, and a preload whose mode does not match the real request is spent
      on a file the browser then fetches a second time.
    */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={geistLatinWoff2}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={geistMonoLatinWoff2}
      crossorigin
    />
    {/*
      One meta per scheme, carrying the `prefers-color-scheme` queries a
      browser resolves without help — which is what keeps the mobile status bar
      correct with scripting off. `data-scheme` is the handle the theme script
      uses to re-point their `media` when a reader pins a theme; see
      `lib/theme.ts › THEME_COLOR_MEDIA`.
    */}
    <meta
      name="theme-color"
      data-scheme="light"
      content={THEME_COLORS.light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      data-scheme="dark"
      content={THEME_COLORS.dark}
      media="(prefers-color-scheme: dark)"
    />

    {/*
      The theme and the sound toggle's state, before the first paint.

      Blocking and inline on purpose: a deferred module runs after the browser
      has already painted, so a reader who pinned dark would get a white flash
      on every navigation. It sits after the metas because it re-points them,
      and it is the only script on this site that blocks the parse. The
      analytics tag at the foot of this head is the one other script Astro does
      not bundle, and it defers.
    */}
    <script is:inline set:html={PREPAINT + SOUND_PREPAINT} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aayush Manchanda" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={image.alt} />

    {
      markdownVariant && (
        <link rel="alternate" type="text/markdown" href={markdownVariant} />
      )
    }
    {
      feeds.map((feed) => (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={feed.title}
          href={absolute(feed.href)}
        />
      ))
    }
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={serialize(jsonLd)}
        />
      )
    }

    {/*
      Vercel Web Analytics: a count of page views, and nothing that identifies
      a reader. Cookieless, and it writes nothing to storage, so the theme key
      stays the only entry /privacy has to name.

      A plain tag rather than `@vercel/analytics/astro`. The component exists to
      register a custom element and re-fire a pageview on client-side route
      changes; this site is static HTML with no client router, so every
      navigation is a real document load and the bare script already counts it.
      That is a dependency and a bundled module bought for nothing.

      **Both URLs here are same-origin and that is load-bearing.** The script is
      `/_vercel/insights/script.js` and the beacon posts to
      `/_vercel/insights/event`, two routes Vercel's edge adds to the deployment
      once Web Analytics is on for the project. No request leaves this domain,
      which is why /privacy's "one outside request" is still true with analytics
      shipped: this added a script, not a second host. The package only reaches
      a Vercel domain in debug mode (`va.vercel-scripts.com`), which is
      development-only and not what this tag loads. **If that ever stops being
      true, /privacy is edited in the same commit** — the same rule `markFor`
      already carries.

      Gated on `PROD` because the route only exists on a Vercel deployment.
      Under `astro dev` it would 404 on every page load, which trains you to
      ignore the console on the one workflow design.md §8 tells you to verify in.
    */}
    {
      import.meta.env.PROD && (
        <script is:inline defer src="/_vercel/insights/script.js" />
      )
    }
  </head>

  <body>
    {/*
      `data-mnav-inert` marks what the mobile MENU panel takes out of the tab
      order and the accessibility tree while it is open: the skip link, the
      bar's trail and Search, and the whole shell. The panel is `aria-modal`, and before this
      a keyboard could Tab straight out of it into content sitting behind the
      scrim. The theme live region below deliberately does not carry it — the
      panel's own theme toggle announces through it while the panel is open.
      `lib/mnav.ts › setOpen` flips the property; `lib/mnav.test.mjs` holds
      the wiring.
    */}
    <a class="skip mono" href="#main" data-mnav-inert>Skip to content</a>
    <Stamp href={section?.href} index={normalize(pathname) === section?.href} />

    {/*
      One region for every theme button on the page. It is empty until a press,
      so it never announces on load, and it lives here rather than inside a
      button because changing text inside a control also changes that control's
      accessible name.
    */}
    <span class="visually-hidden" aria-live="polite" data-theme-live></span>

    <TopBar navItems={navItems} pathname={pathname} trail={trail} />
    <PullRefresh />
    <CommandPalette />
    {/* The UI tick (`lib/ui-sound.ts`): listeners only; no audio until a press. */}
    <script>
      import { initSound } from "../lib/ui-sound";

      initSound();
    </script>

    {/*
      A page with a `pane` slot (only /library/<slug>) gets briOS's list-detail
      shape: the pane on the left with its own scroll, the shell beside it as
      the detail, and the document still the detail's scroller, so the bar,
      the footer and a phone's address bar behave as on every other page. The
      pane hides itself under 48rem of this container (`LibraryPane.astro`).
    */}
    <div class={hasPane ? "split" : undefined}>
    <slot name="pane" />
    <div class:list={["shell", full && "shell--full"]} data-mnav-inert>
      <main class:list={["shell__main", full && "shell__main--full"]} id="main">
        <slot />
      </main>

      <Footer />
    </div>
    </div>

    {/*
      Signed in? A regex over Clerk's `__client_uat` cookie, and only a yes
      imports the signed-in module (`lib/signed-in-check.ts`, VET-276): the
      top bar's "Private" and "Sign out", the private rows in the library pane
      and in the palette. Every other visitor runs this line and loads nothing.
    */}
    <script is:inline set:html={signedInCheck(import.meta.env.DEV ? "/src/lib/signed-in.ts" : "/signed-in.js")} />

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1rem;
        /* `--accent-panel`, not `--accent`: this paints the accent as a
           background with text on it, and `--accent` lifts to #5C74FF in the
           dark theme, where white on it is 3.89:1 and fails AA. The panel pair
           is held at the vivid blue in both themes for exactly this. A skip
           link is the one control a keyboard user meets first, so it is the
           last place on the site that should be hard to read. */
        background: var(--accent-panel);
        color: var(--accent-panel-ink);
        text-decoration: none;
      }

      .skip:focus {
        left: 0;
      }

      .split {
        container: split / inline-size;
        display: flex;
      }

      .split > .shell {
        flex: 1;
        min-width: 0;
      }

      /* One centred column under the bar. */
      .shell {
        min-height: calc(100svh - var(--bar-h) - 2 * var(--frame));
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-inline: var(--page-pad);
        padding-top: clamp(2rem, 4vw, 3rem);
        padding-bottom: clamp(2.5rem, 6vh, 4rem);
      }

      .shell__main {
        flex: 1 0 auto;
        width: 100%;
        max-width: var(--page-max);
      }

      /* The index pages run edge to edge inside the frame: 24px of side
         padding at a phone, 32px from 768px, 48px from 1280px, and the column
         loses its cap. `--page-pad` is redeclared here, on this shell only, so
         a table that bleeds to the frame (`ToolList.astro`) pads its outer
         cells by the same amount the title above it sits in.
         `Footer.astro › .foot` keeps `--page-max`: the colophon is the same
         width under every page. An index page's controls are what it is for,
         so the gap under its masthead is design.md §2's 40px between
         sections rather than the reading pages' up-to-96. */
      .shell--full {
        --page-pad: 1.5rem;
        --gap-masthead: 2.5rem;
      }

      @media (min-width: 768px) {
        .shell--full {
          --page-pad: 2rem;
        }
      }

      @media (min-width: 1280px) {
        .shell--full {
          --page-pad: 3rem;
        }
      }

      .shell__main--full {
        max-width: none;
      }
    </style>
  </body>
</html>
