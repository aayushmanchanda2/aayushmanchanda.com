---
/**
 * Base — the site shell: fonts, tokens, both nav surfaces, footer.
 *
 * Fonts are bundled from npm (@fontsource-variable/*) and served from our own
 * origin. The site loads nothing from a third-party CDN.
 */
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
import "../styles/global.css";
// after global.css: both of these read tokens defined there
import "../styles/chip.css";
import "../styles/palette.css";

import CommandPalette from "../components/CommandPalette.astro";
import ProximitySidebar from "../components/ProximitySidebar.astro";
import MobileNav from "../components/MobileNav.astro";
import SiteMark from "../components/SiteMark.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import XGlyph from "../components/XGlyph.astro";
import { normalize } from "../lib/links";
import { markdownVariantFor } from "../lib/markdown";
import type { JsonLd } from "../lib/schema";
import { serialize } from "../lib/schema";
import type { NavItem } from "../lib/sections";
import { getSections } from "../lib/sections";
import { absolute } from "../lib/site";
import { PREPAINT, THEME_COLORS } from "../lib/theme";

interface Props {
  title?: string;
  description?: string;
  /**
   * Structured data for this page, serialised into one `ld+json` block.
   *
   * A prop rather than a `<slot name="head">` because the value is data, not
   * markup: the layout keeps sole ownership of how it gets serialised, and a
   * page cannot push arbitrary script into the head through it.
   *
   * Typed as `JsonLd` rather than a bare object, so the only thing a page can
   * pass is something a builder in `lib/schema.ts` returned. That is what keeps
   * the parity rule enforceable in one file instead of on twelve pages: there is
   * no route by which a page hand-writes a node with a rating on it. Multiple
   * entities travel in that document's `@graph`, which is why one block per page
   * is still enough.
   */
  jsonLd?: JsonLd;
  /**
   * This response is not a document at a URL, so it claims none.
   *
   * The 404 is the only caller and the only page that can be. It is served at
   * whatever address the reader actually typed, so `/404/` — the path it
   * happens to be built at — is not its URL, is not a canonical form of the
   * URL it was served at, and is not a page anyone should be sent back to. So
   * `rel=canonical` and `og:url` are omitted rather than pointed somewhere
   * plausible: aiming them at `/` would claim the error page is a duplicate of
   * the home page, which is a different false statement, not a fix.
   *
   * `noindex` says the same thing to a crawler that the missing canonical says
   * by omission. `robots.txt` cannot: it allows everything on purpose, because
   * there are no private routes here, and disallowing `/404` there would only
   * stop the page being *fetched*, which is not the same as stopping it being
   * *indexed*.
   */
  noindex?: boolean;
}

const {
  title = "Aayush Manchanda",
  description = "Part entrepreneur, part marketer, part operator. Aayush Manchanda co-founded Orbis, runs Vetted, and uses AI to build things on the internet from Canada. What survives his testing shows up here with a date on it.",
  jsonLd,
  noindex = false,
} = Astro.props;

/**
 * Dash hierarchy: home is the root (title); the sections carry the weight the
 * manifest gives them, which maps to the reference dash presets.
 *
 * Only sections that have entries come back from `getSections()`, so an empty
 * one is never linked from the nav.
 */
const navItems: NavItem[] = [
  { href: "/", label: "Home", kind: "title" },
  ...(await getSections()).map((section) => ({
    href: section.href,
    label: section.name,
    kind: section.kind,
  })),
];

/**
 * Only links that go somewhere.
 *
 * `rel="me"` is a claim of identity, so every row here has to resolve to a real
 * profile. A row pointing at a bare `https://x.com/` would be a claim about
 * nobody, and worse than an absent row: a dead link a reader has to click to
 * find out. Both of these are handles, so both are safe to make the claim.
 *
 * The same two profiles are the `sameAs` list on the home page's Person node.
 * Two copies, because one is markup a reader clicks and the other is structured
 * data a machine resolves; if a third profile ever appears, it goes in both.
 */
/**
 * `glyph` says the profile's mark is drawn rather than spelled, and only X
 * carries it. That is a judgement about legibility, not about consistency: "X"
 * is a single character that reads as a close button or a multiplication sign
 * long before it reads as a company, and it is the only label on this site with
 * that problem. "GitHub" is a word that reads as itself, so it stays a word —
 * and the octocat is a filled silhouette that would be the only one of its kind
 * in an icon set that is otherwise monoline, illegible at 14px, and a logo
 * standing in for a word that was already doing the job. `label` stays the
 * accessible name either way, so the two rows say the same thing to a screen
 * reader whichever way they are drawn.
 */
const social: { label: string; href: string; glyph?: boolean }[] = [
  { label: "GitHub", href: "https://github.com/aayushmanchanda2" },
  { label: "X", href: "https://x.com/amanchanda7", glyph: true },
];

const clocks = [
  { label: "Winnipeg", tz: "America/Winnipeg" },
  { label: "New Delhi", tz: "Asia/Kolkata" },
];

const pathname = Astro.url.pathname;
const year = new Date().getFullYear();

/**
 * The canonical URL for this page.
 *
 * Built through `absolute()` rather than `Astro.site`, though the two hold the
 * same value: `Astro.site` is typed `URL | undefined`, and reading the origin
 * from the module that owns it keeps the DNS cutover a genuinely one-line
 * change instead of one line plus a fallback that could quietly disagree.
 */
const canonical = absolute(pathname);

/** One static card for the whole site. Regenerate with `npm run og`. */
const ogImage = absolute("/og.png");

/**
 * This page's markdown variant, if it has one. Advertising it with
 * `rel=alternate` gives an agent a way to find the markdown by reading the
 * HTML, without having to know the `Accept` negotiation trick.
 *
 * Looked up in `lib/markdown.ts` rather than derived from the path: this layout
 * wraps every page on the site, most of which have no variant, and appending
 * `.md` to a pathname would advertise a file that is not there.
 *
 * The trailing slash goes first because Astro builds directory-format routes,
 * so this page's own pathname arrives as `/tools/`.
 */
const variant = markdownVariantFor(normalize(pathname));
const markdownVariant = variant === null ? null : absolute(variant);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {/*
      One meta per scheme, carrying the `prefers-color-scheme` queries a
      browser resolves without help — which is what keeps the mobile status bar
      correct with scripting off. `data-scheme` is the handle the theme script
      uses to re-point their `media` when a reader pins a theme; see
      `lib/theme.ts › THEME_COLOR_MEDIA`.
    */}
    <meta
      name="theme-color"
      data-scheme="light"
      content={THEME_COLORS.light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      data-scheme="dark"
      content={THEME_COLORS.dark}
      media="(prefers-color-scheme: dark)"
    />

    {/*
      The theme, before the first paint.

      Blocking and inline on purpose: a deferred module runs after the browser
      has already painted, so a reader who pinned dark would get a white flash
      on every navigation. It sits after the metas because it re-points them,
      and it is the only script on this site that blocks the parse. The
      analytics tag at the foot of this head is the one other script Astro does
      not bundle, and it defers.
    */}
    <script is:inline set:html={PREPAINT} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aayush Manchanda" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Aayush Manchanda" />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {
      markdownVariant && (
        <link rel="alternate" type="text/markdown" href={markdownVariant} />
      )
    }
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={serialize(jsonLd)}
        />
      )
    }

    {/*
      Vercel Web Analytics: a count of page views, and nothing that identifies
      a reader. Cookieless, and it writes nothing to storage, so the theme key
      stays the only entry /privacy has to name.

      A plain tag rather than `@vercel/analytics/astro`. The component exists to
      register a custom element and re-fire a pageview on client-side route
      changes; this site is static HTML with no client router, so every
      navigation is a real document load and the bare script already counts it.
      That is a dependency and a bundled module bought for nothing.

      **Both URLs here are same-origin and that is load-bearing.** The script is
      `/_vercel/insights/script.js` and the beacon posts to
      `/_vercel/insights/event`, two routes Vercel's edge adds to the deployment
      once Web Analytics is on for the project. No request leaves this domain,
      which is why /privacy's "one outside request" is still true with analytics
      shipped: this added a script, not a second host. The package only reaches
      a Vercel domain in debug mode (`va.vercel-scripts.com`), which is
      development-only and not what this tag loads. **If that ever stops being
      true, /privacy is edited in the same commit** — the same rule `faviconUrl`
      already carries.

      Gated on `PROD` because the route only exists on a Vercel deployment.
      Under `astro dev` it would 404 on every page load, which trains you to
      ignore the console on the one workflow design.md §8 tells you to verify in.
    */}
    {
      import.meta.env.PROD && (
        <script is:inline defer src="/_vercel/insights/script.js" />
      )
    }
  </head>

  <body>
    <a class="skip mono" href="#main">Skip to content</a>

    {/*
      One region for every theme button on the page. It is empty until a press,
      so it never announces on load, and it lives here rather than inside a
      button because changing text inside a control also changes that control's
      accessible name.
    */}
    <span class="visually-hidden" aria-live="polite" data-theme-live></span>

    <SiteMark />
    <ProximitySidebar items={navItems} pathname={pathname} />
    <MobileNav items={navItems} pathname={pathname} />
    <CommandPalette />

    <div class="shell">
      <main class="shell__main" id="main">
        <slot />
      </main>

      {/*
        Three stacked groups, every one of them centred. The page above is flush
        left and stays that way; the footer is the one block that is not content
        but a colophon closing it, and centring is what says so. It also settles
        an alignment the old row could not: the socials sat left, the clocks
        were pushed right by an `auto` margin, and the colophon wrapped
        underneath at the left edge again, so three groups took three different
        alignments and read as a row that had come apart rather than as a block.
      */}
      <footer class="foot">
        <div class="foot__row">
          <ul class="foot__links mono">
            {
              social.map((link) => (
                <li>
                  <a
                    class:list={[
                      "foot__link",
                      "press",
                      link.glyph && "foot__link--glyph",
                    ]}
                    href={link.href}
                    rel="me noopener"
                    target="_blank"
                    aria-label={link.glyph ? link.label : undefined}
                  >
                    {link.glyph ? <XGlyph /> : link.label}
                  </a>
                </li>
              ))
            }
          </ul>

          <dl class="foot__clocks mono">
            {
              clocks.map((clock) => (
                <div class="foot__clock">
                  <dt>{clock.label}</dt>
                  <dd class="tabular-nums" data-clock={clock.tz}>
                    --:--:--
                  </dd>
                </div>
              ))
            }
          </dl>

          {/*
            Beside the clocks, at the clocks' weight: the theme is housekeeping,
            like the timezone readouts and the copyright, not a feature the page
            is selling. The mobile nav panel carries the same control, because
            below 900px this footer is a long scroll away.
          */}
          <ThemeToggle />
        </div>

        {/* The colophon: the four pages that are about the site rather than in
            it, with the palette in front of them. They live here and not in the
            nav on purpose — the nav is the five content sections, and a reader
            looking for who wrote this or how to reach him looks at the bottom
            of the page.

            Ordered by what a reader is answering. About and Contact are about
            the person, and they come first because that is what most people are
            looking for down here. Design and Privacy are about the machinery of
            the site, and Privacy is last because it is the one nobody comes
            looking for until they need it.

            A list rather than a paragraph now that the separators are drawn
            rather than typed: the `·` is a `::before` on the list item, which is
            what the rest of the site already does. */}
        <ul class="foot__meta mono">
          <li>
            {/* The palette's only permanently visible affordance on desktop. A
                shortcut nobody is told about is a shortcut nobody uses, and the
                footer is where this site already keeps its housekeeping. The
                key cap is corrected to Ctrl off macOS by `lib/palette.ts`. */}
            {/* `mono` sits on the button itself rather than being inherited
                from the list, which is what every other mono button on the site
                does and is not a style preference: the UA stylesheet sets
                `text-transform: none` and `letter-spacing: normal` on form
                controls, so a button inside a `.mono` container silently drops
                out of the label voice. This one had — "Search" was the only
                item in the colophon not shouting like its four neighbours. */}
            <button
              class="foot__quiet foot__search mono press"
              type="button"
              data-palette-open
            >
              Search <kbd data-palette-hint>&#8984;K</kbd>
            </button>
          </li>
          <li><a class="foot__quiet press" href="/about">About</a></li>
          <li><a class="foot__quiet press" href="/contact">Contact</a></li>
          <li><a class="foot__quiet press" href="/design">Design</a></li>
          <li><a class="foot__quiet press" href="/privacy">Privacy</a></li>
        </ul>

        {/* Its own line, and his name on it. The year is `tabular-nums` like
            every other digit that changes in place. */}
        <p class="foot__legal mono tabular-nums">&copy; {year} Aayush Manchanda</p>
      </footer>
    </div>

    <script>
      // The dual-city footer clocks. Each `data-clock` carries its own IANA
      // zone, so DST for Winnipeg and New Delhi is the platform's problem.
      import { startTicker } from "../lib/clock";

      startTicker("data-clock");
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1rem;
        /* `--accent-panel`, not `--accent`: this paints the accent as a
           background with text on it, and `--accent` lifts to #5C74FF in the
           dark theme, where white on it is 3.89:1 and fails AA. The panel pair
           is held at the vivid blue in both themes for exactly this. A skip
           link is the one control a keyboard user meets first, so it is the
           last place on the site that should be hard to read. */
        background: var(--accent-panel);
        color: var(--accent-panel-ink);
        text-decoration: none;
      }

      .skip:focus {
        left: 0;
      }

      .shell {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        /* clears the fixed vertical MENU label on mobile */
        padding-left: calc(var(--page-pad) + 2.5rem);
        padding-right: var(--page-pad);
        padding-top: clamp(4.5rem, 14vh, 9rem);
        padding-bottom: clamp(2.5rem, 6vh, 4rem);
      }

      @media (min-width: 900px) {
        .shell {
          /* clears the fixed dash rail */
          padding-left: clamp(17rem, 24vw, 21rem);
          padding-right: clamp(2rem, 6vw, 5rem);
        }
      }

      .shell__main {
        flex: 1 0 auto;
        width: 100%;
        max-width: var(--page-max);
      }

      /* --- footer ---------------------------------------------------------- */

      .foot {
        width: 100%;
        max-width: var(--page-max);
        margin-top: clamp(5rem, 16vh, 10rem);
        padding-top: 1.75rem;
        border-top: 1px solid var(--hairline);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      /* Group one: who he is and what time it is where he is. */
      .foot__row {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: baseline;
        gap: 1rem 2.5rem;
      }

      .foot__links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin: 0;
      }

      .foot__link {
        display: inline-block;
        color: var(--muted);
        text-decoration: none;
      }

      .foot__link:hover {
        color: var(--accent);
      }

      /* The glyph row is a 14px target, so it takes the 40px hit area the rail
         dashes and the theme toggle take, by the same trick: an absolutely
         positioned `::before`, so a toolbar's worth of height never lands in
         the footer row. The text links beside it are text and stay text —
         design.md §4's stated exception, for the same reason the /sites hint
         row takes it. Offsets rather than a centring transform, so nothing here
         rests on one and reduced motion has nothing to undo. */
      .foot__link--glyph {
        position: relative;
        display: inline-flex;
      }

      .foot__link--glyph::before {
        content: "";
        position: absolute;
        left: -13px;
        top: -13px;
        width: 40px;
        height: 40px;
      }

      .foot__clocks {
        display: flex;
        gap: 1.5rem;
        margin: 0;
      }

      .foot__clock {
        display: flex;
        gap: 0.5rem;
        align-items: baseline;
        color: var(--faint);
      }

      .foot__clock dd {
        margin: 0;
        color: var(--muted);
      }

      /* The gap that makes the two halves read as two things rather than as one
         row that wrapped. `--gap-masthead` is the space under a masthead, 3.5
         to 6rem, and far too much air for the foot of a page; this is its
         smaller sibling. It stays a literal rather than becoming a token
         because the footer is its only consumer — `--gap-masthead` earned a
         token by being written out fourteen times, and one call site is
         retunable by opening one file. */
      .foot__meta {
        margin: 2rem 0 0;
        color: var(--faint);
        display: flex;
        align-items: baseline;
        justify-content: center;
        /* Wraps because five items is wider than a 375px column, and an
           unwrapped flex row pushes the last one off the side rather than
           dropping it to a second line. The row gap is tighter than the column
           gap so a wrapped row still reads as one block. */
        flex-wrap: wrap;
        gap: 0.4rem 0.5rem;
      }

      /* Drawn, never typed: the separator is generated content on the list item
         and sits outside the anchor, so it is never part of a link's text or
         its target. The `/ ""` is the alt-text form — it gives the glyph an
         empty accessible name, which is what the `aria-hidden` spans this
         replaced were doing by hand. Margin on the pseudo-element rather than a
         wider gap, so the dot sits centred between two items instead of hard
         against the one after it. */
      .foot__meta li + li::before {
        content: "\00b7" / "";
        margin-right: 0.5rem;
        color: var(--hairline-strong);
      }

      /* The tail of the colophon rather than a third group, so it takes one
         line of air against the block of it above. */
      .foot__legal {
        margin: 0.85rem 0 0;
        color: var(--faint);
      }

      /* Sits at the copyright's weight, not the social links': /privacy is
         housekeeping, and it should read as housekeeping until hovered. */
      .foot__quiet {
        display: inline-block;
        color: inherit;
        text-decoration: none;
      }

      .foot__quiet:hover {
        color: var(--accent);
      }

      .foot__search {
        cursor: pointer;
      }

      .foot__search kbd {
        font: inherit;
        margin-left: 0.35rem;
        padding: 0.1rem 0.35rem;
        border: 1px solid var(--hairline);
      }

      .foot__search:hover kbd {
        border-color: currentColor;
      }

      @media (max-width: 599px) {
        /* The column here is 287px — `--page-pad` either side plus the 2.5rem
           the shell clears for the fixed MENU label — and three things sharing
           one wrapped row inside it centre as *pairs* rather than individually:
           the clocks came out left of centre because the theme toggle was
           riding beside them.

           So the clocks take the second line to themselves and the two controls
           keep the first. Ordering the clocks last rather than stacking all
           three costs nothing in tab order — a `dl` of readouts has nothing
           focusable in it, so the only two stops are the profile links and the
           toggle, and they now run left to right along one line in the order
           the markup already had them. */
        .foot__row {
          gap: 1.25rem 1.75rem;
        }

        /* Stacked, they are also the one place the clocks stop being centred
           *inside* themselves: two readouts with their labels flush left and
           their times flush right is a small table, and a table reads by its
           columns. `align-items: center` is what still centres the block on the
           page — it is the pair that is aligned to each other, not to the
           column. */
        .foot__clocks {
          order: 1;
          flex-basis: 100%;
          flex-direction: column;
          align-items: center;
          gap: 0.35rem;
          text-align: left;
        }

        .foot__clock {
          justify-content: space-between;
          min-width: 11rem;
        }

        /* Five items and four separators are 283px of the 287 available, so the
           row filled its line to within 2px and dropped `Privacy` alone onto a
           second one: centred, but with no air either side to show for it, it
           read as a line that had been cut off. Narrowing the box is what makes
           the wrap deliberate — three items, then two, both with real margin —
           rather than leaving it to whether a glyph is a pixel wider today. */
        .foot__meta {
          max-width: 16rem;
        }
      }
    </style>
  </body>
</html>
