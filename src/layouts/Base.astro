---
/**
 * Base — the site shell: fonts, tokens, both nav surfaces, footer.
 *
 * Fonts are bundled from npm (@fontsource-variable/*) and served from our own
 * origin. The site loads nothing from a third-party CDN.
 */
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
import "../styles/global.css";
// after global.css: both of these read tokens defined there
import "../styles/chip.css";
import "../styles/palette.css";

import CommandPalette from "../components/CommandPalette.astro";
import ProximitySidebar from "../components/ProximitySidebar.astro";
import MobileNav from "../components/MobileNav.astro";
import SiteMark from "../components/SiteMark.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { normalize } from "../lib/links";
import { markdownVariantFor } from "../lib/markdown";
import type { JsonLd } from "../lib/schema";
import { serialize } from "../lib/schema";
import type { NavItem } from "../lib/sections";
import { getSections } from "../lib/sections";
import { absolute } from "../lib/site";
import { PREPAINT, THEME_COLORS } from "../lib/theme";

interface Props {
  title?: string;
  description?: string;
  /**
   * Structured data for this page, serialised into one `ld+json` block.
   *
   * A prop rather than a `<slot name="head">` because the value is data, not
   * markup: the layout keeps sole ownership of how it gets serialised, and a
   * page cannot push arbitrary script into the head through it.
   *
   * Typed as `JsonLd` rather than a bare object, so the only thing a page can
   * pass is something a builder in `lib/schema.ts` returned. That is what keeps
   * the parity rule enforceable in one file instead of on twelve pages: there is
   * no route by which a page hand-writes a node with a rating on it. Multiple
   * entities travel in that document's `@graph`, which is why one block per page
   * is still enough.
   */
  jsonLd?: JsonLd;
}

const {
  title = "Aayush Manchanda",
  description = "Part entrepreneur, part marketer, part operator. Aayush Manchanda co-founded Orbis, runs Vetted, and uses AI to build things on the internet from Canada. What survives his testing shows up here with a date on it.",
  jsonLd,
} = Astro.props;

/**
 * Dash hierarchy: home is the root (title); the sections carry the weight the
 * manifest gives them, which maps to the reference dash presets.
 *
 * Only sections that have entries come back from `getSections()`, so an empty
 * one is never linked from the nav.
 */
const navItems: NavItem[] = [
  { href: "/", label: "Home", kind: "title" },
  ...(await getSections()).map((section) => ({
    href: section.href,
    label: section.name,
    kind: section.kind,
  })),
];

/**
 * Only links that go somewhere.
 *
 * `rel="me"` is a claim of identity, so every row here has to resolve to a real
 * profile. A row pointing at a bare `https://x.com/` would be a claim about
 * nobody, and worse than an absent row: a dead link a reader has to click to
 * find out. Both of these are handles, so both are safe to make the claim.
 *
 * The same two profiles are the `sameAs` list on the home page's Person node.
 * Two copies, because one is markup a reader clicks and the other is structured
 * data a machine resolves; if a third profile ever appears, it goes in both.
 */
const social = [
  { label: "GitHub", href: "https://github.com/aayushmanchanda2" },
  { label: "X", href: "https://x.com/amanchanda7" },
];

const clocks = [
  { label: "Winnipeg", tz: "America/Winnipeg" },
  { label: "New Delhi", tz: "Asia/Kolkata" },
];

const pathname = Astro.url.pathname;
const year = new Date().getFullYear();

/**
 * The canonical URL for this page.
 *
 * Built through `absolute()` rather than `Astro.site`, though the two hold the
 * same value: `Astro.site` is typed `URL | undefined`, and reading the origin
 * from the module that owns it keeps the DNS cutover a genuinely one-line
 * change instead of one line plus a fallback that could quietly disagree.
 */
const canonical = absolute(pathname);

/** One static card for the whole site. Regenerate with `npm run og`. */
const ogImage = absolute("/og.png");

/**
 * This page's markdown variant, if it has one. Advertising it with
 * `rel=alternate` gives an agent a way to find the markdown by reading the
 * HTML, without having to know the `Accept` negotiation trick.
 *
 * Looked up in `lib/markdown.ts` rather than derived from the path: this layout
 * wraps every page on the site, most of which have no variant, and appending
 * `.md` to a pathname would advertise a file that is not there.
 *
 * The trailing slash goes first because Astro builds directory-format routes,
 * so this page's own pathname arrives as `/tools/`.
 */
const variant = markdownVariantFor(normalize(pathname));
const markdownVariant = variant === null ? null : absolute(variant);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {/*
      One meta per scheme, carrying the `prefers-color-scheme` queries a
      browser resolves without help — which is what keeps the mobile status bar
      correct with scripting off. `data-scheme` is the handle the theme script
      uses to re-point their `media` when a reader pins a theme; see
      `lib/theme.ts › THEME_COLOR_MEDIA`.
    */}
    <meta
      name="theme-color"
      data-scheme="light"
      content={THEME_COLORS.light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      data-scheme="dark"
      content={THEME_COLORS.dark}
      media="(prefers-color-scheme: dark)"
    />

    {/*
      The theme, before the first paint.

      Blocking and inline on purpose: a deferred module runs after the browser
      has already painted, so a reader who pinned dark would get a white flash
      on every navigation. It sits after the metas because it re-points them,
      and it is the only script on this site that is not bundled.
    */}
    <script is:inline set:html={PREPAINT} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aayush Manchanda" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Aayush Manchanda" />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {
      markdownVariant && (
        <link rel="alternate" type="text/markdown" href={markdownVariant} />
      )
    }
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={serialize(jsonLd)}
        />
      )
    }
  </head>

  <body>
    <a class="skip mono" href="#main">Skip to content</a>

    {/*
      One region for every theme button on the page. It is empty until a press,
      so it never announces on load, and it lives here rather than inside a
      button because changing text inside a control also changes that control's
      accessible name.
    */}
    <span class="visually-hidden" aria-live="polite" data-theme-live></span>

    <SiteMark />
    <ProximitySidebar items={navItems} pathname={pathname} />
    <MobileNav items={navItems} pathname={pathname} />
    <CommandPalette />

    <div class="shell">
      <main class="shell__main" id="main">
        <slot />
      </main>

      <footer class="foot">
        <ul class="foot__links mono">
          {
            social.map((link) => (
              <li>
                <a
                  class="foot__link press"
                  href={link.href}
                  rel="me noopener"
                  target="_blank"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <dl class="foot__clocks mono">
          {
            clocks.map((clock) => (
              <div class="foot__clock">
                <dt>{clock.label}</dt>
                <dd class="tabular-nums" data-clock={clock.tz}>
                  --:--:--
                </dd>
              </div>
            ))
          }
        </dl>

        {/*
          Beside the clocks, at the clocks' weight: the theme is housekeeping,
          like the timezone readouts and the copyright, not a feature the page
          is selling. The mobile nav panel carries the same control, because
          below 900px this footer is a long scroll away.
        */}
        <ThemeToggle />

        <p class="foot__meta mono">
          {/* The palette's only permanently visible affordance on desktop. A
              shortcut nobody is told about is a shortcut nobody uses, and the
              footer is where this site already keeps its housekeeping. The key
              cap is corrected to Ctrl off macOS by `lib/palette.ts`. */}
          <button
            class="foot__quiet foot__search press"
            type="button"
            data-palette-open
          >
            Search <kbd data-palette-hint>&#8984;K</kbd>
          </button>
          <span aria-hidden="true">&middot;</span>
          <a class="foot__quiet press" href="/privacy">Privacy</a>
          <span aria-hidden="true">&middot;</span>
          <span class="tabular-nums">&copy; {year}</span>
        </p>
      </footer>
    </div>

    <script>
      // Dual-city clocks. Formatting is delegated to Intl, so DST for both
      // Winnipeg and New Delhi is handled by the platform, not by us.
      const nodes = Array.from(
        document.querySelectorAll<HTMLElement>("[data-clock]"),
      );

      if (nodes.length) {
        const clocks = nodes.map((el) => ({
          el,
          format: new Intl.DateTimeFormat("en-GB", {
            timeZone: el.dataset.clock,
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: false,
          }),
        }));

        const tick = () => {
          const now = new Date();
          for (const clock of clocks) {
            const next = clock.format.format(now);
            // avoid a pointless DOM write 59 times out of 60 per minute
            if (clock.el.textContent !== next) clock.el.textContent = next;
          }
        };

        tick();
        // align to the next whole second, then tick on the beat
        setTimeout(() => {
          tick();
          setInterval(tick, 1000);
        }, 1000 - (Date.now() % 1000));
      }
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1rem;
        /* `--accent-panel`, not `--accent`: this paints the accent as a
           background with text on it, and `--accent` lifts to #5C74FF in the
           dark theme, where white on it is 3.89:1 and fails AA. The panel pair
           is held at the vivid blue in both themes for exactly this. A skip
           link is the one control a keyboard user meets first, so it is the
           last place on the site that should be hard to read. */
        background: var(--accent-panel);
        color: var(--accent-panel-ink);
        text-decoration: none;
      }

      .skip:focus {
        left: 0;
      }

      .shell {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        /* clears the fixed vertical MENU label on mobile */
        padding-left: calc(var(--page-pad) + 2.5rem);
        padding-right: var(--page-pad);
        padding-top: clamp(4.5rem, 14vh, 9rem);
        padding-bottom: clamp(2.5rem, 6vh, 4rem);
      }

      @media (min-width: 900px) {
        .shell {
          /* clears the fixed dash rail */
          padding-left: clamp(17rem, 24vw, 21rem);
          padding-right: clamp(2rem, 6vw, 5rem);
        }
      }

      .shell__main {
        flex: 1 0 auto;
        width: 100%;
        max-width: var(--page-max);
      }

      /* --- footer ---------------------------------------------------------- */

      .foot {
        width: 100%;
        max-width: var(--page-max);
        margin-top: clamp(5rem, 16vh, 10rem);
        padding-top: 1.25rem;
        border-top: 1px solid var(--hairline);
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 1.25rem 2.5rem;
      }

      .foot__links {
        display: flex;
        gap: 1.25rem;
        margin: 0;
      }

      .foot__link {
        display: inline-block;
        color: var(--muted);
        text-decoration: none;
      }

      .foot__link:hover {
        color: var(--accent);
      }

      .foot__clocks {
        display: flex;
        gap: 1.5rem;
        margin: 0;
        margin-left: auto;
      }

      .foot__clock {
        display: flex;
        gap: 0.5rem;
        align-items: baseline;
        color: var(--faint);
      }

      .foot__clock dd {
        margin: 0;
        color: var(--muted);
      }

      .foot__meta {
        color: var(--faint);
        margin: 0;
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
      }

      /* Sits at the copyright's weight, not the social links': /privacy is
         housekeeping, and it should read as housekeeping until hovered. */
      .foot__quiet {
        display: inline-block;
        color: inherit;
        text-decoration: none;
      }

      .foot__quiet:hover {
        color: var(--accent);
      }

      .foot__search {
        cursor: pointer;
      }

      .foot__search kbd {
        font: inherit;
        margin-left: 0.35rem;
        padding: 0.1rem 0.35rem;
        border: 1px solid var(--hairline);
      }

      .foot__search:hover kbd {
        border-color: currentColor;
      }

      @media (max-width: 599px) {
        .foot__clocks {
          margin-left: 0;
          flex-direction: column;
          gap: 0.35rem;
        }

        .foot__clock {
          justify-content: space-between;
          min-width: 11rem;
        }

        /* drop the copyright onto its own line instead of letting it sit
           alongside the first clock row */
        .foot__meta {
          width: 100%;
        }
      }
    </style>
  </body>
</html>
